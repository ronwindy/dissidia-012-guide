---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GatewayMapCard from '../../components/story/GatewayMapCard.astro';
import StoryNav from '../../components/story/StoryNav.astro';
import AlertCallout from '../../components/common/AlertCallout.astro';
import DataTable from '../../components/common/DataTable.astro';
import { story000Foreword, story000DeepDungeons, story000MoogleShops } from '../../data/story/story000Data';

const story000Nav = [
  { id: "foreword", label: "000 Mechanics", sublabel: "Party & Ruleset Setup" },
  { id: "chasm-rotting-land", label: "Chasm in Rotting Land", sublabel: "10-Floor Unlocking Dungeon" },
  { id: "curses-hopes-yore", label: "Curses of Hopes of Yore", sublabel: "Shantotto's 5-Floor Sanctum" },
  { id: "forsaken-lands", label: "The Forsaken Lands", sublabel: "Gaia 10-Floor Resource Gauntlet" },
  { id: "dragon-kings-gateway", label: "Dragon King's Gateway", sublabel: "Dragon Caves 10-Floor Trial" },
  { id: "edge-of-discord", label: "Edge of Discord", sublabel: "Level 130 Feral Chaos Apex" },
  { id: "moogle-shops-000", label: "Moogle Shops Catalog", sublabel: "Cornelia, Earth, Gulg, Gaia" }
];
---

<BaseLayout title="000: Confessions of the Creator Walkthrough" currentPath="story-000">
  <div style="margin-bottom: 2rem;">
    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
      <span class="badge-pill badge-chaos">Scenario 000</span>
      <span class="badge-pill badge-crystal">Post-Game Open World</span>
    </div>
    <h1 style="margin: 0;">000: CONFESSIONS OF THE CREATOR</h1>
    <p style="color: var(--text-muted); font-size: 1rem; margin-top: 0.5rem; line-height: 1.6;">
      The ultimate post-game campaign across World B. Conquer deep multi-floor super-dungeons, gather Lufenian and Genji armor components, unlock world teleporters, trade with secret regional Moogles, and overcome Level 130 Feral Chaos.
    </p>
  </div>

  <StoryNav title="Scenario 000 Navigation" items={story000Nav} />

  <!-- Foreword & Mechanics Section -->
  <section id="foreword" class="glass-card guide-section" style="margin-bottom: 2.5rem;">
    <h2 style="margin-top: 0; color: var(--accent-primary);">000 Overview & Essential Tactics</h2>
    <p style="color: var(--text-muted); line-height: 1.65; margin-bottom: 1.25rem;">
      {story000Foreword.desc}
    </p>

    <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.5rem;">
      {story000Foreword.tips.map(tip => (
        <div style="display: flex; align-items: flex-start; gap: 0.65rem; font-size: 0.92rem; color: var(--text-main); background: rgba(255,255,255,0.02); border: 1px solid var(--border-card-subtle); padding: 0.75rem 1rem; border-radius: var(--radius-sm);">
          <span style="color: var(--accent-cosmos); font-weight: bold; flex-shrink: 0;">&bull;</span>
          <span>{tip}</span>
        </div>
      ))}
    </div>

    <AlertCallout type="tip" title="50% MOOGLE SPECIAL DAY DISCOUNT">
      On your designated <strong>Special Day</strong> (configured in your game user data), all Moogle Shop KP prices across Scenario 000 are slashed by <strong>50%</strong>! Plan major equipment and Rosetta Stone purchases accordingly.
    </AlertCallout>
  </section>

  <!-- Deep End-Game Gateways -->
  <div style="margin-bottom: 3.5rem;">
    <h2 style="font-size: 1.75rem; margin-bottom: 1.5rem; color: var(--text-main);">
      Major Gateways & Multi-Floor Labyrinths
    </h2>

    <div style="display: flex; flex-direction: column; gap: 2rem;">
      {story000DeepDungeons.map(gw => (
        <GatewayMapCard
          id={gw.id}
          title={gw.title}
          chapter="Scenario 000 • World B Labyrinth"
          location={gw.location}
          kpChance={gw.kpChance}
          rules={gw.rules}
          skills={gw.skills}
          bonusLine={gw.bonusLine}
          strategy={gw.strategy}
          notes={gw.notes}
          floors={gw.floors}
        />
      ))}
    </div>
  </div>

  <!-- Moogle Shops Full Catalog -->
  <section id="moogle-shops-000" class="guide-section" style="margin-bottom: 3.5rem;">
    <h2 style="font-size: 1.75rem; margin-bottom: 0.5rem; color: var(--text-main);">
      World B Moogle Shops & Complete Stock
    </h2>
    <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1.5rem;">
      All Moogles encountered across World B offer unique equipment bases, catalysts, and rare accessories. Prices listed are standard KP costs (halved on Special Days).
    </p>

    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      {story000MoogleShops.map(shop => (
        <div class="glass-card" style="border-left: 4px solid var(--accent-cosmos);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 1px solid var(--border-card-subtle); padding-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem;">
            <div>
              <h3 style="margin: 0; font-size: 1.3rem; color: var(--text-main); font-family: var(--font-heading);">
                {shop.location}
              </h3>
              <div style="font-size: 0.8rem; color: var(--accent-cosmos); font-family: var(--font-mono);">
                Merchant: {shop.moogleName}
              </div>
            </div>
            <span class="badge-pill badge-cosmos">Moogle Shop</span>
          </div>

          <DataTable
            headers={["Item / Equipment", "Standard Cost", "Special Day (50% Off)", "Effect / Application"]}
            rows={shop.inventory.map(inv => {
              const numCost = parseInt(inv.cost.replace(/[^0-9]/g, ''), 10);
              const halfCost = isNaN(numCost) ? "—" : `${Math.floor(numCost / 2)} KP`;
              return [
                `<strong>${inv.item}</strong>`,
                `<span style="color: var(--accent-warning); font-family: var(--font-mono);">${inv.cost}</span>`,
                `<span style="color: var(--accent-success); font-family: var(--font-mono);">${halfCost}</span>`,
                inv.desc
              ];
            })}
          />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
