---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GatewayMapCard from '../../components/story/GatewayMapCard.astro';
import StoryNav from '../../components/story/StoryNav.astro';
import AlertCallout from '../../components/common/AlertCallout.astro';
import DataTable from '../../components/common/DataTable.astro';
import { 
  story000Foreword, 
  story000WalkthroughSteps, 
  story000DeepDungeons, 
  story000MoogleShops 
} from '../../data/story/story000Data';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const resolveImg = (src: string) => src.startsWith('http') ? src : `${baseUrl}${src.startsWith('/') ? src.slice(1) : src}`;

const story000Nav = [
  { id: "foreword", label: "000 Mechanics", sublabel: "Party & Ruleset Setup" },
  { id: "step-intro-cavern", label: "1. Cavern & Rotting Land", sublabel: "10-Floor Unlocking Trial" },
  { id: "step-shantotto-remake", label: "2. Shantotto's Remaster", sublabel: "5-Floor Magic Sanctum" },
  { id: "step-cornelia-plain-trek", label: "3. Castle Cornelia & Departure", sublabel: "Field Chest Visual Aid" },
  { id: "step-volcano-gulg-snows", label: "4. Gulg & Snowfields", sublabel: "Gateways & Moogle Summons" },
  { id: "step-southern-lufenia-apex", label: "5. Southern Lufenia", sublabel: "Feral Chaos Phase 1" },
  { id: "step-sandsea-melmond-trek", label: "6. Sandsea & Melmond Trek", sublabel: "World Map Visual Aid" },
  { id: "step-flying-castle-farming", label: "7. Flying Castle (Lufenian)", sublabel: "5-Floor Equipment Vault" },
  { id: "step-bahamut-isles-discord", label: "8. Bahamut & Land of Discord", sublabel: "Secret Moogle Gateways" },
  { id: "step-gabranth-and-onrac", label: "9. Gabranth Remaster & Onrac", sublabel: "5-Floor Judge Magister" },
  { id: "step-edge-of-discord-apex", label: "10. Edge of Discord", sublabel: "Level 130 Feral Chaos Apex" },
  { id: "optional-labyrinths", label: "Optional Super-Dungeons", sublabel: "Gaia & Dragon Caves" },
  { id: "moogle-shops-000", label: "Moogle Shops Catalog", sublabel: "9 Regional World B Merchants" }
];
---

<BaseLayout title="000: Confessions of the Creator Walkthrough" currentPath="story-000">
  <div style="margin-bottom: 2rem;">
    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
      <span class="badge-pill badge-chaos">Scenario 000</span>
      <span class="badge-pill badge-crystal">Post-Game Open World</span>
    </div>
    <h1 style="margin: 0;">000: CONFESSIONS OF THE CREATOR</h1>
    <p style="color: var(--text-muted); font-size: 1rem; margin-top: 0.5rem; line-height: 1.6;">
      The complete chronological post-game walkthrough across World B. Conquer deep multi-floor super-dungeons, gather Lufenian and Genji armor components, consult visual map and chest aids, unlock world teleporters, trade with secret regional Moogles, and defeat Level 130 Feral Chaos.
    </p>
  </div>

  <StoryNav title="Scenario 000 Complete Navigation" items={story000Nav} />

  <!-- Foreword & Mechanics Section -->
  <section id="foreword" class="glass-card guide-section" style="margin-bottom: 2.5rem;">
    <h2 style="margin-top: 0; color: var(--accent-primary);">000 Overview & Essential Tactics</h2>
    <p style="color: var(--text-muted); line-height: 1.65; margin-bottom: 1.25rem;">
      {story000Foreword.desc}
    </p>

    <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.5rem;">
      {story000Foreword.tips.map(tip => (
        <div style="display: flex; align-items: flex-start; gap: 0.65rem; font-size: 0.92rem; color: var(--text-main); background: rgba(255,255,255,0.02); border: 1px solid var(--border-card-subtle); padding: 0.75rem 1rem; border-radius: var(--radius-sm);">
          <span style="color: var(--accent-cosmos); font-weight: bold; flex-shrink: 0;">&bull;</span>
          <span>{tip}</span>
        </div>
      ))}
    </div>

    <AlertCallout type="tip" title="50% MOOGLE SPECIAL DAY DISCOUNT">
      On your designated <strong>Special Day</strong> (configured in your game user data), all Moogle Shop KP prices across Scenario 000 are slashed by <strong>50%</strong>! Plan major equipment and Rosetta Stone purchases accordingly.
    </AlertCallout>
  </section>

  <!-- Complete Chronological Walkthrough Campaign -->
  <div style="margin-bottom: 3.5rem;">
    <h2 style="font-size: 1.75rem; margin-bottom: 0.5rem; color: var(--text-main);">
      Complete Step-by-Step Scenario 000 Walkthrough
    </h2>
    <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 2rem;">
      Follow this comprehensive walkthrough in sequence to open all world map teleporters, discover all secret chests and visual aid routes, recruit the companion Moogle, and conquer every gateway.
    </p>

    <div style="display: flex; flex-direction: column; gap: 3rem;">
      {story000WalkthroughSteps.map((step) => (
        <section id={step.id} class="walkthrough-step-block guide-section">
          <!-- Step Header -->
          <div class="glass-card" style="border-left: 4px solid var(--accent-primary); margin-bottom: 1.25rem; padding: 1.25rem 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem;">
              <h3 style="margin: 0; font-size: 1.35rem; color: var(--text-main); font-family: var(--font-heading);">
                {step.title}
              </h3>
              {step.location && (
                <span class="badge-pill badge-crystal">
                  {step.location}
                </span>
              )}
            </div>
            <p style="margin: 0.5rem 0 0; color: var(--text-muted); font-size: 0.95rem; line-height: 1.65;">
              {step.description}
            </p>

            <!-- Optional Dialogue Quote Bubble -->
            {step.dialogue && (
              <div style="margin-top: 1rem; padding: 0.85rem 1.15rem; background: rgba(56, 189, 248, 0.06); border: 1px solid rgba(56, 189, 248, 0.2); border-radius: var(--radius-sm); font-style: italic; color: #e0f2fe; line-height: 1.6;">
                <div style="font-size: 0.75rem; font-family: var(--font-mono); color: var(--accent-primary); font-weight: bold; text-transform: uppercase; margin-bottom: 0.25rem;">
                  {step.dialogue.speaker}
                </div>
                <div style="white-space: pre-line; font-size: 0.9rem;">
                  {step.dialogue.text}
                </div>
              </div>
            )}

            <!-- Visual Aid Images inside Step Header (if any) -->
            {step.images && step.images.length > 0 && (
              <div style="margin-top: 1.25rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem;">
                {step.images.map(img => (
                  <div class="walkthrough-visual-box" style="background: rgba(11, 14, 23, 0.9); border: 1px solid rgba(56, 189, 248, 0.35); border-radius: var(--radius-sm); overflow: hidden; box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);">
                    <div style="background: #000; display: flex; align-items: center; justify-content: center; overflow: hidden; min-height: 160px;">
                      <img 
                        src={resolveImg(img.src)} 
                        alt={img.alt || img.caption} 
                        loading="lazy"
                        style="width: 100%; height: auto; display: block; object-fit: contain; max-height: 280px; transition: transform 0.3s ease;"
                        class="visual-aid-img"
                      />
                    </div>
                    <div style="padding: 0.55rem 0.85rem; background: rgba(0, 0, 0, 0.6); border-top: 1px solid rgba(255, 255, 255, 0.1); font-size: 0.85rem; font-family: var(--font-mono); color: var(--accent-crystal); text-align: center; font-weight: 600;">
                      {img.caption}
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>

          <!-- Step Gateways -->
          {step.gateways && step.gateways.length > 0 && (
            <div style="display: flex; flex-direction: column; gap: 1.5rem; padding-left: 0.5rem;">
              {step.gateways.map(gw => (
                <GatewayMapCard
                  id={gw.id}
                  title={gw.title}
                  chapter="Scenario 000 Walkthrough"
                  location={gw.location}
                  kpChance={gw.kpChance}
                  rules={gw.rules}
                  skills={gw.skills}
                  bonusLine={gw.bonusLine}
                  enemies={gw.enemies}
                  chests={gw.chests}
                  strategy={gw.strategy}
                  notes={gw.notes}
                  images={gw.images}
                  floors={gw.floors}
                />
              ))}
            </div>
          )}
        </section>
      ))}
    </div>
  </div>

  <!-- Deep End-Game Optional Labyrinths (Gaia & Dragon Caves) -->
  <section id="optional-labyrinths" class="guide-section" style="margin-bottom: 3.5rem;">
    <div style="margin-bottom: 1.5rem;">
      <h2 style="font-size: 1.75rem; margin: 0 0 0.5rem; color: var(--text-main);">
        Optional Super-Labyrinths (Gaia & Dragon Caves)
      </h2>
      <p style="color: var(--text-muted); font-size: 0.95rem;">
        These massive 10-floor endgame gauntlets provide continuous farming sources for Electrum, Scarletite, Pink Tails, Rosetta Stones, and complete Genji/Lufenian sets.
      </p>
    </div>

    <div style="display: flex; flex-direction: column; gap: 2rem;">
      {story000DeepDungeons.map(gw => (
        <GatewayMapCard
          id={gw.id}
          title={gw.title}
          chapter="Scenario 000 • Optional Trial Gauntlet"
          location={gw.location}
          kpChance={gw.kpChance}
          rules={gw.rules}
          skills={gw.skills}
          bonusLine={gw.bonusLine}
          strategy={gw.strategy}
          notes={gw.notes}
          floors={gw.floors}
        />
      ))}
    </div>
  </section>

  <!-- Moogle Shops Full Catalog -->
  <section id="moogle-shops-000" class="guide-section" style="margin-bottom: 3.5rem;">
    <h2 style="font-size: 1.75rem; margin-bottom: 0.5rem; color: var(--text-main);">
      World B Moogle Shops & Complete Stock
    </h2>
    <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1.5rem;">
      All Moogles encountered across World B offer unique equipment bases, catalysts, and rare accessories. Prices listed are standard KP costs (halved on Special Days).
    </p>

    <div style="display: flex; flex-direction: column; gap: 2rem;">
      {story000MoogleShops.map((shop, idx) => (
        <div class="glass-card" style="border-left: 4px solid var(--accent-cosmos);">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; border-bottom: 1px solid var(--border-card-subtle); padding-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
            <div>
              <h3 style="margin: 0; font-size: 1.3rem; color: var(--text-main); font-family: var(--font-heading);">
                {shop.location}
              </h3>
              {shop.moogleName && (
                <div style="font-size: 0.82rem; color: var(--accent-cosmos); font-family: var(--font-mono); margin-top: 0.25rem;">
                  Merchant: <strong>{shop.moogleName}</strong>
                </div>
              )}
              {shop.notes && (
                <div style="font-size: 0.85rem; color: var(--text-dim); margin-top: 0.35rem; line-height: 1.5;">
                  {shop.notes}
                </div>
              )}
            </div>
            <span class="badge-pill badge-cosmos">Shop #{idx + 1}</span>
          </div>

          <DataTable caption={`${shop.inventory.length} items available`}>
            <table class="data-table">
              <thead>
                <tr>
                  <th style="min-width: 200px;">Item / Equipment</th>
                  <th style="width: 140px; text-align: center;">Standard Cost</th>
                  <th style="width: 170px; text-align: center;">Special Day (50% Off)</th>
                  <th>Effect / Application / Notes</th>
                </tr>
              </thead>
              <tbody>
                {shop.inventory.map(inv => {
                  const numCost = parseInt(inv.cost.replace(/[^0-9]/g, ''), 10);
                  const halfCost = isNaN(numCost) ? "—" : `${Math.floor(numCost / 2)} KP`;
                  return (
                    <tr>
                      <td>
                        <strong style="color: var(--text-main);">{inv.item}</strong>
                      </td>
                      <td style="text-align: center;">
                        <span style="color: var(--accent-warning); font-family: var(--font-mono); font-weight: 600;">{inv.cost}</span>
                      </td>
                      <td style="text-align: center;">
                        <span style="color: var(--accent-success); font-family: var(--font-mono); font-weight: 600;">{halfCost}</span>
                      </td>
                      <td style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.5;">
                        {inv.desc || '—'}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </DataTable>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .visual-aid-img:hover,
  .walkthrough-preview-img:hover {
    transform: scale(1.03);
  }
</style>
