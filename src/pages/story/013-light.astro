---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GatewayMapCard from '../../components/story/GatewayMapCard.astro';
import StoryNav from '../../components/story/StoryNav.astro';
import AlertCallout from '../../components/common/AlertCallout.astro';
import { story013Chapters, story013Key } from '../../data/story/story013Data';
import { getDrakePieceIcon } from '../../data/story/drakeAssets';

const storyNavItems = story013Chapters.map(ch => ({
  id: ch.id,
  label: `${ch.chapterNumber}: ${ch.title}`,
  sublabel: `Hero: ${ch.character}`
}));

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const resolveImg = (src: string) => src.startsWith('http') ? src : `${baseUrl}${src.startsWith('/') ? src.slice(1) : src}`;
---

<BaseLayout title="013: Light to All Walkthrough" currentPath="story-013">
  <div style="margin-bottom: 2rem;">
    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
      <span class="badge-pill badge-crystal">Main Scenario 013</span>
      <span class="badge-pill badge-cosmos">The 13th Cycle Remaster</span>
    </div>
    <h1 style="margin: 0;">013: LIGHT TO ALL</h1>
    <p style="color: var(--text-muted); font-size: 1rem; margin-top: 0.5rem; line-height: 1.6;">
      The complete remastered 13th cycle of conflict. Features all 10 Destiny Odysseys for Cloud, Onion Knight, Terra, Cecil, Tidus, Firion, Squall, Zidane, Bartz, and Warrior of Light, alongside full ASCII grid maps, board emblems, Assist allies, and the 3-stage final confrontation with Chaos.
    </p>
  </div>

  <StoryNav title="Scenario 013 Chapters" items={storyNavItems} />

  <!-- 013 Map Key & Mechanics Box -->
  <div class="glass-card" style="margin-bottom: 2rem; border-left: 4px solid var(--accent-primary);">
    <h3 style="margin: 0 0 0.75rem; font-size: 1.15rem; color: var(--accent-primary); display: flex; align-items: center; gap: 0.5rem;">
      <img src={resolveImg('/images/story/drake/pieces/start.png')} alt="Start" style="width: 20px; height: 20px; object-fit: contain;" />
      013 Map Legend & Board Symbols
    </h3>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.6rem; font-family: var(--font-mono); font-size: 0.85rem; margin-bottom: 1rem;">
      {story013Key.map(k => {
        const icon = getDrakePieceIcon(k.key);
        return (
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            {icon ? (
              <img src={resolveImg(icon)} alt={k.key} style="width: 20px; height: 20px; object-fit: contain; flex-shrink: 0;" />
            ) : (
              <span style="font-weight: bold; color: var(--accent-primary); background: rgba(56, 189, 248, 0.1); padding: 0.1rem 0.4rem; border-radius: 3px; min-width: 28px; text-align: center;">
                {k.key}
              </span>
            )}
            <span style="color: var(--text-muted);"><strong style="color: var(--text-main);">[{k.key}]</strong> {k.desc}</span>
          </div>
        );
      })}
    </div>
    <div style="font-size: 0.88rem; color: var(--text-dim); line-height: 1.5;">
      <strong>Note:</strong> Blue gateways e.g. <span style="color: #c084fc;">(Blue)</span> are optional side dungeons that can be entered and exited freely at any time on the world map.
    </div>
  </div>

  <!-- Render all Chapters -->
  {story013Chapters.map(chapter => (
    <section id={chapter.id} class="guide-section" style="margin-bottom: 3.5rem;">
      <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; border-bottom: 2px solid rgba(255,255,255,0.08); padding-bottom: 0.65rem; margin-bottom: 1.5rem;">
        <div>
          <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
            <span class="badge-pill badge-cosmos">{chapter.chapterNumber}</span>
            <span style="font-size: 0.85rem; color: var(--accent-primary); font-family: var(--font-mono);">
              Hero: {chapter.character}
            </span>
          </div>
          <h2 style="margin: 0; font-size: 1.75rem; color: var(--text-main); border: none; padding: 0;">
            {chapter.title}
          </h2>
          {chapter.location && (
            <div style="font-size: 0.85rem; color: var(--text-dim); margin-top: 0.2rem;">
              Location: {chapter.location}
            </div>
          )}
        </div>
      </div>

      {chapter.intro && (
        <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.25rem;">
          {chapter.intro}
        </p>
      )}

      <!-- Hero Character Playstyle & Tactical Spotlight -->
      {chapter.characterGuide && (
        <div class="crystal-panel character-tactics-spotlight" style="margin-bottom: 2rem; border-left: 4px solid var(--color-lufenia);">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem;">
            <div style="display: flex; align-items: center; gap: 0.85rem;">
              {chapter.characterGuide.portrait && (
                <img 
                  src={resolveImg(chapter.characterGuide.portrait)} 
                  alt={chapter.characterGuide.name} 
                  style="width: 54px; height: 54px; object-fit: contain; background: rgba(0,0,0,0.4); border-radius: var(--radius-xs); border: 1px solid var(--border-panel-subtle); padding: 2px;" 
                />
              )}
              <div>
                <span class="badge-pill badge-crystal" style="font-size: 0.72rem;">Destiny Odyssey Hero</span>
                <h3 style="margin: 0.15rem 0 0; font-size: 1.35rem; color: var(--text-main); font-family: var(--font-heading);">
                  {chapter.characterGuide.name} <span style="font-size: 0.85rem; color: var(--color-lufenia); font-family: var(--font-subheading); font-weight: normal;">— {chapter.characterGuide.title}</span>
                </h3>
              </div>
            </div>
          </div>

          <p style="font-size: 0.92rem; color: var(--text-sub); line-height: 1.6; margin-bottom: 1.15rem;">
            {chapter.characterGuide.playstyle}
          </p>

          {chapter.characterGuide.paradigmOrMechanic && (
            <div style="background: var(--surface-panel-alt); border-radius: var(--radius-xs); border: 1px solid var(--border-panel-subtle); padding: 0.85rem 1rem; margin-bottom: 1rem;">
              <div style="font-size: 0.78rem; font-family: var(--font-mono); color: var(--color-brv); text-transform: uppercase; font-weight: bold; margin-bottom: 0.35rem;">
                Core Mechanic: {chapter.characterGuide.paradigmOrMechanic.name}
              </div>
              <p style="margin: 0; font-size: 0.88rem; color: var(--text-sub); line-height: 1.5;">
                {chapter.characterGuide.paradigmOrMechanic.description}
              </p>
            </div>
          )}

          {chapter.characterGuide.recommendedAbilities && chapter.characterGuide.recommendedAbilities.length > 0 && (
            <div style="margin-bottom: 1rem;">
              <div style="font-size: 0.78rem; font-family: var(--font-mono); color: var(--color-cosmos); text-transform: uppercase; font-weight: bold; margin-bottom: 0.5rem; letter-spacing: 0.05em;">
                Recommended Abilities & Loadout Priority
              </div>
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 0.6rem;">
                {chapter.characterGuide.recommendedAbilities.map(ab => (
                  <div style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.06); border-radius: var(--radius-xs); padding: 0.6rem 0.85rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.2rem;">
                      <strong style="color: var(--text-main); font-size: 0.88rem;">{ab.name}</strong>
                      <span class={`badge-pill ${ab.type === 'HP' ? 'badge-hp' : ab.type === 'BRV' ? 'badge-brv' : 'badge-crystal'}`} style="font-size: 0.68rem;">
                        {ab.type} • {ab.locationOrLevel}
                      </span>
                    </div>
                    <div style="font-size: 0.82rem; color: var(--text-dim); line-height: 1.4;">
                      {ab.notes}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          {chapter.characterGuide.assistEvaluation && (
            <div style="background: rgba(56, 189, 248, 0.05); border: 1px solid rgba(56, 189, 248, 0.2); border-radius: var(--radius-xs); padding: 0.85rem 1rem;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem; flex-wrap: wrap; gap: 0.5rem;">
                <span style="font-size: 0.78rem; font-family: var(--font-mono); color: var(--color-cosmos); text-transform: uppercase; font-weight: bold;">
                  Assist Synergy: {chapter.characterGuide.assistEvaluation.partner}
                </span>
                <span style="font-size: 0.75rem; font-family: var(--font-mono); color: var(--text-dim);">
                  Ground: <code style="color: #38bdf8;">{chapter.characterGuide.assistEvaluation.groundAssist}</code> | Air: <code style="color: #38bdf8;">{chapter.characterGuide.assistEvaluation.airAssist}</code>
                </span>
              </div>
              <p style="margin: 0; font-size: 0.86rem; color: var(--text-sub); line-height: 1.5;">
                {chapter.characterGuide.assistEvaluation.tactics}
              </p>
            </div>
          )}
        </div>
      )}

      <!-- Overworld Step-by-Step Exploration Guide -->
      {chapter.overworldSteps && chapter.overworldSteps.length > 0 && (
        <div class="glass-card" style="margin-bottom: 2rem; border-left: 4px solid var(--color-cosmos);">
          <div style="font-size: 0.8rem; font-family: var(--font-mono); color: var(--color-cosmos); text-transform: uppercase; font-weight: bold; margin-bottom: 0.75rem; letter-spacing: 0.05em; display: flex; align-items: center; gap: 0.5rem;">
            <span>🗺️</span> Odyssey Route & Collectibles
          </div>
          <div style="display: flex; flex-direction: column; gap: 1rem;">
            {chapter.overworldSteps.map((step, idx) => (
              <div style="background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.05); border-radius: var(--radius-xs); padding: 0.85rem 1.15rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem; flex-wrap: wrap; gap: 0.5rem;">
                  <strong style="color: var(--text-main); font-size: 0.95rem; font-family: var(--font-heading);">
                    Step {idx + 1}: {step.title}
                  </strong>
                  {step.orbs && (
                    <span style="font-size: 0.75rem; font-family: var(--font-mono); color: var(--color-brv);">
                      ✨ {step.orbs}
                    </span>
                  )}
                </div>
                <p style="font-size: 0.88rem; color: var(--text-sub); line-height: 1.55; margin: 0 0 0.65rem;">
                  {step.description}
                </p>

                {step.chests && step.chests.length > 0 && (
                  <div style="background: rgba(251, 191, 36, 0.06); border: 1px solid rgba(251, 191, 36, 0.2); border-radius: var(--radius-xs); padding: 0.5rem 0.75rem; margin-bottom: 0.5rem; font-size: 0.82rem; font-family: var(--font-mono);">
                    <span style="color: #fbbf24; font-weight: bold; text-transform: uppercase; font-size: 0.72rem; display: block; margin-bottom: 0.25rem;">
                      Odyssey Chest Rewards
                    </span>
                    <ul style="margin: 0; padding-left: 1.2rem; color: var(--text-main);">
                      {step.chests.map(c => (
                        <li><strong>{c.location}:</strong> <span style="color: #fde68a;">{c.reward}</span></li>
                      ))}
                    </ul>
                  </div>
                )}

                {step.moogleShop && (
                  <div style="background: rgba(168, 85, 247, 0.06); border: 1px solid rgba(168, 85, 247, 0.2); border-radius: var(--radius-xs); padding: 0.6rem 0.85rem; font-size: 0.82rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
                      <span style="color: #c084fc; font-family: var(--font-mono); font-weight: bold; text-transform: uppercase; font-size: 0.72rem;">
                        Moogle Merchant {step.moogleShop.location ? `• ${step.moogleShop.location}` : ''}
                      </span>
                      {step.moogleShop.notes && <span style="color: var(--text-dim); font-size: 0.75rem;">{step.moogleShop.notes}</span>}
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.4rem; font-family: var(--font-mono);">
                      {step.moogleShop.inventory.map(item => (
                        <div style="display: flex; justify-content: space-between; background: rgba(0,0,0,0.3); padding: 0.25rem 0.5rem; border-radius: 3px;">
                          <span style="color: var(--text-main);">{item.item}</span>
                          <strong style="color: #fbbf24;">{item.cost}</strong>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      )}

      {chapter.fieldEncounters && chapter.fieldEncounters.length > 0 && (
        <div style="background: rgba(239, 68, 68, 0.06); border: 1px solid rgba(239, 68, 68, 0.2); border-radius: var(--radius-sm); padding: 0.75rem 1rem; margin-bottom: 1.5rem; font-size: 0.88rem; font-family: var(--font-mono);">
          <div style="color: var(--accent-chaos); font-weight: bold; margin-bottom: 0.35rem; text-transform: uppercase; font-size: 0.75rem;">
            Overworld Field Encounters
          </div>
          <ul style="margin: 0; padding-left: 1.2rem; color: var(--text-muted);">
            {chapter.fieldEncounters.map(encounter => (
              <li>{encounter}</li>
            ))}
          </ul>
        </div>
      )}

      <!-- Gateways in this chapter -->
      <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        {chapter.gateways.map(gw => (
          <GatewayMapCard
            id={gw.id}
            title={gw.title}
            chapter={`${chapter.chapterNumber} • ${chapter.title}`}
            character={chapter.character}
            isOptional={gw.isOptional}
            kpChance={gw.kpChance}
            rules={gw.rules}
            skills={gw.skills}
            bonusLine={gw.bonusLine}
            asciiMap={gw.asciiMap}
            legend={gw.legend}
            enemyTactics={gw.enemyTactics}
            bossTactic={gw.bossTactic}
            notes={gw.notes}
            strategy={gw.strategy}
            floors={gw.floors}
          />
        ))}
      </div>
    </section>
  ))}
</BaseLayout>
