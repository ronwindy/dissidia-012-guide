---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GatewayMapCard from '../../components/story/GatewayMapCard.astro';
import StoryNav from '../../components/story/StoryNav.astro';
import AlertCallout from '../../components/common/AlertCallout.astro';
import { story013Chapters, story013Key } from '../../data/story/story013Data';

const storyNavItems = story013Chapters.map(ch => ({
  id: ch.id,
  label: `${ch.chapterNumber}: ${ch.title}`,
  sublabel: `Hero: ${ch.character}`
}));
---

<BaseLayout title="013: Light to All Walkthrough" currentPath="story-013">
  <div style="margin-bottom: 2rem;">
    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
      <span class="badge-pill badge-crystal">Main Scenario 013</span>
      <span class="badge-pill badge-cosmos">The 13th Cycle Remaster</span>
    </div>
    <h1 style="margin: 0;">013: LIGHT TO ALL</h1>
    <p style="color: var(--text-muted); font-size: 1rem; margin-top: 0.5rem; line-height: 1.6;">
      The complete remastered 13th cycle of conflict. Features all 10 Destiny Odysseys for Cloud, Onion Knight, Terra, Cecil, Tidus, Firion, Squall, Zidane, Bartz, and Warrior of Light, alongside full ASCII grid maps, board emblems, Assist allies, and the 3-stage final confrontation with Chaos.
    </p>
  </div>

  <StoryNav title="Scenario 013 Chapters" items={storyNavItems} />

  <!-- 013 Map Key & Mechanics Box -->
  <div class="glass-card" style="margin-bottom: 2rem; border-left: 4px solid var(--accent-primary);">
    <h3 style="margin: 0 0 0.5rem; font-size: 1.15rem; color: var(--accent-primary);">
      013 Map Legend & Board Symbols
    </h3>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.5rem; font-family: var(--font-mono); font-size: 0.85rem; margin-bottom: 1rem;">
      {story013Key.map(k => (
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <span style="font-weight: bold; color: var(--accent-primary); background: rgba(56, 189, 248, 0.1); padding: 0.1rem 0.4rem; border-radius: 3px; min-width: 28px; text-align: center;">
            {k.key}
          </span>
          <span style="color: var(--text-muted);">{k.desc}</span>
        </div>
      ))}
    </div>
    <div style="font-size: 0.88rem; color: var(--text-dim); line-height: 1.5;">
      <strong>Note:</strong> Blue gateways e.g. <span style="color: #c084fc;">(Blue)</span> are optional side dungeons that can be entered and exited freely at any time on the world map.
    </div>
  </div>

  <!-- Render all Chapters -->
  {story013Chapters.map(chapter => (
    <section id={chapter.id} class="guide-section" style="margin-bottom: 3.5rem;">
      <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; border-bottom: 2px solid rgba(255,255,255,0.08); padding-bottom: 0.65rem; margin-bottom: 1.5rem;">
        <div>
          <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
            <span class="badge-pill badge-cosmos">{chapter.chapterNumber}</span>
            <span style="font-size: 0.85rem; color: var(--accent-primary); font-family: var(--font-mono);">
              Hero: {chapter.character}
            </span>
          </div>
          <h2 style="margin: 0; font-size: 1.75rem; color: var(--text-main); border: none; padding: 0;">
            {chapter.title}
          </h2>
          {chapter.location && (
            <div style="font-size: 0.85rem; color: var(--text-dim); margin-top: 0.2rem;">
              Location: {chapter.location}
            </div>
          )}
        </div>
      </div>

      {chapter.intro && (
        <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.25rem;">
          {chapter.intro}
        </p>
      )}

      {chapter.fieldEncounters && chapter.fieldEncounters.length > 0 && (
        <div style="background: rgba(239, 68, 68, 0.06); border: 1px solid rgba(239, 68, 68, 0.2); border-radius: var(--radius-sm); padding: 0.75rem 1rem; margin-bottom: 1.5rem; font-size: 0.88rem; font-family: var(--font-mono);">
          <div style="color: var(--accent-chaos); font-weight: bold; margin-bottom: 0.35rem; text-transform: uppercase; font-size: 0.75rem;">
            Overworld Field Encounters
          </div>
          <ul style="margin: 0; padding-left: 1.2rem; color: var(--text-muted);">
            {chapter.fieldEncounters.map(encounter => (
              <li>{encounter}</li>
            ))}
          </ul>
        </div>
      )}

      <!-- Gateways in this chapter -->
      <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        {chapter.gateways.map(gw => (
          <GatewayMapCard
            id={gw.id}
            title={gw.title}
            chapter={`${chapter.chapterNumber} • ${chapter.title}`}
            character={chapter.character}
            isOptional={gw.isOptional}
            kpChance={gw.kpChance}
            rules={gw.rules}
            skills={gw.skills}
            bonusLine={gw.bonusLine}
            asciiMap={gw.asciiMap}
            legend={gw.legend}
            notes={gw.notes}
            strategy={gw.strategy}
          />
        ))}
      </div>
    </section>
  ))}
</BaseLayout>
