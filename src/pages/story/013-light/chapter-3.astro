e/DFF_Strange_Battle_Piece.png/revision/latest/scale-to-width-down/17?cb=20110204000919\" /></a></span>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">4\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/1/1e/DFF_Expert_Battle_Piece.png/revision/latest?cb=20110204003912\" class=\"mw-file-description image\" title=\"Counterfeit Wraith\"><img alt=\"Counterfeit Wraith\"  decoding=\"async\" loading=\"lazy\" width=\"25\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Expert Battle Piece.png\" data-image-key=\"DFF_Expert_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/1/1e/DFF_Expert_Battle_Piece.png/revision/latest/scale-to-width-down/25?cb=20110204003912\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/1/13/D012_Emblem_Purple.png/revision/latest?cb=20201209050509\" class=\"mw-file-description image\" title=\"Initial BRV Boost\"><img alt=\"Initial BRV Boost\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"D012 Emblem Purple.png\" data-image-key=\"D012_Emblem_Purple.png\" data-relevant=\"0\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/1/13/D012_Emblem_Purple.png/revision/latest?cb=20201209050509\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/a/ae/DFF_Strange_Battle_Piece.png/revision/latest?cb=20110204000919\" class=\"mw-file-description image\" title=\"Idle Sky Pirate\"><img alt=\"Idle Sky Pirate\"  decoding=\"async\" loading=\"lazy\" width=\"17\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Strange Battle Piece.png\" data-image-key=\"DFF_Strange_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/a/ae/DFF_Strange_Battle_Piece.png/revision/latest/scale-to-width-down/17?cb=20110204000919\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/d/d3/Dissicon_ff7_Clo1.png/revision/latest?cb=20110126030954\" class=\"mw-file-description image\" title=\"Assist Character\"><img alt=\"Assist Character\"  decoding=\"async\" loading=\"lazy\" width=\"33\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"Dissicon ff7 Clo1.png\" data-image-key=\"Dissicon_ff7_Clo1.png\" data-relevant=\"0\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/d/d3/Dissicon_ff7_Clo1.png/revision/latest/scale-to-width-down/33?cb=20110126030954\" /></a></span>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">5\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest?cb=20110203234631\" class=\"mw-file-description image\" title=\"3000 gil\"><img alt=\"3000 gil\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"30\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Chest.png\" data-image-key=\"DFF_Chest.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest/scale-to-width-down/40?cb=20110203234631\" /></a></span>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/7/7a/DFF_Start.png/revision/latest?cb=20201209045748\" class=\"mw-file-description image\"><img alt=\"DFF Start\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Start.png\" data-image-key=\"DFF_Start.png\" data-relevant=\"0\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/7/7a/DFF_Start.png/revision/latest?cb=20201209045748\" /></a></span>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">6\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">7\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr></tbody></table>\n<p>Multichain on C4, use the KP Gambler. The KP Chance is a 90 second win, piece of cake with four of the enemies being Strange and thus dying in one hit. Though you already spotted that little surprise waiting on A3, didn't you? Dun dun DUN! All four Strange enemies have the same set-up for accessories - a Hyper Ring, a Musclet Belt, five Near Opponent boosters, and an Arcane Resin, so as you should know by now, let them enter EX Mode before striking.\n</p><p>First, a Transient Gunner, it spams Ragnarok Blade. Piece of cake. Next an Idle Sky Pirate that uses Torrent. Third, Imaginary Brawler with Meteor Strike, a chargeable attack that charges her along the ground. Fourth is a Phantasmal Girl, she also uses a Muscle Belt and Near Opponent despite the fact that duh, it's Terra! HP attack is Meltdown, which she charges up three levels. Little charge time fires a fireball straight forward that explodes are mid-range, medium charge fires a large fireball that tracks you and explodes on contact with walls, highest charge, when she calls out a second attack call, fires a very large fireball that tracks you and bounces off walls and obstacles. Use Thundara to stop the attack. And now for the last enemy.\n</p><p>Level 22 Phantasmal Wraith. She's got all her tentacle attacks and the same moveset all higher-level Cloud of Darknesses have, Wide-Angle, Anti-Air, Long-Range, Aura Ball, 0-Form, Fusillade. And naturally she has a full set of equipment, Shiva as a summon, a Hyper Ring with 7 Near Loss boosters, and due to the purple emblem powering up both of you she'll have around 3000 Bravery, likely enough to kill you in one shot immediately. Get a Chase and wall rush her to fully capitalize on your own initial boost, then keep your distance and rely on Thundara to avoid getting too close and whacked with an energy blast, then Flood when she holds still, the open arena makes Tornado and Blizzara unreliable in my opinion.\n</p><p>Your reward for all this is a smooth 75 KP, and of course that chest, with 3000 gil. Terra picked up Holy at Level 11 here, it shoots five fast-moving balls of light that begin a Chase. Pretty good, but easily reflectable, Thundara is preferable to me on that alone. Nothing to do now but head to the next gateway.\n</p>\n<table class=\"D012 board\" style=\"float:right\">\n\n<tbody><tr bgcolor=\"068FB0\">\n<td width=\"19px;background:white\">&#160;\n</td>\n<th style=\"width:40px\">A\n</th>\n<th style=\"width:40px\">B\n</th>\n<th style=\"width:40px\">C\n</th>\n<th style=\"width:40px\">D\n</th>\n<th style=\"width:40px\">E\n</th>\n<th style=\"width:40px\">F\n</th>\n<th style=\"width:40px\">G\n</th>\n<th style=\"width:40px\">H\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgc