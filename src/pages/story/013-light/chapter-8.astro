=20201209050655\" /></a></span>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">3\n</th>\n<th>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/8/86/DFF_Chaos_Piece.png/revision/latest?cb=20110203235702\" class=\"mw-file-description image\" title=\"Kefka Palazzo\"><img alt=\"Kefka Palazzo\"  decoding=\"async\" loading=\"lazy\" width=\"36\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Chaos Piece.png\" data-image-key=\"DFF_Chaos_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/8/86/DFF_Chaos_Piece.png/revision/latest/scale-to-width-down/36?cb=20110203235702\" /></a></span>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/3/3c/Dissicon_ff5_Bar1.png/revision/latest?cb=20101120015034\" class=\"mw-file-description image\" title=\"Assist Character\"><img alt=\"Assist Character\"  decoding=\"async\" loading=\"lazy\" width=\"36\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"Dissicon ff5 Bar1.png\" data-image-key=\"Dissicon_ff5_Bar1.png\" data-relevant=\"0\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/3/3c/Dissicon_ff5_Bar1.png/revision/latest/scale-to-width-down/36?cb=20101120015034\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/b/b5/DFF_Battle_Piece.png/revision/latest?cb=20110203234241\" class=\"mw-file-description image\" title=\"Fallacious Wanderer\"><img alt=\"Fallacious Wanderer\"  decoding=\"async\" loading=\"lazy\" width=\"16\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Battle Piece.png\" data-image-key=\"DFF_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/b/b5/DFF_Battle_Piece.png/revision/latest/scale-to-width-down/16?cb=20110203234241\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/1/13/D012_Emblem_Purple.png/revision/latest?cb=20201209050509\" class=\"mw-file-description image\" title=\"Initial BRV boost for both\"><img alt=\"Initial BRV boost for both\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"D012 Emblem Purple.png\" data-image-key=\"D012_Emblem_Purple.png\" data-relevant=\"0\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/1/13/D012_Emblem_Purple.png/revision/latest?cb=20201209050509\" /></a></span>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">4\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/7/7a/DFF_Start.png/revision/latest?cb=20201209045748\" class=\"mw-file-description image\"><img alt=\"DFF Start\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Start.png\" data-image-key=\"DFF_Start.png\" data-relevant=\"0\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/7/7a/DFF_Start.png/revision/latest?cb=20201209045748\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">5\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">6\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">7\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr></tbody></table>\n<p>As we enter, Kuja is informed of his fake memories by Ultimecia, but he declares he won't be swayed and will prove himself in spite of her words.\n</p><p>Multichain at H2 to get four enemies, you'll have to deal with the red emblem, Initial BRV 0, but that's a minor set-back that a good attack combo can fix easily. If you want help equip the Carbuncle auto-summon, it calls when you have 0 Bravery so it'll trigger right at the start of the fight and sap the opponent to 0 too. You can also use Pupu or Bahamut if you have them. The bonus line is 3 and the KP Chance is a 90 second win. As always, charge that EX Gauge for the boss, unless you don't mind just using EX Charge to do it.\n</p><p>First up, a Delusory Knight with Shadow Lance and Nightfall. Then comes a Capricious Thief with Rumble Rush and Storm Impulse. Then we've got a Fallacious Wanderer with Reel Impulse, Holy, and Dark Flame. The two hard enemies are a Fallacious Wanderer with Holy and Dark Flame, the Hyper Ring accessories, and an unknown summon. The last one guarding the chest is a Capricious Reaper with Burst Energy, Ring Holy, Flare Star, the Ramuh summon, but no Hyper Ring gear. You can use the physical critical rate up emblem to deal with him easily.\n</p><p>At Level 4 Zidane learns Tempest, an attack where he throws his daggers down then dives after them, and if it connects he combos the opponent like the second part of Rumble Rush and Swift Attack, beginning a chase. It's a great move and is the third attack of Zidane's that gives him an HP link.\n</p><p>The chest has 2000 gil for us. \n</p>\n<table style=\"width: 275px; D012 article-table; text-align: center; color:black; float:right\">\n<tbody><tr>\n<td style=\"font-size: larger; background:#1E90FF\" colspan=\"6\"><font color=\"white\"><b>Boss</b></font>\n</td></tr>\n<tr bgcolor=\"#1E90FF\">\n<td style=\"text-align: center;\" colspan=\"6\"><b><a href=\"https://finalfantasy.fandom.com/wiki/Kefka_Palazzo_(Dissidia_PSP)\" target=\"_blank\" rel=\"noopener noreferrer\" title=\"Kefka Palazzo (Dissidia PSP)\">Kefka</a></b>\n</td></tr>\n<tr bgcolor=\"#dddddd\">\n<td style=\"text-align: center;\" colspan=\"6\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/e/e0/DissidiaKefkaRender.png/revision/latest?cb=20110216225812\" class=\"mw-file-description image\"><img alt=\"DissidiaKefkaRender\"  decoding=\"async\" loading=\"lazy\" width=\"100\" height=\"137\" class=\"mw-file-element lazyload\" data-image-name=\"DissidiaKefkaRender.png\" data-image-key=\"DissidiaKefkaRender.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/e/e0/DissidiaKefkaRender.png/revision/latest/scale-to-width-down/100?cb=20110216225812\" /></a></span>\n</td></tr>\n<tr bgcolor=\"#1E90FF\">\n<td width=\"33%\" colspan=\"2\"><b>HP</b>\n</td>\n<td width=\"33%\" colspan=\"2\"><b>Level</b>\n</td>\n<td width=\"33%\" colspan=\"2\"><b>Bravery</b>\n</td></tr>\n<tr bgcolor=\"#dddddd\">\n<td colspan=\"2\">2,277\n</td>\n<td colspan=\"2\">12\n</td>\n<td colspan=\"2\">198\n</td></tr>\n<tr bgcolor=\"#1E90FF\">\n<td colspan=\"6\"><b>Brave Attacks</b>\n</td></tr>\n<tr bgcolor=\"#dddddd\">\n<td colspan=\"6\">Ultima, Scatter Spray Blizzaga, Extra-Crispy Firaga, Lickity-Split Thundaga\n</td></tr>\n<tr bgcolor=\"#1E90FF\">\n<td colspan=\"6\"><b>HP Attacks</b>\n</td></tr>\n<tr bgcolor=\"#dddddd\">\n<td colspan=\"6\">Hyperdrive, Havoc Wing, Trine\n</td></tr>\n<tr bgcolor=\"#1E90FF\">\n<td colspan=\"3\"><b>Summon</b>\n</td>\n<td colspan=\"3\"><b>Difficulty</b>\n</td></tr>\n<tr bgcolor=\"#dddddd\">\n<td colspan=\"3\">Lich\n</td>\n<td colspan=\"3\">1/5\n</td></tr></tbody></table>\n<p>Before approaching the end piece, suit up with the Empty Assist Gauge booster. As the introductory screen and the end of Squall's story spoiled for us, someone is about to get captured. Bartz and Zidane find what appears to be a Crystal. But when he runs off to grab it, there's a flash of light and he vanishes. Kefka pops out, musing how that wasn't the plan, but he can still have fun with Zidane. Zidane just wants to know what he's done, and he's prepared to beat the answers out of him.\n</p><p>This is a pitifully easy battle, Kefka's got a Cursed Ring that really cripples him. He's got the typical attacks and the Lich summon to begin a 15 second countdown to sapping your Bravery. The catch is that the AI only summons Lich once you Break them, and you can easily land the HP strike to avoid losing your boost. Time it so you land the HP hit with 4 or 3 seconds on the countdown, then when it goes off and drains you, you're already in the process of regenerating your Bravery and Lich will effectively do nothing.\n</p><p>Because the fight always begins in the same location, here's a step-by-step process to how to fight. As the battle starts, Kefka will usually, but not always, hop onto the railing on your right and grind past you. Move right and block him to stagger him, then enter EX Mode and hit him with Tempest. This will Break Kefka and put you close enough to a wall that the Chase HP attack will Wall Rush him, putting him at less than 1000 HP. Now just land another Bravery combo on him or let Zidane's Bravery regenerate, then him him against and EX Burst. My Level 5 Zidane (that first HP strike put him up another level) did over 800 damage with his Burst, so once you recover his base Bravery or use another combo as I said, Kefka shouldn't have enough HP to survive.\n</p><p>So let's cover Zidane's EX Burst. As awesome heroes are want to do (see also: Terra), Zidane enters Trance to transform into a pink and purple superpowered being. He gains the ability to jump an additional 10 times, on top of his normal jumps and any boosts to how many jumps he can do based on his abilities. He also becomes invincible while jumping, and after dodging his jumps \"recharge\", since Dissidia vets probably know or have realized that once a character dodges in D012, they can't jump anymore until they land or use a Quickmove indicator. Admittedly Zidane's is one of the lamest EX Modes, his ability isn't useless, but it isn't really a stand-out help, the large open arenas where it should be awesome like Planet's Core, The Rift, etc have Quickmove options for quickly moving around the stage faster than jumping, and in other stages it isn't much needed. Zidane's EX Burst is pretty easy, just tap Circle over and over as he bombards the opponent with attacks, the power bar is segmented but I'm not sure why, it stops for a moment at each increment but you have to keep tapping Circle so ignore this. Zidane has one of the weakest EX Bursts, Squall is the worst but above him it's the Onion Knight, then Kuja, and then Zidane.\n</p><p>Zidane against demands answers, and Kefka informs him that Bartz is SMACK...dabinthemiddle of the enemy territory. He vanishes, leaving Zidane to try and find him.\n</p>\n<h2><span class=\"mw-headline\" id=\"Reunion\">Reunion</span><a title=\"Edit section&#39;s source code: Reunion\" data-tracking-label=\"edit-section-anon\" data-action=\"edit-section\" href=\"https://finalfantasy.fandom.com/wiki/Walkthrough:Dissidia_012_Final_Fantasy/Drake/Part_17?action=edit&amp;section=3\" aria-label=\"Edit section&#39;s source code: Reunion\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p>Oh, wait, scratch that, rather than continue on the way to the Land of Discord he was already on, Zidane has turned around and is heading far to the south to find the Teleport Stone there. That's like running down from the fourth floor to catch an elevator the fifth but alright. The path back is sealed so head forward. Near the ruins up ahead is our friend RoboMog from last time, still nothing worth buying, but you should get a Multichain, I was lucky and got one from the orbs of the dead here myself. The rock leads to an island with 1000 gil, and now there's the gateway to explore, of course.\n</p>\n<table class=\"D012 board\" style=\"float:right\">\n\n<tbody><tr bgcolor=\"068FB0\">\n<td width=\"19px;background:white\">&#160;\n</td>\n<th style=\"width:40px\">A\n</th>\n<th style=\"width:40px\">B\n</th>\n<th style=\"width:40px\">C\n</th>\n<th style=\"width:40px\">D\n</th>\n<th style=\"width:40px\">E\n</th>\n<th style=\"width:40px\">F\n</th>\n<th style=\"width:40px\">G\n</th>\n<th style=\"width:40px\">H\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">1\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/5/58/DFF_Hard_Battle_Piece.png/revision/latest?cb=20110203235357\" class=\"mw-file-description image\" title=\"Fallacious Wanderer\"><img alt=\"Fallacious Wanderer\"  decoding=\"async\" loading=\"lazy\" width=\"33\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Hard Battle Piece.png\" data-image-key=\"DFF_Hard_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/5/58/DFF_Hard_Battle_Piece.png/revision/latest/scale-to-width-down/33?cb=20110203235357\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\">&#1