alfantasy/images/1/13/D012_Emblem_Purple.png/revision/latest?cb=20201209050509\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/b/b5/DFF_Battle_Piece.png/revision/latest?cb=20110203234241\" class=\"mw-file-description image\" title=\"Capricious Reaper\"><img alt=\"Capricious Reaper\"  decoding=\"async\" loading=\"lazy\" width=\"16\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Battle Piece.png\" data-image-key=\"DFF_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/b/b5/DFF_Battle_Piece.png/revision/latest/scale-to-width-down/16?cb=20110203234241\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/b/b5/DFF_Battle_Piece.png/revision/latest?cb=20110203234241\" class=\"mw-file-description image\" title=\"False Stalwart\"><img alt=\"False Stalwart\"  decoding=\"async\" loading=\"lazy\" width=\"16\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Battle Piece.png\" data-image-key=\"DFF_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/b/b5/DFF_Battle_Piece.png/revision/latest/scale-to-width-down/16?cb=20110203234241\" /></a></span>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">3\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/8/8f/D012_Emblem_Blue.png/revision/latest?cb=20201209004544\" class=\"mw-file-description image\" title=\"Recover HP before battle\"><img alt=\"Recover HP before battle\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"D012 Emblem Blue.png\" data-image-key=\"D012_Emblem_Blue.png\" data-relevant=\"0\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/8/8f/D012_Emblem_Blue.png/revision/latest?cb=20201209004544\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">4\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/f/fc/DFF_Potion.png/revision/latest?cb=20110203235732\" class=\"mw-file-description image\" title=\"Potion\"><img alt=\"Potion\"  decoding=\"async\" loading=\"lazy\" width=\"21\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Potion.png\" data-image-key=\"DFF_Potion.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/f/fc/DFF_Potion.png/revision/latest/scale-to-width-down/21?cb=20110203235732\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/5/58/DFF_Hard_Battle_Piece.png/revision/latest?cb=20110203235357\" class=\"mw-file-description image\" title=\"Phantasmal Girl\"><img alt=\"Phantasmal Girl\"  decoding=\"async\" loading=\"lazy\" width=\"33\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Hard Battle Piece.png\" data-image-key=\"DFF_Hard_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/5/58/DFF_Hard_Battle_Piece.png/revision/latest/scale-to-width-down/33?cb=20110203235357\" /></a></span>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">5\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/b/b5/DFF_Battle_Piece.png/revision/latest?cb=20110203234241\" class=\"mw-file-description image\" title=\"Imitation Despot\"><img alt=\"Imitation Despot\"  decoding=\"async\" loading=\"lazy\" width=\"16\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Battle Piece.png\" data-image-key=\"DFF_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/b/b5/DFF_Battle_Piece.png/revision/latest/scale-to-width-down/16?cb=20110203234241\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest?cb=20110203234631\" class=\"mw-file-description image\" title=\"KP Bonus\"><img alt=\"KP Bonus\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"30\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Chest.png\" data-image-key=\"DFF_Chest.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest/scale-to-width-down/40?cb=20110203234631\" /></a></span>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">6\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">7\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr></tbody></table>\n<p>This is the time for that KP Gambler because that chest has something awesome for us. Straight Chain at B2 to get them all, activating an Initial Stage BRV Boost emblem to help ease things on us. Yet another boss, but don't worry kiddies, there's a helpful Potion to fill the EX Gauge for us this time. The bonus line is 15 and the KP Chance is a 90 second win, easy with the emblem boost.\n</p><p>First stop on the itinerary, the Capricious Reaper at D2 with Snatch Shot and Flare Star. Next is the Imitation Despot at B5 with Light Crest and Flare. Third on the list of Normal enemies, a False Stalwart with Round Edge, Twin Swords and Earthquake. Now comes the Hard ones. There's an Imaginary Champion to deal with, he's got Godspeed, Black Materia, the timed Hyper Ring, and Lich. Last is a Phantasmal Girl with Blizzara, Tornado, the same accessories, and an unknown summon.\n</p><p>The Warrior got to Level 16 and learned Rising Buckler during this round. It's exactly a reversed Shield Strike, throwing the shield up then knocking the opponent down and away.\n</p><p>The chest when we're done has the super-awesome KP Bonus, which instantly doubles our won KP. Use it to turn 75 into 150. WOOT! And that's why we save our Gamblers, kiddies. Grab that Potion to heal up and head for the exit.\n</p><p>The Warrior runs into the Emperor now, who informs him that his trespassing has caused them to lose track of Bartz - remember the mysterious earthquake after the Golbez fight? The Emperor taunts the Warrior but recognizes power when he sees it, so he offers the Warrior the chance to serve him and manifests a Crystal for him if he accepts. The Warrior, far more intelligent than Bartz, recognizes it as a fake and shatters it. Well I'm sure you know what comes next.\n</p>\n<table style=\"width: 275px; D012 article-table; text-align: center; color:black; float:right\">\n<tbody><tr>\n<td style=\"font-size: larger; background:#1E90FF\" colspan=\"6\"><font color=\"white\"><b>Boss</b></font>\n</td></tr>\n<tr bgcolor=\"#1E90FF\">\n<td style=\"text-align: center;\" colspan=\"6\"><b><a href=\"https://finalfantasy.fandom.com/wiki/Emperor_Mateus_(Dissidia_PSP)\" target=\"_blank\" rel=\"noopener noreferrer\" title=\"Emperor Mateus (Dissidia PSP)\">The Emperor</a></b>\n</td></tr>\n<tr bgcolor=\"#dddddd\">\n<td style=\"text-align: center;\" colspan=\"6\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/8/88/EmperorDissidiaRender.PNG/revision/latest?cb=20110216231129\" class=\"mw-file-description image\"><img alt=\"EmperorDissidiaRender\"  decoding=\"async\" loading=\"lazy\" width=\"91\" height=\"150\" class=\"mw-file-element lazyload\" data-image-name=\"EmperorDissidiaRender.PNG\" data-image-key=\"EmperorDissidiaRender.PNG\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/8/88/EmperorDissidiaRender.PNG/revision/latest/scale-to-width-down/91?cb=20110216231129\" /></a></span>\n</td></tr>\n<tr bgcolor=\"#1E90FF\">\n<td width=\"33%\" colspan=\"2\"><b>HP</b>\n</td>\n<td width=\"33%\" colspan=\"2\"><b>Level</b>\n</td>\n<td width=\"33%\" colspan=\"2\"><b>Bravery</b>\n</td></tr>\n<tr bgcolor=\"#dddddd\">\n<td colspan=\"2\">3,330\n</td>\n<td colspan=\"2\">24\n</td>\n<td colspan=\"2\">370\n</td></tr>\n<tr bgcolor=\"#1E90FF\">\n<td colspan=\"6\"><b>Brave Attacks</b>\n</td></tr>\n<tr bgcolor=\"#dddddd\">\n<td colspan=\"6\">Bombard, Thunder Crest, Landmine, Light Crest, Mine, Dynamite\n</td></tr>\n<tr bgcolor=\"#1E90FF\">\n<td colspan=\"6\"><b>HP Attacks</b>\n</td></tr>\n<tr bgcolor=\"#dddddd\">\n<td colspan=\"6\">Flare, Starfall, Dreary Cell\n</td></tr>\n<tr bgcolor=\"#1E90FF\">\n<td colspan=\"3\"><b>Summon</b>\n</td>\n<td colspan=\"3\"><b>Difficulty</b>\n</td></tr>\n<tr bgcolor=\"#dddddd\">\n<td colspan=\"3\">Malboro\n</td>\n<td colspan=\"3\">1.5/5\n</td></tr></tbody></table>\n<p>His highness doesn't have much higher attack power than Ultimecia, but has a higher level and much higher defense. He's got an Imitation Liegeman Assist, potentially tossing out three Fires you need to worry about in addition to the usual traps. He's also got the Malboro summon to sap your Bravery, it gets stronger the closer you are, not something a melee fighter likes. For accessories he's got a good line-up, an Earring, Attractorb and Pearl Necklace connected to an Aerial, two HP = 1, Near Death and a Near Loss, giving him a pretty hefty boost at 1 HP. And he will get it because he also has an Iifa Leaf. His moveset is the usual tricks he always has.\n</p><p>The Emperor is pretty tricky as always, he has a good accessory build and gets very tough when weak. That EX Gauge of his will fill pretty quickly when he's got a 5x booster powering up the Attractorb and Pearl Necklace, and once in EX Mode sure he'll probably lose those boosters, but it's because he'll be recovering HP, and if he hits you with an EX Burst, he's liable to Break you and get a lot of health back. And as with Ultimecia's Castle, Pandaemonium isn't exactly the best arena to make proper use of Rune Saber. You can still use it, the Emperor just may recover and dodge away before it hits. All in all, he isn't too tough, the AI is stupid as always and while his near-death power boost is nice, he's still near death.\n</p><p>As the Emperor kneels and fades away, Garland walks in, laughing that he cannot be defeated permanently. He vanishes, calling the Warrior to follow him and learn the truth of the world. We then see a scene with Zidane, Bartz and Squall as they examine their Crystals.\n</p><p>On the world map, head forward and take the right path at the split, there's a Counterfeit Wraith to take out. Beyond it is a chest with a Cure skill. Head back and take the path we know from Bartz and Zidane's tales that leads to the floating islands. Along the way is a chest with a KP Gambler, a treasured rarity now because there are none to be found in the Epilogue, so we're going to hang onto it for deep in that storyline. Cross the bridge and head right to find a chest with a Delicious Fish Scale and an Ephemeral Phantom. Once it's dead ascend the floating islands to reach the last gateway.\n<br style=\"clear:both\" />\n</p>\n<table class=\"D012 board\" style=\"float:right\">\n\n<tbody><tr bgcolor=\"068FB0\">\n<td width=\"19px;background:white\">&#160;\n</td>\n<th style=\"width:40px\">A\n</th>\n<th style=\"width:40px\">B\n</th>\n<th style=\"width:40px\">C\n</th>\n<th style=\"width:40px\">D\n</th>\n<th style=\"width:40px\">E\n</th>\n<th style=\"width:40px\">F\n</th>\n<th style=\"width:40px\">G\n</th>\n<th style=\"width:40px\">H\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">1\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/8/86/DFF_Chaos_Piece.png/revision/latest?cb=20110203235702\" class=\"mw-file-description image\" title=\"Garland\"><img alt=\"Garland\"  decoding=\"async\" loading=\"lazy\" width=\"36\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Chaos Piece.png\" data-image-key=\"DFF_Chaos_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/8/86/DFF_Chaos_Piece.png/revision/latest/scale-to-width-down/36?cb=20110203235702\" /></a></span>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">2\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/5/58/DFF_Hard_Battle_Piece.png/revision/latest?cb=20110203235357\" class=\"mw-file-description image\" title=\"Fallacious Tree\"><img alt=\"Fallacious Tree\"  decoding=\"async\" loading=\"lazy\" width=\"33\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Hard Battle Piece.png\" data-image-key=\"DFF_Hard_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/5/58/DFF_Hard_Battle_Piece.png/revision/latest/scale-to-width-down/33?cb=20110203235357\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/8/8f/D012_Emblem_Blue.png/revision/latest?cb=20201209004544\" class=\"mw-file-description image\" title=\"Initial BRV Boost for both\"><img alt=\"Initial BRV Boost for both\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"D012 Emblem Blue.png\" data-image-key=\"D012_Emblem_Blue.png\" data-relevant=\"0\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/8/8f/D012_Emblem_Blue.png/revision/latest?cb=20201209004544\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">3\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/5/58/DFF_Hard_Battle_Piece.png/revision/latest?cb=20110203235357\" class=\"mw-file-description image\" title=\"False Stalwart\"><img alt=\"False Stalwart\"  decoding=\"async\" loading=\"lazy\" width=\"33\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Hard Battle Piece.png\" data-image-key=\"DFF_Hard_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/5/58/DFF_Hard_Battle_Piece.png/revision/latest/scale-to-width-down/33?cb=20110203235357\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">4\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">5\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/5/58/DFF_Hard_Battle_Piece.png/revision/latest?cb=20110203235357\" class=\"mw-file-description image\" title=\"Transient Gunner\"><img alt=\"Transient Gunner\"  decoding=\"async\" loading=\"lazy\" width=\"33\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Hard Battle Piece.png\" data-image-key=\"DFF_Hard_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/5/58/DFF_Hard_Battle_Piece.png/revision/latest/scale-to-width-down/33?cb=20110203235357\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest?cb=20110203234631\" class=\"mw-file-description image\" title=\"Iifa Dew\"><img alt=\"Iifa Dew\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"30\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Chest.png\" data-image-key=\"DFF_Chest.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest/scale-to-width-down/40?cb=20110203234631\" /></a></span>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/8/8f/D012_Emblem_Blue.png/revision/latest?cb=20201209004544\" class=\"mw-file-description image\" title=\"Physical Critical Rate Up\"><img alt=\"Physical Critical Rate Up\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"D012 Emblem Blue.png\" data-image-key=\"D012_Emblem_Blue.png\" data-relevant=\"0\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/8/8f/D012_Emblem_Blue.png/revision/latest?cb=20201209004544\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/5/58/DFF_Hard_Battle_Piece.png/revision/latest?cb=20110203235357\" class=\"mw-file-description image\" title=\"Counterfeit Wraith\"><img alt=\"Counterfeit Wraith\"  decoding=\"async\" loading=\"lazy\" width=\"33\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Hard Battle Piece.png\" data-image-key=\"DFF_Hard_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/5/58/DFF_Hard_Battle_Piece.png/revision/latest/scale-to-width-down/33?cb=20110203235357\" /></a></span>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">6\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/7/7a/DFF_Start.png/revision/latest?cb=20201209045748\" class=\"mw-file-description image\"><img alt=\"DFF Start\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Start.png\" data-image-key=\"DFF_Start.png\" data-relevant=\"0\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/7/7a/DFF_Start.png/revision/latest?cb=20201209045748\" /></a></span>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest?cb=20110203234631\" class=\"mw-file-description image\" title=\"3000 gil\"><img alt=\"3000 gil\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"30\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Chest.png\" data-image-key=\"DFF_Chest.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest/scale-to-width-down/40?cb=20110203234631\" /></a></span>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">7\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr></tbody></table>\n<p>As we enter there's a few more cutscenes to watch, largely showing us that the other heroes are together now and chatting while the Warrior take care of Garland. Straight Chain on the emblem at E5 to get three enemies here. The emblem is a physical critical rate up, and we like those don't we, yes we do. The bonus line is 18 and the KP Chance is a 90 second win. And duh, there's a boss, guess what we do during these four fights to prepare.\n</p><p>First, a False Stalwart with Chain Cast, Thundaga, the Hyper Ring gear, an Ephemeral Vision Assist,and an unknown summon, but it's probably one of the Four Fiends. Next, a Transient Gunner with Ricochet Shot, Homing Bazooka, Satellite Laser, an unknown Assist, Kraken, and the Hyper Ring stuff. Third is a Counterfeit Wraith with Tentacle of Suffering (aerial spin attack), Long Range Particle Beam, the Hyper Ring timers, an unknown Assist, and Tiamat. The last foe guarding the end is a Fallacious Tree with Black Hole, Hurricane and Delta Attack, Tiamat, an unknown Assist, and the timed Hyper Ring accessories. The gateway helpfully has an Initial BRV Boost emblem to make the fight a cakewalk.\n</p><p>The two chests have 3000 gil and Iifa Dew.\n</p><p>At the end, Garland reveals the truth to the Warrior, that the war is a cycle that will go on forever, and the warriors of the gods will fight eternity. The Warrior should just embrace the eternity of battle, but the Warrior pities Garland for being consigned to such a fate. The Warrior on the other hand, now that he knows the truth, he can overcome it, and free Garland from the cycle. Garland does not take this suggestion well. This is my favorite pre-fight scene, Garland's attacks are all useless as the Warrior charges him.\n</p>\n<table style=\"width: 275px; D012 article-table; text-align: center; color:black; float:right\">\n<tbody><tr>\n<td style=\"font-size: larger; background:#1E90FF\" colspan=\"6\"><font color=\"white\"><b>Boss</b></font>\n</td></tr>\n<tr bgcolor=\"#1E90FF\">\n<td style=\"text-align: center;\" colspan=\"6\"><b><a href=\"https://finalfantasy.fandom.com/wiki/Garland_(Dissidia_PSP)\" target=\"_blank\" rel=\"noopener noreferrer\" title=\"Garland (Dissidia PSP)\">Garland</a></b>\n</td></tr>\n<tr bgcolor=\"#dddddd\">\n<td style=\"text-align: center;\" colspan=\"6\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/4/44/GarlandDissidiaRender.PNG/revision/latest?cb=20110228054925\" class=\"mw-file-description image\"><img alt=\"GarlandDissidiaRender\"  decoding=\"async\" loading=\"lazy\" width=\"149\" height=\"200\" class=\"mw-file-element lazyload\" data-image-name=\"GarlandDissidiaRender.PNG\" data-image-key=\"GarlandDissidiaRender.PNG\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/4/44/GarlandDissidiaRender.PNG/revision/latest/scale-to-width-down/149?cb=20110228054925\" /></a></span>\n</td></tr>\n<tr bgcolor=\"#1E90FF\">\n<td width=\"33%\" colspan=\"2\"><b>HP</b>\n</td>\n<td width=\"33%\" colspan=\"2\"><b>Level</b>\n</td>\n<td width=\"33%\" colspan=\"2\"><b>Bravery</b>\n</td></tr>\n<tr bgcolor=\"#dddddd\">\n<td colspan=\"2\">4,119\n</td>\n<td colspan=\"2\">26\n</td>\n<td colspan=\"2\">296\n</td></tr>\n<tr bgcolor=\"#1E90FF\">\n<td colspan=\"6\"><b>Brave Attacks</b>\n</td></tr>\n<tr bgcolor=\"#dddddd\">\n<td colspan=\"6\">Round Edge, Deathblow, Lance Charge, Twist Drill, Bardiche, Chain Cast\n</td></tr>\n<tr bgcolor=\"#1E90FF\">\n<td colspan=\"6\"><b>HP Attacks</b>\n</td></tr>\n<tr bgcolor=\"#dddddd\">\n<td colspan=\"6\">Earthquake, Cyclone, Blaze\n</td></tr>\n<tr bgcolor=\"#1E90FF\">\n<td colspan=\"3\"><b>Summon</b>\n</td>\n<td colspan=\"3\"><b>Difficulty</b>\n</td></tr>\n<tr bgcolor=\"#dddddd\">\n<td colspan=\"3\">Hecatoncheir\n</td>\n<td colspan=\"3\">1/5\n</td></tr></tbody></table>\n<p>Well, let's look over how much Garland has beefed up - a lot, of course. He's got the Flamberge and Shielded Armor for minor boosts to his attack and defense, and his stats are significantly higher than the Emperor's. He's packing a Hyper Ring and Muscle Belt hooked up to 7 Near Opponent boosters, giving him a pretty hefty damage bonus whenever he attacks with a melee move, which is most all he has. He also has Hecatoncheir, the eternally annoying summon that will sap the Bravery pool to zip to make the first Break you inflict pointless. And finally he has the highest HP of any boss so far, and the highest level as well.\n</p><p>That said, and I hate to say this kiddies....he's a wimp like always. The AI is just never very good at dodging or block attacks or being aggressive and taking advantage of my vulnerability when it does. All that really makes Garland a stand-out opponent is his higher HP and accessories, otherwise he's just as easy to take down as any other foe. Don't worry about losing your first EX Mode, the fight will go on long enough you'll be able to recharge it for a Burst finish like always.\n</p><p>The Warrior hit Level 19 from the fight and learned Ascension, effectively a ground version of Crossover, complete with a Rune Saber HP link once you master it, it just has slightly higher power in EX Mode due to summoning more swords of light.\n</p><p>As Garland begins to fade away, the Warrior receives his Crystal for...um....I'm not really sure, the entire point of his story has been to emphasize he has no doubts or hesitations about fighting, so what personal trial did he conquer again? Anyway, Garland also warns that there's no telling what might happen to the gods and the world when all the Crystals are gathered, and vanishes with a laugh. Then the other Warriors of Cosmos show up, all with their Crystals now, and they set off to return to Cosmos.\n</p><p>As they return Cosmos has a flashback of Shantotto and Gabranth, rather pointless since we've seen the full thing. Then the Warriors approach her with the Crystals, but Cosmos suddenly collapses and the world shifts from the light of Order's Sanctuary to the hellish nightmare of the End of Madness. Chaos appears, and wastes little time incinerating Cosmos in a pillar of fire. With the goddess slain Chaos departs.\n</p><p>So ends Chapter 10, now, only the epilogue awaits us.\n</p><p><br />\n</p>\n<table class=\"toccolours\" width=\"85%\" cellspacing=\"0\" style=\"border-collapse: collapse; margin:0 auto; text-align: center\">\n\n<tbody><tr>\n<td colspan=\"3\" style=\"text-align: center; border:solid 1px\"><b><a href=\"/story/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake\">Drake Clawfang's Dissidia 012 Walkthrough</a></b>\n</td></tr>\n<tr>\n<td width=\"10%\" style=\"border:solid 1px\" rowspan=\"2\"><b><a href=\"/story/013-light/chapter-9/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 18\">Previous page</a></b>\n</td>\n<td>\n<table width=\"100%\" style=\"text-align:center\">\n<tbody><tr>\n<td><b><a href=\"https://finalfantasy.fandom.com/wiki/Treachery_of_the_Gods\" target=\"_blank\" rel=\"noopener noreferrer\" title=\"Treachery of the Gods\">Treachery of the Gods</a></b>\n</td></tr>\n<tr>\n<td><a href=\"/story/012-treachery/prologue-chapter-1/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 1\">Prologue / Chapter 1</a> - <a href=\"/story/012-treachery/chapter-2/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 2\">2</a> - <a href=\"/story/012-treachery/chapter-3/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 3\">3</a> - <a href=\"/story/012-treachery/chapter-4/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 4\">4</a> - <a href=\"/story/012-treachery/chapter-5/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 5\">5</a> - <a href=\"/story/012-treachery/chapter-6/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 6\">6</a> - <a href=\"/story/012-treachery/chapter-7/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 7\">7</a> - <a href=\"/story/012-treachery/epilogue/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 8\">Epilogue</a><hr />\n</td></tr>\n<tr>\n<td><b><a href=\"https://finalfantasy.fandom.com/wiki/Light_to_All\" target=\"_blank\" rel=\"noopener noreferrer\" title=\"Light to All\">Light to All</a></b>\n</td></tr>\n<tr>\n<td><a href=\"/story/013-light/prologue/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 9\">Prologue</a> - <a href=\"/story/013-light/chapter-1/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 10\">Chapter 1</a> - <a href=\"/story/013-light/chapter-2/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 11\">2</a> - <a href=\"/story/013-light/chapter-3/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 12\">3</a> - <a href=\"/story/013-light/chapter-4/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 13\">4</a> - <a href=\"/story/013-light/chapter-5/\" title=\"Walkthrough:Dissidia 0