ision/latest/scale-to-width-down/39?cb=20141117182922\" /></a></span>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">3\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/5/58/DFF_Hard_Battle_Piece.png/revision/latest?cb=20110203235357\" class=\"mw-file-description image\" title=\"Counterfeit Wraith\"><img alt=\"Counterfeit Wraith\"  decoding=\"async\" loading=\"lazy\" width=\"33\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Hard Battle Piece.png\" data-image-key=\"DFF_Hard_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/5/58/DFF_Hard_Battle_Piece.png/revision/latest/scale-to-width-down/33?cb=20110203235357\" /></a></span>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/5/58/DFF_Hard_Battle_Piece.png/revision/latest?cb=20110203235357\" class=\"mw-file-description image\" title=\"Idle Sky Pirate\"><img alt=\"Idle Sky Pirate\"  decoding=\"async\" loading=\"lazy\" width=\"33\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Hard Battle Piece.png\" data-image-key=\"DFF_Hard_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/5/58/DFF_Hard_Battle_Piece.png/revision/latest/scale-to-width-down/33?cb=20110203235357\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest?cb=20110203234631\" class=\"mw-file-description image\" title=\"Guardstick\"><img alt=\"Guardstick\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"30\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Chest.png\" data-image-key=\"DFF_Chest.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest/scale-to-width-down/40?cb=20110203234631\" /></a></span>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">4\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/b/b5/DFF_Battle_Piece.png/revision/latest?cb=20110203234241\" class=\"mw-file-description image\" title=\"Fleeting Flash\"><img alt=\"Fleeting Flash\"  decoding=\"async\" loading=\"lazy\" width=\"16\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Battle Piece.png\" data-image-key=\"DFF_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/b/b5/DFF_Battle_Piece.png/revision/latest/scale-to-width-down/16?cb=20110203234241\" /></a></span>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">5\n</th>\n<th>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">6\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">7\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr></tbody></table>\n<p>Out here to the right shortly is a False Stalwart. Now, there have been exactly two before, and by this time a Battlegen item should be available for win, Stalwart's Hopes, you have to Break them to get it. Get three of them (so we have to fight more) and at long last we can buy that Hyper Ring in the shop, which gives a +5% boost to the Power Ring's +3. That works out to an 11% power boost over a 6.6% one, using two 1.5x Boosters. So close. You'll know if you get the Hopes in-battle when a Gold star with a notification appears in the upper-left as you Break the Stalwart. Beyond it is the Oerba Beads, they unlock new shop content but nothing we can buy or need to. Next the near gateway is a stone leading to an island via grind bar, a Cure skill waits. As always, into the blue gateway, kiddies!\n</p><p>Enemy line-up this time is two Idle Sky Pirates, an Ephemeral Phantom, a Counterfeit Wraith, and a Fleeting Flash. One of the Idle Sky Pirates is perhaps our most dangerous foe yet. He begins with 3000 Bravery, uses the Tiamat summon to triple it up to 9000, and then spams Windburst, and Yuna has nothing that can reflect it yet. I would say this is the first battle so far where Carbuncle is useful, except that as a Strange Battle Piece he has low HP so once your Bravery hits 0 from the HP attack he'll be dead. Instead try Cactuar, wear him down as much as you can before Tiamat finishes its countdown to activation and then summon Cactuar if you get him to say, 1100 or lower, leaving him with a few hundred once Tiamat goes off. If you can't get him that weak then don't use Cactuar, save the charges. Use a Jump Chain where you start to chain four enemies, I lacked such though so I had to fight them one by one, a Multichain would only get 3, meaning we get 9 KP for a skill we have to pay 10 KP for.\n</p><p>The chest only has a Guard Stick, bleh, useless. It unlocks the Mythril Rod in the shop which we can't get because we have no Mythril. As I said before, D012's main problem when it comes to its shop and equipment system is they don't give you the trade accessories needed to trade for equipment until the point that equipment is outdated. And now for the last gateway.\n</p>\n<table class=\"D012 board\" style=\"float:right\">\n\n<tbody><tr bgcolor=\"068FB0\">\n<td width=\"19px;background:white\">&#160;\n</td>\n<th style=\"width:40px\">A\n</th>\n<th style=\"width:40px\">B\n</th>\n<th style=\"width:40px\">C\n</th>\n<th style=\"width:40px\">D\n</th>\n<th style=\"width:40px\">E\n</th>\n<th style=\"width:40px\">F\n</th>\n<th style=\"width:40px\">G\n</th>\n<th style=\"width:40px\">H\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">1\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/5/58/DFF_Hard_Battle_Piece.png/revision/latest?cb=20110203235357\" class=\"mw-file-description image\" title=\"Ephemeral Vision\"><img alt=\"Ephemeral Vision\"  decoding=\"async\" loading=\"lazy\" width=\"33\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Hard Battle Piece.png\" data-image-key=\"DFF_Hard_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/5/58/DFF_Hard_Battle_Piece.png/revision/latest/scale-to-width-down/33?cb=20110203235357\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest?cb=20110203234631\" class=\"mw-file-description image\" title=\"Pink Tail\"><img alt=\"Pink Tail\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"30\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Chest.png\" data-image-key=\"DFF_Chest.png\" dat