---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { drakeCampaigns } from '../../../data/story/drakeData';
import { getDrakeChaptersByCampaign } from '../../../data/story/drakeChaptersData';

const campaign = '012-treachery';
const campaignInfo = drakeCampaigns.find(c => c.campaignSlug === campaign) || drakeCampaigns[0];
const chapters = getDrakeChaptersByCampaign(campaign);

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const resolveImg = (src: string) => src.startsWith('http') ? src : `${baseUrl}${src.startsWith('/') ? src.slice(1) : src}`;

const currentNavPath = 'story-012';
---

<BaseLayout title={`${campaignInfo.title} — Drake's Walkthrough`} currentPath={currentNavPath}>
  <!-- Header Bar -->
  <div class="campaign-header">
    <h1>
      {campaignInfo.title}
    </h1>
    <div class="campaign-subtitle">
      {campaignInfo.subtitle} &bull; {campaignInfo.partsRange}
    </div>
    <p class="campaign-desc">
      {campaignInfo.desc}
    </p>
  </div>

  <!-- Chapters Grid -->
  <div class="chapters-grid">
    {chapters.map(ch => (
      <div class="crystal-panel chapter-card">
        <div>
          <div class="chapter-card-header">
            <div class="chapter-identity">
              {ch.portrait && (
                <img src={resolveImg(ch.portrait)} alt={ch.character} width="48" height="48" loading="lazy" decoding="async" class="chapter-portrait" />
              )}
              <div>
                <div class="chapter-meta">
                  Part {ch.partNumber} &bull; {ch.character}
                </div>
                <h2 class="chapter-title">
                  <a href={`${baseUrl}story/${ch.campaign}/${ch.slug}/`} class="chapter-title-link">
                    {ch.title}
                  </a>
                </h2>
              </div>
            </div>
          </div>
          <div class="chapter-subtitle">
            {ch.subtitle}
          </div>

          <!-- Section Headings Quick List -->
          {ch.sections && ch.sections.length > 0 && (
            <div class="sections-preview">
              <div class="sections-title">Sections:</div>
              <ul class="sections-list">
                {ch.sections.slice(0, 3).map(s => (
                  <li>{s.line}</li>
                ))}
                {ch.sections.length > 3 && <li>+ {ch.sections.length - 3} more...</li>}
              </ul>
            </div>
          )}
        </div>

        <div class="chapter-card-footer">
          <a href={`${baseUrl}story/${ch.campaign}/${ch.slug}/`} class="btn-action btn-read" aria-label={`Read guide for ${ch.title}`}>
            Read Guide &rarr;
          </a>
        </div>
      </div>
    ))}
  </div>

</BaseLayout>

<style>
  .campaign-header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-panel);
    padding-bottom: 1rem;
  }

  .campaign-subtitle {
    color: var(--color-cosmos);
    font-weight: 600;
    margin-top: 0.25rem;
    font-family: var(--font-subheading);
  }

  .campaign-desc {
    color: var(--text-muted);
    margin-top: 0.5rem;
    line-height: 1.6;
  }

  .chapters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.25rem;
    margin-bottom: 3rem;
  }

  .chapter-card {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-top: 3px solid var(--color-cosmos);
  }

  .chapter-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: 0.65rem;
  }

  .chapter-identity {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .chapter-portrait {
    width: 48px;
    height: 48px;
    object-fit: contain;
    background: rgba(0, 0, 0, 0.4);
    border-radius: var(--radius-xs);
    border: 1px solid var(--border-panel-subtle);
    padding: 2px;
  }

  .chapter-meta {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--color-cosmos);
    font-weight: 700;
  }

  .chapter-title {
    margin: 0.15rem 0 0;
    font-size: 1.25rem;
    color: var(--text-main);
    font-family: var(--font-heading);
  }

  .chapter-title-link {
    color: inherit;
    text-decoration: none;
  }

  .chapter-title-link:hover {
    color: var(--color-brv);
    text-decoration: none;
  }

  .chapter-subtitle {
    font-size: 0.86rem;
    color: var(--text-dim);
    margin-bottom: 1rem;
    font-family: var(--font-subheading);
    line-height: 1.45;
  }

  .sections-preview {
    margin-bottom: 1rem;
    background: rgba(0, 0, 0, 0.25);
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-xs);
    border: 1px solid var(--border-panel-subtle);
    font-size: 0.78rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .sections-title {
    color: var(--color-brv);
    font-weight: 700;
    margin-bottom: 0.25rem;
    text-transform: uppercase;
    font-size: 0.7rem;
  }

  .sections-list {
    margin: 0;
    padding-left: 1.1rem;
    line-height: 1.4;
  }

  .chapter-card-footer {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    border-top: 1px solid var(--border-panel-subtle);
    padding-top: 0.85rem;
  }

  .btn-read {
    padding: 0.4rem 0.95rem;
    font-size: 0.85rem;
    white-space: nowrap;
  }
</style>
