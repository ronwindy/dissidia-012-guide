latest/scale-to-width-down/33?cb=20110203235357\" /></a></span>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/a/ae/DFF_Strange_Battle_Piece.png/revision/latest?cb=20110204000919\" class=\"mw-file-description image\" title=\"Idle Sky Pirate\"><img alt=\"Idle Sky Pirate\"  decoding=\"async\" loading=\"lazy\" width=\"17\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Strange Battle Piece.png\" data-image-key=\"DFF_Strange_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/a/ae/DFF_Strange_Battle_Piece.png/revision/latest/scale-to-width-down/17?cb=20110204000919\" /></a></span>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">3\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/b/b5/DFF_Battle_Piece.png/revision/latest?cb=20110203234241\" class=\"mw-file-description image\" title=\"Delusory Dragoon\"><img alt=\"Delusory Dragoon\"  decoding=\"async\" loading=\"lazy\" width=\"16\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Battle Piece.png\" data-image-key=\"DFF_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/b/b5/DFF_Battle_Piece.png/revision/latest/scale-to-width-down/16?cb=20110203234241\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/b/b5/DFF_Battle_Piece.png/revision/latest?cb=20110203234241\" class=\"mw-file-description image\" title=\"Fleeting Flash\"><img alt=\"Fleeting Flash\"  decoding=\"async\" loading=\"lazy\" width=\"16\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Battle Piece.png\" data-image-key=\"DFF_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/b/b5/DFF_Battle_Piece.png/revision/latest/scale-to-width-down/16?cb=20110203234241\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">4\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/5/58/DFF_Hard_Battle_Piece.png/revision/latest?cb=20110203235357\" class=\"mw-file-description image\" title=\"Imitation Despot\"><img alt=\"Imitation Despot\"  decoding=\"async\" loading=\"lazy\" width=\"33\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Hard Battle Piece.png\" data-image-key=\"DFF_Hard_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/5/58/DFF_Hard_Battle_Piece.png/revision/latest/scale-to-width-down/33?cb=20110203235357\" /></a></span>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">5\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest?cb=20110203234631\" class=\"mw-file-description image\" title=\"Soul of Patience\"><img alt=\"Soul of Patience\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"30\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Chest.png\" data-image-key=\"DFF_Chest.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest/scale-to-width-down/40?cb=20110203234631\" /></a></span>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">6\n</th>\n<th>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/7/7a/DFF_Start.png/revision/latest?cb=20201209045748\" class=\"mw-file-description image\"><img alt=\"DFF Start\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Start.png\" data-image-key=\"DFF_Start.png\" data-relevant=\"0\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/7/7a/DFF_Start.png/revision/latest?cb=20201209045748\" /></a></span>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">7\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr></tbody></table>\n<p>Immediately turn to the right and you'll see a blue gateway, head over naturally. There's a chest near it with a BRV Charge skill. The enemies inside aren't too tough, go ahead and use the BRV Charge if you like. As for the enemy types....sigh, they're back. Delusory Dragoon, Fleeting Flash, Idle Sky Pirate, and they haven't changed a bit. The Strange Battle Piece is the Sky Pirate, he's got a huge Bravery boost and Torrent, along with the Cactuar summon. The False Hero at A2 is new-ish, it has Ascension, a short-range shield throw that reaches into the air and knocks you into the sky to begin a chase, and Crossover, essentially a midair version of Ascension. Both have high power. \n</p><p>At Level 9 Lightning learns Reverse Paradigm, which lets her cycle through them in reverse order. But we're not using the Medic role so she only has two, and thus the ability is useless. At Level 11 she gets Lightning Strike, an effective mid-range HP attack that is a welcome addition to our ground arsenal when the alternative has been Razor Gale.\n</p><p>The chests have an Iifa Leaf and a Soul of Patience, and then a Zombie Rag. It unlocks a single equipment piece, the Bard's Tunic, which is way out of our price range. \n</p><p>Back outside follow the main path, grabbing two orbs of the dead along the way, to a ruined castle with a moogle and our next gateway. Turn right to another area with a Capricious Reaper, he won't last too long with three Cursed Rings on. Behind it is a chest with 1500 gil. Approach the ruined castle and the moogle calls out to us as the \"Thunder Lady\" (I love that line, moogles are so adorable). Apparently he's the same moogle who greeted Lightning back in Chapter 1 and followed us around that little region, and now he's got his own shop, but not much for inventory. All he has is Pebbles. They're useless as bought, but if you equip them, after a fight they have a random chance to break and become either another Pebble, or a Growth Seed, which is one of several trade accessories needed for the Growth Egg, along with some Chocobo accessories from the Play Plan. We'll worry about this later, no point giving up accessory slots for stuff we can't use yet.\n</p>\n<table class=\"D012 board\" style=\"float:right\">\n\n<tbody><tr bgcolor=\"068FB0\">\n<td width=\"19px;background:white\">&#160;\n</td>\n<th style=\"width:40px\">A\n</th>\n<th style=\"width:40px\">B\n</th>\n<th style=\"width:40px\">C\n</th>\n<th style=\"width:40px\">D\n</th>\n<th style=\"width:40px\">E\n</th>\n<th style=\"width:40px\">F\n</th>\n<th style=\"width:40px\">G\n</th>\n<th style=\"width:40px\">H\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">1\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/4/44/DFF_Summonstone.png/revision/latest?cb=20100712153022\" class=\"mw-file-description image\" title=\"Odin (AUTO)\"><img alt=\"Odin (AUTO)\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"38\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Summonstone.png\" data-image-key=\"DFF_Summonstone.png\" data-relevant=\"0\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/4/44/DFF_Summonstone.png/revision/latest/scale-to-width-down/40?cb=20100712153022\" /></a></span>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">2\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/5/58/DFF_Hard_Battle_Piece.png/revision/latest?cb=20110203235357\" class=\"mw-file-description image\" title=\"False Hero\"><img alt=\"False Hero\"  decoding=\"async\" loading=\"lazy\" width=\"33\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Hard Battle Piece.png\" data-image-key=\"DFF_Hard_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/5/58/DFF_Hard_Battle_Piece.png/revision/latest/scale-to-width-down/33?cb=20110203235357\" /></a></span>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/f/fc/DFF_Potion.png/revision/latest?cb=20110203235732\" class=\"mw-file-description image\" title=\"Potion\"><img alt=\"Potion\"  decoding=\"async\" loading=\"lazy\" width=\"21\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Potion.png\" data-image-key=\"DFF_Potion.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/f/fc/DFF_Potion.png/revision/latest/scale-to-width-down/21?cb=20110203235732\" /></a></span>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">3\n</th>\n<th bgcolor=\"cabd62\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/7/7a/DFF_Start.png/revision/latest?cb=20201209045748\" class=\"mw-file-description image\"><img alt=\"DFF Start\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Start.png\" data-image-key=\"DFF_Start.png\" data-relevant=\"0\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/7/7a/DFF_Start.png/revision/latest?cb=20201209045748\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest?cb=20110203234631\" class=\"mw-file-description image\" title=\"2000 gil\"><img alt=\"2000 gil\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"30\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Chest.png\" data-image-key=\"DFF_Chest.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest/scale-to-width-down/40?cb=20110203234631\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/3/3f/DFF_Cosmos_Piece.png/revision/latest?cb=20110203234754\" class=\"mw-file-description image\" title=\"Warrior of Light\"><img alt=\"Warrior of Light\"  decoding=\"async\" loading=\"lazy\" width=\"25\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Cosmos Piece.png\" data-image-key=\"DFF_Cosmos_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/3/3f/DFF_Cosmos_Piece.png/revision/latest/scale-to-width-down/25?cb=20110203234754\" /></a></span>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">4\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/5/58/DFF_Hard_Battle_Piece.png/revision/latest?cb=20110203235357\" class=\"mw-file-description image\" title=\"Ephemeral Summoner\"><img alt=\"Ephemeral Summoner\"  decoding=\"async\" loading=\"lazy\" width=\"33\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Hard Battle Piece.png\" data-image-key=\"DFF_Hard_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/5/58/DFF_Hard_Battle_Piece.png/revision/latest/scale-to-width-down/33?cb=20110203235357\" /></a></span>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">5\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/2/24/DFF_Ultimate_Battle_Piece.png/revision/latest?cb=20110204003934\" class=\"mw-file-description image\" title=\"Ephemeral Phantom\"><img alt=\"Ephemeral Phantom\"  decoding=\"async\" loading=\"lazy\" width=\"29\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Ultimate Battle Piece.png\" data-image-key=\"DFF_Ultimate_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/2/24/DFF_Ultimate_Battle_Piece.png/revision/latest/scale-to-width-down/29?cb=20110204003934\" /></a></span>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">6\n</th>\n<th>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest?cb=20110203234631\" class=\"mw-file-description image\" title=\"Blazefire Saber\"><img alt=\"Blazefire Saber\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"30\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Chest.png\" data-image-key=\"DFF_Chest.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest/scale-to-width-down/40?cb=20110203234631\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest?cb=20110203234631\" class=\"mw-file-description image\" title=\"Mythril\"><img alt=\"Mythril\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"30\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Chest.png\" data-image-key=\"DFF_Chest.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest/scale-to-width-down/40?cb=20110203234631\" /></a></span>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">7\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr></tbody></table>\n<p>In the gateway, open the chest for 2000 gil. The two enemies you can skip but you won't, because you're not a wimp, are an Ephemeral Summoner and a False Hero. The Summoner has a new Bravery attack, Aerospark, a ground-based mid-range charge attack. Given that both are pushovers, draw out the fights to charge your EX Gauge. As I fought Lightning learned Ground Dash. Ground Dash only works when you're on the ground and won't let you dash into the air, but when dashing you count as being on the ground, letting you quickly stop and use ground attacks. Take the summonstone and Lightning unites with an old friend, Odin. He summons himself automatically when the opponent has enough Bravery to kill you in one hit, and tries to Break them. Now, time for the last enemy. Warning - he's the most powerful enemy in the pre-Epilogue storyline.\n</p><p>The Ephemeral Phantom is Level 23 so he has a huge boost to his starting Bravery, and has Bahamut to boot. He has all of Jecht's attacks except for Ultimate Jecht Shot - that includes Jecht Block which again can block almost anything. And as the highest level of battle piece possible, he's very good with them, and will chain his combos into HP attacks if he gets in a hit on you. And when he gets weak his boosters trigger for a 25x multiplier to his two Hyper Rings, giving him an insanely high damage buff. You need to be in top form to beat this guy. Begin by entering EX Mode and pummeling him what-good, he'll activate Bahamut. You've got a few choices for a summon of your own, I took Cactuar but I imagine Carbuncle is a better choice really, land an HP attack after Bahamut wears off to sap him of all his hard-boosted Bravery and Break him. He's not <i>too</i> bad really, but he is easily the most competent opponent yet easily above the bosses, and if you're a new player he'll be quite a challenge I imagine.\n</p><p>The rewards for beating him are of course the two chests, which have a Blazefire Saber and a piece of Mythril. The Saber has power nowhere near that of the Capella, while the Mythril unlocks numerous items in the ship requiring it, none of which we'll buy because the ones I think worth buying, like the armor or the hand armor, either require two pieces or are too expensive. It's okay kiddies, Mythril equipment is only worth using in threes, I'll explain why and cover buying it when we can get three of them. Now chug the Potion to top off your HP and EX gauge after the fight, and approach the Cosmos piece. Lightning tells the Warrior of Light and Cosmos about the hell out there with the manikins running amock, Kain being a traitor and the rest of the warriors scattered to who-knows what fate. Cosmos then senses Jecht's defeat and insists she can sense the rest of the group is alive in spite of what Lightning thinks of Kain's actions, but Lightning cuts her off to keep bitching. The Warrior decides he's had enough and raises his sword.\n</p>\n<table style=\"width: 275px; D012 article-table; text-align: center; color:black; float:right\">\n<tbody><tr>\n<td style=\"font-size: larger; background:#1E90FF\" colspan=\"6\"><font color=\"white\"><b>Boss</b></font>\n</td></tr>\n<tr bgcolor=\"#1E90FF\">\n<td style=\"text-align: center;\" colspan=\"6\"><b><a href=\"https://finalfantasy.fandom.com/wiki/Warrior_of_Light_(Dissidia)\" target=\"_blank\" rel=\"noopener noreferrer\" title=\"Warrior of Light (Dissidia)\">Warrior of Light</a></b>\n</td></tr>\n<tr bgcolor=\"#dddddd\">\n<td style=\"text-align: center;\" colspan=\"6\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/d/d3/WoLDissidiaModel.PNG/revision/latest?cb=20110706100935\" class=\"mw-file-description image\"><img alt=\"WoLDissidiaModel\"  decoding=\"async\" loading=\"lazy\" width=\"100\" height=\"195\" class=\"mw-file-element lazyload\" data-image-name=\"WoLDissidiaModel.PNG\" data-image-key=\"WoLDissidiaModel.PNG\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/d/d3/WoLDissidiaModel.PNG/revision/latest/scale-to-width-down/100?cb=20110706100935\" /></a></span>\n</td></tr>\n<tr bgcolor=\"#1E90FF\">\n<td width=\"33%\" colspan=\"2\"><b>HP</b>\n</td>\n<td width=\"33%\" colspan=\"2\"><b>Level</b>\n</td>\n<td width=\"33%\" colspan=\"2\"><b>Bravery</b>\n</td></tr>\n<tr bgcolor=\"#dddddd\">\n<td colspan=\"2\">2,762\n</td>\n<td colspan=\"2\">18\n</td>\n<td colspan=\"2\">306\n</td></tr>\n<tr bgcolor=\"#1E90FF\">\n<td colspan=\"6\"><b>Brave Attacks</b>\n</td></tr>\n<tr bgcolor=\"#dddddd\">\n<td colspan=\"6\">Dayflash, Blue Fang, Ascension, Crossover, Shield Strike, Rising Buckler\n</td></tr>\n<tr bgcolor=\"#1E90FF\">\n<td colspan=\"6\"><b>HP Attacks</b>\n</td></tr>\n<tr bgcolor=\"#dddddd\">\n<td colspan=\"6\">Ultimate Shield, Shining Wave, Shield of Light, Bitter End, Rune Saber\n</td></tr>\n<tr bgcolor=\"#1E90FF\">\n<td colspan=\"3\"><b>Summon</b>\n</td>\n<td colspan=\"3\"><b>Difficulty</b>\n</td></tr>\n<tr bgcolor=\"#dddddd\">\n<td colspan=\"3\">Alexander\n</td>\n<td colspan=\"3\">1.5/5\n</td></tr></tbody></table>\n<p>The Warrior has mostly attacks you've seen from his Manikins - Dayflash is a quick ground combo, Blue Fang summons ice shards to shoot at you from above, Ascension is a short-range shield throw into the air, Crossover is basically the same in the air, Shield Strike is an aerial downward shield throw, Rising Buckler is an upward one. His HP attacks are where this gets deadly. Ultimate Shield has him pause for a moment, then throw his shield at you to a surprising range, and drags you closer to combo you. Shining Wave sends a pillar of light at you, tracking you into the air, and Bitter End and Rune Saber are a new type of trick - HP Links. \n</p><p>Some Bravery attacks can link right into HP attacks without pause, and the Warrior has four of them here, Ascension, Crossover, Shield Strike and Rising Buckler. This makes avoiding his Bravery attacks more important than previous enemies, taking Bravery hits has been fine before since they can't actually damage HP, here, he can link them to attacks that can. Fortunately all four of those attacks are a bit slow on the start-up so you can block them. And if he Breaks you, well you're in for a real rough time of it because he has Alexander, which freezes his Bravery at its current value, preventing him from increasing it yes, but also preventing you from damaging it, and if he lands an HP hit, guess what, he doesn't reset to 0. Do not let him Break you whatever you do. And to wrap this all up, he's got six boosters and a Power Ring to give him a decent buff when he attacks with a Bravery attack. Be thankful it's not a Hyper Ring or Muscle Belt.\n</p><p>Similar to the Emperor, the Warrior has a pretty good set-up. What saves us and dooms him is once again the AI's incompetence, he can't use his moveset effective. He has HP Links mostly in the hypothetical sense, the AI doesn't much use them when it should be using them every chance it has because it has. Smack the Warrior around with EX Mode Lightning's simpler but more effective Smite and Launch to Break him, and I had Ifrit here to boost me up to 1600 Bravery or so. Then I let him recover his Bravery and whipped out my EX Burst, Breaking him again and killing him. Not a very difficult battle, especially compared to the Ephemeral Phantom and even then he wasn't too hard.\n</p><p>Cosmos breaks up the brawl and the Warrior confesses to what's going on. Kain told him that the wars are a cycle that will be repeated, and if they can incapacitate their allies and keep them safe from the manikins until the next cycle begins, they'll be able to survive the manikin horde and awaken to fight again. However, if they keep fighting now the manikins will eventually overrun them through sheer numbers. Thus Kain set out to find the others before the manikins do, put them to sleep, and hide them away to save them. Lightning is promptly pissed at this plan, and sees the pretty obvious flaw of it - who's to say when they wake up next time the manikins won't still be around, and what's it matter either way if the war is indeed endless? Laguna, Vaan and Yuna arrive in time to hear what's going on, and when the Warrior tells them that there's nothing to doubt accept defeat and let the cycle run its course, Lightning is again unimpressed and says that before the current cycle ends they might as well go down fighting and killing as many as they can. However, Laguna has a third option to let us know about and tells them about the portal they're coming from. Well, there's our path then. The four set out with the Warrior staying to guard Cosmos.\n</p><p><br />\n</p>\n<table class=\"toccolours\" width=\"85%\" cellspacing=\"0\" style=\"border-collapse: collapse; margin:0 auto; text-align: center\">\n\n<tbody><tr>\n<td colspan=\"3\" style=\"text-align: center; border:solid 1px\"><b><a href=\"/story/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake\">Drake Clawfang's Dissidia 012 Walkthrough</a></b>\n</td></tr>\n<tr>\n<td width=\"10%\" style=\"border:solid 1px\" rowspan=\"2\"><b><a href=\"/story/012-treachery/chapter-4/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 4\">Previous page</a></b>\n</td>\n<td>\n<table width=\"100%\" style=\"text-align:center\">\n<tbody><tr>\n<td><b><a href=\"https://finalfantasy.fandom.com/wiki/Treachery_of_the_Gods\" target=\"_blank\" rel=\"noopener noreferrer\" title=\"Treachery of the Gods\">Treachery of the Gods</a></b>\n</td></tr>\n<tr>\n<td><a href=\"/story/012-treachery/prologue-chapter-1/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 1\">Prologue / Chapter 1</a> - <a href=\"/story/012-treachery/chapter-2/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 2\">2</a> - <a href=\"/story/012-treachery/chapter-3/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 3\">3</a> - <a href=\"/story/012-treachery/chapter-4/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 4\">4</a> - <strong class=\"mw-selflink selflink\">5</strong> - <a href=\"/story/012-treachery/chapter-6/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 6\">6</a> - <a href=\"/story/012-treachery/chapter-7/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 7\">7</a> - <a href=\"/story/012-treachery/epilogue/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 8\">Epilogue</a><hr />\n</td></tr>\n<tr>\n<td><b><a href=\"https://finalfantasy.fandom.com/wiki/Light_to_All\" target=\"_blank\" rel=\"noopener noreferrer\" title=\"Light to All\">Light to All</a></b>\n</td></tr>\n<tr>\n<td><a href=\"/story/013-light/prologue/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 9\">Prologue</a> - <a href=\"/story/013-light/chapter-1/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 10\">Chapter 1</a> - <a href=\"/story/013-light/chapter-2/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 11\">2</a> - <a href=\"/story/013-light/chapter-3/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 12\">3</a> - <a href=\"/story/013-light/chapter-4/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 13\">4</a> - <a href=\"/story/013-light/chapter-5/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 14\">5</a> - <a href=\"/story/013-light/chapter-6/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 15\">6</a> - <a href=\"/story/013-light/chapter-7/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 16\">7</a> - <a href=\"/story/013-light/chapter-8/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 17\">8</a> - <a href=\"/story/013-light/chapter-9/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 18\">9</a> - <a href=\"/story/013-light/chapter-10/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 19\">10</a> - <a href=\"/story/013-light/epilogue-part-1/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 20\">Epilogue Part 1</a> - <a href=\"/story/013-light/epilogue-part-2/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 21\">Part 2</a><hr />\n</td></tr></tbody></table>\n</td>\n<td width=\"10%\" style=\"border:solid 1px\" rowspan=\"2\"><b><a href=\"/story/012-treachery/chapter-6/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 6\">Next page</a></b>\n</td></tr>\n<tr>\n<td>\n<table width=\"100%\" style=\"text-align:center\">\n<tbody><tr>\n<td width=\"50%\" valign=\"top\">\n<table width=\"100%\" style=\"text-align:center\">\n<caption><b><a href=\"https://finalfantasy.fandom.com/wiki/Confessions_of_the_Creator\" target=\"_blank\" rel=\"noopener noreferrer\" title=\"Confessions of the Creator\">Confessions of the Creator</a></b>\n</caption>\n<tbody><tr>\n<td><a href=\"/story/000-creator/southern-areas/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 22\">Part 1</a> - <a href=\"/story/000-creator/shantotto-and-gabranth/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 23\">Part 2</a> - <a href=\"/story/000-creator/chasm-of-earth-and-flying-castle/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 24\">Part 3</a> - <a href=\"/story/000-creator/gaia-and-bahamut-isles/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 25\">Part 4</a> - <a href=\"/story/000-creator/land-of-discord-and-feral-chaos/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Part 26\">Part 5</a>\n</td></tr></tbody></table>\n</td>\n<td width=\"50%\" valign=\"top\">\n<table width=\"100%\" style=\"text-align:center\">\n<caption><b>Extras</b>\n</caption>\n<tbody><tr>\n<td><a href=\"/story/reports/\" title=\"Walkthrough:Dissidia 012 Final Fantasy/Drake/Reports\">The Reports</a>\n</td></tr></tbody></table>\n</td></tr></tbody></table>\n</td></tr><