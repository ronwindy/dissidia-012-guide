n/29?cb=20110204003934\" /></a></span>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">3\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/7/7a/DFF_Start.png/revision/latest?cb=20201209045748\" class=\"mw-file-description image\"><img alt=\"DFF Start\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Start.png\" data-image-key=\"DFF_Start.png\" data-relevant=\"0\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/7/7a/DFF_Start.png/revision/latest?cb=20201209045748\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/1/13/D012_Emblem_Purple.png/revision/latest?cb=20201209050509\" class=\"mw-file-description image\" title=\"KP +1\"><img alt=\"KP +1\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"D012 Emblem Purple.png\" data-image-key=\"D012_Emblem_Purple.png\" data-relevant=\"0\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/1/13/D012_Emblem_Purple.png/revision/latest?cb=20201209050509\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\"><b>AC</b>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">4\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">5\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest?cb=20110203234631\" class=\"mw-file-description image\" title=\"Chain Skill\"><img alt=\"Chain Skill\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"30\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Chest.png\" data-image-key=\"DFF_Chest.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest/scale-to-width-down/40?cb=20110203234631\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/2/24/DFF_Ultimate_Battle_Piece.png/revision/latest?cb=20110204003934\" class=\"mw-file-description image\" title=\"False Hero\"><img alt=\"False Hero\"  decoding=\"async\" loading=\"lazy\" width=\"29\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Ultimate Battle Piece.png\" data-image-key=\"DFF_Ultimate_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/2/24/DFF_Ultimate_Battle_Piece.png/revision/latest/scale-to-width-down/29?cb=20110204003934\" /></a></span>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/2/24/DFF_Ultimate_Battle_Piece.png/revision/latest?cb=20110204003934\" class=\"mw-file-description image\" title=\"Delusory Knight\"><img alt=\"Delusory Knight\"  decoding=\"async\" loading=\"lazy\" width=\"29\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Ultimate Battle Piece.png\" data-image-key=\"DFF_Ultimate_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/2/24/DFF_Ultimate_Battle_Piece.png/revision/latest/scale-to-width-down/29?cb=20110204003934\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest?cb=20110203234631\" class=\"mw-file-description image\" title=\"Electrum\"><img alt=\"Electrum\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"30\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Chest.png\" data-image-key=\"DFF_Chest.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest/scale-to-width-down/40?cb=20110203234631\" /></a></span>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">6\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest?cb=20110203234631\" class=\"mw-file-description image\" title=\"Electrum\"><img alt=\"Electrum\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"30\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Chest.png\" data-image-key=\"DFF_Chest.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest/scale-to-width-down/40?cb=20110203234631\" /></a></span>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">7\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr></tbody></table>\n<p>We're finally at the end kiddies, can you believe it? Jump Chain at C3 to get three enemies, the purple emblem is a KP +1. Otherwise, Multichain at A2 to still get three, but no KP bonus. I just had a Round Chain so once again I fought them one by one, using Charge skills I had collected from chests.\n</p><p>The upper-left enemy is a Level 122 Counterfeit Youth with Ultima Weapon and a Counterfeit Wraith. The lower-left enemy is a Level 122 False Hero with Ultima Weapon and a False Stalwart. The lower-right one is a Level 123 Delusory Knight with Omega and a Delusory Dragoon. The last enemy, behind the Assist and guarding the golden moogle chalice, is a Level 122 Imitation Liegeman with Omega and an Imitation Despot.\n</p><p>The last three chests have a random skill and two more Electrums. Grab the golden moogle chalice to <i>triple</i> your KP, likely to over 2000 by this point, and head out of the dungeon at least.\n<br style=\"clear:both\" />\n</p>\n<h2><span class=\"mw-headline\" id=\"Beyond_the_Desert\">Beyond the Desert</span><a title=\"Edit section&#39;s source code: Beyond the Desert\" data-tracking-label=\"edit-section-anon\" data-action=\"edit-section\" href=\"https://finalfantasy.fandom.com/wiki/Walkthrough:Dissidia_012_Final_Fantasy/Drake/Part_25?action=edit&amp;section=3\" aria-label=\"Edit section&#39;s source code: Beyond the Desert\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<figure class=\"mw-default-size mw-halign-right\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/9/97/World_B_Bahamut_Isles.png/revision/latest?cb=20110505203508\" class=\"mw-file-description image\" title=\"Bahamut Isles\"><img alt=\"Bahamut Isles\"  decoding=\"async\" loading=\"lazy\" width=\"287\" height=\"156\" class=\"mw-file-element lazyload\" data-image-name=\"World B Bahamut Isles.png\" data-image-key=\"World_B_Bahamut_Isles.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/9/97/World_B_Bahamut_Isles.png/revision/latest?cb=20110505203508\" /></a><figcaption>Bahamut Isles</figcaption></figure>\n<p>Zidane is party leader for the next while. Don't worry about restocking your map skills, we don't need any yet. Teleport back to the desert, the exit to the Bahamut Isles is nearby. Head forward past the empty gateway to find a new playmate, a Level 123 Imitation Despot with Omega and an Imitation Liegeman Assist. And he's got level 100 equipment too, what joy. Behind it is a chest with a <b>KP Bonus</b>. Moving forward, shatter the rock and cross to the opposite island, to the right here is a chest with a Diamond, to the left is a second Imitation Despot. At the end beyond it is a chest with a Gold Angel. Back on the mainland there's another rock to shatter, it leads to an Elixir. Through the open gateway we'll encounter Lightning, who unsurprisingly has some pretty cynical words for us, specifically for our companion. Who is this \"mured moogle\" anyway? After her is the Citadel of Trials teleport stone, with the associated ruins nearby. And beyond that our next gateway, Conquered Trials.\n<br style=\"clear:both\" />\n</p>\n<table class=\"D012 board\" style=\"float:right\">\n\n<tbody><tr bgcolor=\"068FB0\">\n<td width=\"19px;background:white\">&#160;\n</td>\n<th style=\"width:40px\">A\n</th>\n<th style=\"width:40px\">B\n</th>\n<th style=\"width:40px\">C\n</th>\n<th style=\"width:40px\">D\n</th>\n<th style=\"width:40px\">E\n</th>\n<th style=\"width:40px\">F\n</th>\n<th style=\"width:40px\">G\n</th>\n<th style=\"width:40px\">H\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">1\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/7/73/DFF_Stigma_Of_Chaos.png/revision/latest?cb=20141117182922\" class=\"mw-file-description image\" title=\"Stigma of Chaos\"><img alt=\"Stigma of Chaos\"  decoding=\"async\" loading=\"lazy\" width=\"39\" height=\"40\"