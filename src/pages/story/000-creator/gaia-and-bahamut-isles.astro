ookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest?cb=20110203234631\" class=\"mw-file-description image\" title=\"Diamond Ring\"><img alt=\"Diamond Ring\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"30\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Chest.png\" data-image-key=\"DFF_Chest.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest/scale-to-width-down/40?cb=20110203234631\" /></a></span>\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">4\n</th>\n<th>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/1/1e/DFF_Expert_Battle_Piece.png/revision/latest?cb=20110204003912\" class=\"mw-file-description image\" title=\"Fallacious Tree\"><img alt=\"Fallacious Tree\"  decoding=\"async\" loading=\"lazy\" width=\"25\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Expert Battle Piece.png\" data-image-key=\"DFF_Expert_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/1/1e/DFF_Expert_Battle_Piece.png/revision/latest/scale-to-width-down/25?cb=20110204003912\" /></a></span>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">5\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/2/24/DFF_Ultimate_Battle_Piece.png/revision/latest?cb=20110204003934\" class=\"mw-file-description image\" title=\"Delusory Dragon\"><img alt=\"Delusory Dragon\"  decoding=\"async\" loading=\"lazy\" width=\"29\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Ultimate Battle Piece.png\" data-image-key=\"DFF_Ultimate_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/2/24/DFF_Ultimate_Battle_Piece.png/revision/latest/scale-to-width-down/29?cb=20110204003934\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest?cb=20110203234631\" class=\"mw-file-description image\" title=\"Chain Skill\"><img alt=\"Chain Skill\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"30\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Chest.png\" data-image-key=\"DFF_Chest.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest/scale-to-width-down/40?cb=20110203234631\" /></a></span>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">6\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">7\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th></tr></tbody></table>\n<p>The KP Chance here is a reasonable 60 second Break, equip summons like Carbuncle, Lich and even Kraken to help you out. As the first floor warns, there are more Ultimate Level 120 enemies here, so summons will be needed, you aren't gonna be doing 3000 Bravery damage to them in a minute. The bonus line, of course, is 100. Multichain at F3 with a KP Gambler, we'll get it out of the way since this floor has the most enemies of the dungeon.\n</p><p>We start off with the Party piece, a Level 90 Imaginary Champion with Bahamut and an Imaginary Soldier, and a Level 120 Fleeting Flash with Ultima Weapon. Then come the three Experts, a Level 90 Fallacious Tree, a Level 90 Delusory Warlock with the Giant of Babil and a Delusory Knight, and a Level 90 Phantasmal Harlequin with Tiamat. Finally the two Ultimates, a Level 120 Delusory Dragoon with Ultima Weapon, and a Level 120 Idle Sky Pirate with Omega and a Warrior of Antiquity. Lightning took a beating from the two 120s, I kept going through because I had Exp to HP, so she'll be fighting fit again after a few more fights.\n</p><p>The two chests containing, for a shocking change of pace, a Diamond Ring and a random skill.\n<br style=\"clear:both\" />\n</p>\n<table class=\"D012 board\" style=\"float:right\">\n\n<tbody><tr bgcolor=\"068FB0\">\n<td width=\"19px;background:white\">&#160;\n</td>\n<th style=\"width:40px\">A\n</th>\n<th style=\"width:40px\">B\n</th>\n<th style=\"width:40px\">C\n</th>\n<th style=\"width:40px\">D\n</th>\n<th style=\"width:40px\">E\n</th>\n<th style=\"width:40px\">F\n</th>\n<th style=\"width:40px\">G\n</th>\n<th style=\"width:40px\">H\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">1\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest?cb=20110203234631\" class=\"mw-file-description image\" title=\"Multichain\"><img alt=\"Multichain\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"30\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Chest.png\" data-image-key=\"DFF_Chest.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest/scale-to-width-down/40?cb=20110203234631\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/1/1e/DFF_Expert_