ae/DFF_Strange_Battle_Piece.png/revision/latest?cb=20110204000919\" class=\"mw-file-description image\" title=\"False Hero\"><img alt=\"False Hero\"  decoding=\"async\" loading=\"lazy\" width=\"17\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Strange Battle Piece.png\" data-image-key=\"DFF_Strange_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/a/ae/DFF_Strange_Battle_Piece.png/revision/latest/scale-to-width-down/17?cb=20110204000919\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/8/8f/D012_Emblem_Blue.png/revision/latest?cb=20201209004544\" class=\"mw-file-description image\" title=\"Accessories Protected\"><img alt=\"Accessories Protected\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"D012 Emblem Blue.png\" data-image-key=\"D012_Emblem_Blue.png\" data-relevant=\"0\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/8/8f/D012_Emblem_Blue.png/revision/latest?cb=20201209004544\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/7/7a/DFF_Start.png/revision/latest?cb=20201209045748\" class=\"mw-file-description image\"><img alt=\"DFF Start\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Start.png\" data-image-key=\"DFF_Start.png\" data-relevant=\"0\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/7/7a/DFF_Start.png/revision/latest?cb=20201209045748\" /></a></span>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">4\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\"><b>AC</b>\n</th>\n<th bgcolor=\"cabd62\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/8/8f/D012_Emblem_Blue.png/revision/latest?cb=20201209004544\" class=\"mw-file-description image\" title=\"Accessories Protected\"><img alt=\"Accessories Protected\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"D012 Emblem Blue.png\" data-image-key=\"D012_Emblem_Blue.png\" data-relevant=\"0\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/8/8f/D012_Emblem_Blue.png/revision/latest?cb=20201209004544\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/5/58/DFF_Hard_Battle_Piece.png/revision/latest?cb=20110203235357\" class=\"mw-file-description image\" title=\"Imaginary Soldier\"><img alt=\"Imaginary Soldier\"  decoding=\"async\" loading=\"lazy\" width=\"33\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Hard Battle Piece.png\" data-image-key=\"DFF_Hard_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/5/58/DFF_Hard_Battle_Piece.png/revision/latest/scale-to-width-down/33?cb=20110203235357\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">5\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">6\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">7\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr></tbody></table>\n<p>As we enter we someone hear Shantotto think it was she who let the manikins in, to experiment on, and she wonders who made them. Multichain right at C3 where we begin to get all four enemies.\n</p><p>First, a Level 63 Imaginary Soldier. Second, a Level 63 Capricious Thief. The Strange enemy is a Level 100 False Hero, he comes into battle with several thousand Bravery, uses Dayflash and Shield of Light, and has a Cactuar summon. Pretty simple to beat. The last enemy, the Expert, is a Level 89 False Stalwart with the Behemoth summon and a False Hero Assist. He's pretty annoying to tango with, at least for me with Prishe he was. Thank you Chaos Shrine Ω for helping me sap his Bravery!\n</p><p>The chest has an Iifa Dew, but the red chest is a new feature - it's actually an enemy in disguise. Our playmate is a Level 90 Delusory Warlock with the Giant of Babil summon and Delusory Knight Assist. Have fun! Victory yields a random Level 90 trade accessory.\n</p><p>On the final floor, the layout is simple and not needing a map. Shantotto thanks us for our help, in spite of how much of a loser we are, and invites us to come receive our reward. There's a final enemy to face, as you can see, a Level 62 Horror of Antiquity.\n</p><p>The blue and gold chest has more level 90 trade stuff, the normal chest has a random piece of the \"Allure of Honey\" set - the Sexy Cologne, Member's Card, Blonde Wig and Silk Dress. When all four are worn, the Battlegen and item drop rates increase by 50%. It's pretty useless though, Mognet gives us an endless supply of Superslick and Mog's Amulet for those effects, and for Battlegen there's the Sunrise. Not to mention the equipment is a lame Level 30 set. Now, you can approach the end piece, or you can fight your Assist and get them out of the way to get access to the chests their guarding, three more trade accessories. The choice is yours, but I say do it.\n</p>\n<h2><span id=\"The_Lady.27s_Lesson\"></span><span class=\"mw-headline\" id=\"The_Lady's_Lesson\">The Lady's Lesson</span><a title=\"Edit section&#39;s source code: The Lady&#39;s Lesson\" data-tracking-label=\"edit-section-anon\" data-action=\"edit-section\" href=\"https://finalfantasy.fandom.com/wiki/Walkthrough:Dissidia_012_Final_Fantasy/Drake/Part_23?action=edit&amp;section=2\" aria-label=\"Edit section&#39;s source code: The Lady&#39;s Lesson\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<table style=\"width: 275px; D012 article-table; text-align: center; color:black; float:right\">\n<tbody><tr>\n<td style=\"font-size: larger; background:#1E90FF\" colspan=\"6\"><font color=\"white\"><b>Boss</b></font>\n</td></tr>\n<tr bgcolor=\"#1E90FF\">\n<td style=\"text-align: center;\" colspan=\"6\"><b><a href=\"https://finalfantasy.fandom.com/wiki/Shantotto_(Dissidia_PSP)\" target=\"_blank\" rel=\"noopener noreferrer\" title=\"Shantotto (Dissidia PSP)\">Shantotto</a></b>\n</td></tr>\n<tr bgcolor=\"#dddddd\">\n<td style=\"text-align: center;\" colspan=\"6\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/7/76/ShantottoDissidiaLaughing.PNG/revision/latest?cb=20101208035813\" class=\"mw-file-description image\"><img alt=\"ShantottoDissidiaLaughing\"  decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"138\" class=\"mw-file-element lazyload\" data-image-name=\"ShantottoDissidiaLaughing.PNG\" data-image-key=\"ShantottoDissidiaLaughing.PNG\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/7/76/ShantottoDissidiaLaughing.PNG/revision/latest/scale-to-width-down/80?cb=20101208035813\" /></a></span>\n</td></tr>\n<tr bgcolor=\"#1E90FF\">\n<td width=\"33%\" colspan=\"2\"><b>HP</b>\n</td>\n<td width=\"33%\" colspan=\"2\"><b>Level</b>\n</td>\n<td width=\"33%\" colspan=\"2\"><b>Bravery</b>\n</td></tr>\n<tr bgcolor=\"#dddddd\">\n<td colspan=\"2\">8,078\n</td>\n<td colspan=\"2\">70\n</td>\n<td colspan=\"2\">1,391\n</td></tr>\n<tr bgcolor=\"#1E90FF\">\n<td colspan=\"6\"><b>Brave Attacks</b>\n</td></tr>\n<tr bgcolor=\"#dddddd\">\n<td colspan=\"6\">A Couple Attacks, Bind, Stun, Retribution, Bio\n</td></tr>\n<tr bgcolor=\"#1E90FF\">\n<td colspan=\"6\"><b>HP Attacks</b>\n</td></tr>\n<tr bgcolor=\"#dddddd\">\n<td colspan=\"6\">Spirit Magic Fire, Spirit Magic Ice, Spirit Magic Wind, Spirit Magic Water, Spirit Magic Earth, Spirit Magic Thunder\n</td></tr>\n<tr bgcolor=\"#1E90FF\">\n<td colspan=\"3\"><b>Summon</b>\n</td>\n<td colspan=\"3\"><b>Difficulty</b>\n</td></tr>\n<tr bgcolor=\"#dddddd\">\n<td colspan=\"3\">Ultima Weapon\n</td>\n<td colspan=\"3\">1/5\n</td></tr></tbody></table>\n<p>Shantotto thanks us for our help and scores us, and now for our reward - a private lesson from the Minister of Magic herself. The class is Pain 101.\n</p><p>Shantotto's main problem should be obvious right off the bat - Level 70. As a result you're going to benefit from a pretty large Bravery boost. Of course, she has the same - she's got nine Blue Gems equipped, which is why she has that whopping 1,391 base Bravery, and thus her HP attacks are going to hurt a lot. She's also got the Bonecrusher to give her another Bravery boost when near death. She has the Ultima Weapon summon and a Horror of Antiquity Assist.\n</p><p>This fight was over before Ultima Weapon fired, in spite of Shantotto calling it right at the start of the fight. The reason is simple - I had the Bahamut summon, the perfect summon for Order's Sanctuary Ω. When I broke Shantotto the stage gimmick doubled my Bravery, which was over 4000 between the damage I was doing and Bahamut's boosts. Then it was just the formality of an EX Burst finish and the Chainspeller was felled. \n</p><p>Even if you don't use this strategy, Shantotto won't be too much trouble, her massive level disadvantage will work against her, as long as you got the hang of her attack patterns when facing her manikins, you'll be fine. Just watch out for Stun and remember to block her ground staff combo, you can block her aerial staff throw but it'll stagger you and you might get hit by something else.\n</p><p>Shantotto laughs we did alright, for someone who could barely handle her magic. Yeah, sure. Now she has an appointment to attend with an opponent. Gabri, Gabro, Gabrand? Whatever, she's off to find him, and has some more shout-outs to FF11 stuff as she departs.\n</p><p>Well, that's done, the gateway is unsealed. Now, how's about we go find this \"Gabrand\" fellow she was talking about? \n</p>\n<h2><span class=\"mw-headline\" id=\"Highway_to_Hell\">Highway to Hell</span><a title=\"Edit section&#39;s source code: Highway to Hell\" data-tracking-label=\"edit-section-anon\" data-action=\"edit-section\" href=\"https://finalfantasy.fandom.com/wiki/Walkthrough:Dissidia_012_Final_Fantasy/Drake/Part_23?action=edit&amp;section=3\" aria-label=\"Edit section&#39;s source code: Highway to Hell\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p>Restock your chain skills and <i>definitely</i> bring a Multichain and KP Gambler this time. Otherwise, bring a Jump Chain or two. Use the teleport stone to teleport to the Marsh Cave, this is the gateway down in the snowfields we couldn't reach before. Head down, open the chest for a Crystal, then dive into the gateway. This time Lightning will lead the charge.\n</p><p>As we enter, we find ourselves approached by Gabranth. He leaves quickly, telling us to choose our path and head down it, not thaty it matters. This is another alternate dimension like the one Shantotto dwells in, but this one is where those who refuse to fight in the cycle are banished until they submit. Gabranth was one such warrior and now guards this place in case anyone stumbles into it, like we have.\n</p>\n<table class=\"D012 board\" style=\"float:right\">\n\n<tbody><tr bgcolor=\"068FB0\">\n<td width=\"19px;background:white\">&#160;\n</td>\n<th style=\"width:40px\">A\n</th>\n<th style=\"width:40px\">B\n</th>\n<th style=\"width:40px\">C\n</th>\n<th style=\"width:40px\">D\n</th>\n<th style=\"width:40px\">E\n</th>\n<th style=\"width:40px\">F\n</th>\n<th style=\"width:40px\">G\n</th>\n<th style=\"width:40px\">H\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">1\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/6/6b/DFF_Rare_Chest.png/revision/latest?cb=20110203235927\" class=\"mw-file-description image\" title=\"Lv. 90 armor component\"><img alt=\"Lv. 90 armor component\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"30\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Rare Chest.png\" data-image-key=\"DFF_Rare_Chest.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/6/6b/DFF_Rare_Chest.png/revision/latest/scale-to-width-down/40?cb=20110203235927\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/1/1e/DFF_Expert_Battle_Piece.png/revision/latest?cb=20110204003912\" class=\"mw-file-description image\" title=\"Lady of Antiquity\"><img alt=\"Lady of Antiquity\"  decoding=\"async\" loading=\"lazy\" width=\"25\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Expert Battle Piece.png\" data-image-key=\"DFF_Expert_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/1/1e/DFF_Expert_Battle_Piece.png/revision/latest/scale-to-width-down/25?cb=20110204003912\" /></a></span>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/7/73/DFF_Stigma_Of_Chaos.png/revision/latest?cb=20141117182922\" class=\"mw-file-description image\" title=\"Stigma of Chaos\"><img alt=\"Stigma of Chaos\"  decoding=\"async\" loading=\"lazy\" width=\"39\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Stigma Of Chaos.png\" data-image-key=\"DFF_Stigma_Of_Chaos.png\" data-relevant=\"0\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/7/73/DFF_Stigma_Of_Chaos.png/revision/latest/scale-to-width-down/39?cb=20141117182922\" /></a></span>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">2\n</th>\n<th>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/1/13/D012_Emblem_Purple.png/revision/latest?cb=20201209050509\" class=\"mw-file-description image\" title=\"Initial BRV Boost\"><img alt=\"Initial BRV Boost\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"D012 Emblem Purple.png\" data-image-key=\"D012_Emblem_Purple.png\" data-relevant=\"0\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/1/13/D012_Emblem_Purple.png/revision/latest?cb=20201209050509\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/1/1e/DFF_Expert_Battle_Piece.png/revision/latest?cb=20110204003912\" class=\"mw-file-description image\" title=\"Warrior of Antiquity\"><img alt=\"Warrior of Antiquity\"  decoding=\"async\" loading=\"lazy\" width=\"25\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Expert Battle Piece.png\" data-image-key=\"DFF_Expert_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/1/1e/DFF_Expert_Battle_Piece.png/revision/latest/scale-to-width-down/25?cb=20110204003912\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">3\n</th>\n<th bgcolor=\"cabd62\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/7/7a/DFF_Start.png/revision/latest?cb=20201209045748\" class=\"mw-file-description image\"><img alt=\"DFF Start\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Start.png\" data-image-key=\"DFF_Start.png\" data-relevant=\"0\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/7/7a/DFF_Start.png/revision/latest?cb=20201209045748\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/1/13/D012_Emblem_Purple.png/revision/latest?cb=20201209050509\" class=\"mw-file-description image\" title=\"Initial BRV 0\"><img alt=\"Initial BRV 0\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"D012 Emblem Purple.png\" data-image-key=\"D012_Emblem_Purple.png\" data-relevant=\"0\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/1/13/D012_Emblem_Purple.png/revision/latest?cb=20201209050509\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/1/13/D012_Emblem_Purple.png/revision/latest?cb=20201209050509\" class=\"mw-file-description image\" title=\"KP +1\"><img alt=\"KP +1\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"D012 Emblem Purple.png\" data-image-key=\"D012_Emblem_Purple.png\" data-relevant=\"0\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/1/13/D012_Emblem_Purple.png/revision/latest?cb=20201209050509\" /></a></span>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">4\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/1/1e/DFF_Expert_Battle_Piece.png/revision/latest?cb=20110204003912\" class=\"mw-file-description image\" title=\"Horror of Antiquity\"><img alt=\"Horror of Antiquity\"  decoding=\"async\" loading=\"lazy\" width=\"25\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Expert Battle Piece.png\" data-image-key=\"DFF_Expert_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/1/1e/DFF_Expert_Battle_Piece.png/revision/latest/scale-to-width-down/25?cb=20110204003912\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/a/ac/D012_Emblem_Red.png/revision/latest?cb=20201209050655\" class=\"mw-file-description image\" title=\"Physical Damage 0\"><img alt=\"Physical Damage 0\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"D012 Emblem Red.png\" data-image-key=\"D012_Emblem_Red.png\" data-relevant=\"0\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/a/ac/D012_Emblem_Red.png/revision/latest?cb=20201209050655\" /></a></span>\n</th>\n<th bgcolor=\"cabd62\"><b>AC</b>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">5\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/1/1e/DFF_Expert_Battle_Piece.png/revision/latest?cb=20110204003912\" class=\"mw-file-description image\" title=\"False Stalwart\"><img alt=\"False Stalwart\"  decoding=\"async\" loading=\"lazy\" width=\"25\" height=\"40\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Expert Battle Piece.png\" data-image-key=\"DFF_Expert_Battle_Piece.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/1/1e/DFF_Expert_Battle_Piece.png/revision/latest/scale-to-width-down/25?cb=20110204003912\" /></a></span>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">6\n</th>\n<th>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest?cb=20110203234631\" class=\"mw-file-description image\" title=\"Chain Skill\"><img alt=\"Chain Skill\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"30\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Chest.png\" data-image-key=\"DFF_Chest.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest/scale-to-width-down/40?cb=20110203234631\" /></a></span>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">7\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr></tbody></table>\n<p>Jump Chain at D3 to get all enemies, the purple emblem is a KP +1. You could also do it at B3, but that purple emblem is an Initial BRV 0 so we win less KP. Also only do this if you have more than one Jump Chain, if not hold onto it. The bonus line is 80, and the KP Chance is a 90 second win. Enemies here are much stronger than in Shantotto's gateway, the weakest you'll see is Level 70s, most though reach into the 80s and 90s.\n</p><p>First up is a Level 79 Lady of Antiquity with Carbuncle. Second is a Level 80 Horror of Antiquity with Hecatoncheir. Third, a Level 89 False Stalwart with Behemoth and a False Hero Assist.\n</p><p>The last is a Warrior of Antiquity Level 79, Gabranth's Manikin. Don't be deceived by how the fight in the Reports against Gabranth went, these guys are equipped for war. As I covered in his profile, Gabranth's gimmick is to charge that EX Gauge and stay in EX Mode where he's a powerhouse of mayhem. Well, the Warrior has an Arcane Resin to begin with a full EX Gauge, then he has a Pearl Necklace, Dragonfly Orb, Attractorb, and 6 Break boosters. I'd have given him EX Mode boosters, but that is a good build. He's armed with Enrage, a long and powerful ground combo that has him dash forward on start-up, Relentless Lunge, a series of three sharp dashes forward, Aero, which creates a blockable tornado, Rupture, a dive up or down at you to slam you in the same direction, Dual Rend, a quick two-hit blast backwards, and Vortex of Judgment, a trio of spin attacks. His HP attacks are Execution, a charge forward to consume you in an explosion, Innocence, sending four beams of energy in an arc downwards, and Hatred, creating a sphere of energy around him that explodes. Have fun fighting the Judge Magister in his most powerful form and seeing just how strong he is, and get used to it because the real thing is even worse as I'll cover when the time comes.\n</p><p>When you're done, the normal chest has a random skill. The blue and gold chests again have level 90 trade components throughout the gateway.\n</p>\n<table class=\"D012 board\" style=\"float:right\">\n\n<tbody><tr bgcolor=\"068FB0\">\n<td width=\"19px;background:white\">&#160;\n</td>\n<th style=\"width:40px\">A\n</th>\n<th style=\"width:40px\">B\n</th>\n<th style=\"width:40px\">C\n</th>\n<th style=\"width:40px\">D\n</th>\n<th style=\"width:40px\">E\n</th>\n<th style=\"width:40px\">F\n</th>\n<th style=\"width:40px\">G\n</th>\n<th style=\"width:40px\">H\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">1\n</th>\n<th>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest?cb=20110203234631\" class=\"mw-file-description image\" title=\"Diamond Ring\"><img alt=\"Diamond Ring\"  decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"30\" class=\"mw-file-element lazyload\" data-image-name=\"DFF Chest.png\" data-image-key=\"DFF_Chest.png\" data-relevant=\"1\" src=\"https://static.wikia.nocookie.net/finalfantasy/images/3/38/DFF_Chest.png/revision/latest/scale-to-width-down/40?cb=20110203234631\" /></a></span>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th>\n</th>\n<th style=\"display:none\">\n</th>\n<th style=\"display:none\">\n</th></tr>\n<tr style=\"height:40px; text-align:center\">\n<th bgcolor=\"068FB0\">2\n</th>\n<th>\n</th>\n<th>\n</th>\n<th bgcolor=\"cabd62\">&#160;\n</th>\n<th bgcolor=\"cabd62\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/finalfantasy/images/1/1e/DFF_Expert_Battle_Piece.png/revision/latest?cb=20110204003