const exBurstInputsTable = [
  {
    type: "Rapid Button Mash",
    icon: "⚡",
    characters: "Cloud, Garland, Kain, Jecht, Prishe",
    charImages: ["08_Cloud_Strife.png", "05_Kain_Highwind.png", "27_Jecht.png"],
    mechanic: "Repeatedly tap the displayed button as fast as possible to fill the power gauge before timeout.",
    badgeInput: "psp-circle",
    badgeLabel: "⭕ Mash"
  },
  {
    type: "Precision Timing Bar",
    icon: "🎯",
    characters: "Squall, Sephiroth, Warrior of Light, Gabranth",
    charImages: ["10_Squall_Leonhart.png", "24_Sephiroth.png", "01_Warrior_of_Light.webp"],
