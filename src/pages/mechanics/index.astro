---

<BaseLayout title="Combat Mechanics Master Guide" currentPath="mechanics">
  <!-- Hero Section -->
  <div class="hero-panel" style="border-left: 4px solid var(--color-brv);">
    <div style="display: flex; align-items: center; gap: 0.65rem; margin-bottom: 0.85rem; flex-wrap: wrap;">
      <span class="badge-pill badge-cosmos">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        Combat Mechanics Master
      </span>
      <span class="badge-pill badge-new">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        System Reference
      </span>
      <span class="badge-pill badge-crystal">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="6 2 18 2 22 8 12 22 2 8 6 2"/></svg>
        PSP Final Fantasy Engine
      </span>
    </div>

    <h1 style="margin-bottom: 0.5rem; letter-spacing: 0.04em;">
      MASTER COMBAT MECHANICS & SYSTEM COMPENDIUM
    </h1>
    <p style="font-size: 1.12rem; color: var(--color-brv); font-family: var(--font-subheading); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 1.25rem;">
      Exhaustive Visual Breakdown of Bravery, Assist Dynamics, EX Revenge, Priority Collision Frames, and Damage Calculations
    </p>
    <p style="font-size: 0.98rem; color: var(--text-sub); max-width: 980px; line-height: 1.7; margin-bottom: 1.5rem;">
      <em>Dissidia 012 [duodecim] Final Fantasy</em> is built on an intricate dual-resource combat model combining <strong>Bravery (BRV)</strong> power-stealing, lethal <strong>Hit Point (HP)</strong> conversions, 3D aerial navigation, the revolutionary <strong>Assist System</strong>, and dynamic <strong>EX Mode / EX Revenge</strong> mechanics.
    </p>

    <!-- Quick Jump Menu with Icons -->
    <div style="border-top: 1px solid var(--border-panel-subtle); padding-top: 1.25rem; margin-top: 1.25rem;">
      <div style="font-size: 0.82rem; font-family: var(--font-subheading); font-weight: 700; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.4rem;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="13 17 18 12 13 7"/><polyline points="6 17 11 12 6 7"/></svg>
        Quick Jump to Combat Modules:
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
        {quickJumpSections.map(s => (
          <a href={`#${s.id}`} class="badge-pill badge-enemy" style="text-decoration: none; padding: 0.35rem 0.75rem; font-size: 0.82rem; display: inline-flex; align-items: center; gap: 0.4rem; transition: all var(--transition-fast);">
            <span set:html={s.icon} style="display: flex; align-items: center;" />
            <span>{s.title}</span>
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- VISUAL BATTLE HUD SIMULATOR -->
  <section id="battle-hud-simulator" class="guide-section">
    <div class="section-header">
      <div class="section-title">
        <span class="badge-pill badge-cosmos">Interactive Architecture</span>
        <h2 style="margin: 0; border: none; padding: 0;">Interactive Battle HUD Architecture</h2>
      </div>
    </div>

    <!-- Battle HUD Visual Card -->
    <div class="hud-simulator-card">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border-panel-subtle); padding-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
        <div style="display: flex; align-items: center; gap: 0.6rem;">
          <span class="badge-pill badge-brv" style="font-size: 0.75rem;">STAGE BRV POOL</span>
          <span style="font-family: var(--font-mono); font-size: 1.25rem; font-weight: 800; color: #fbbf24; text-shadow: 0 0 10px rgba(251,191,36,0.5);">
            💰 2,480
          </span>
        </div>
        <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.82rem; font-family: var(--font-mono); color: var(--text-dim);">
          <span>ARENA:</span>
          <span style="color: var(--text-main); font-weight: 700;">Order's Sanctuary</span>
        </div>
      </div>

      <!-- Player HUD Pane vs Opponent HUD Pane Grid -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
        <!-- PLAYER 1 HUD (LIGHTNING) -->
        <div style="background: rgba(14, 20, 36, 0.7); border: 1px solid rgba(56, 189, 248, 0.3); border-radius: var(--radius-sm); padding: 1rem;">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.6rem;">
            <div style="display: flex; align-items: center; gap: 0.6rem;">
              <img src={`${baseUrl}dissidia_012_characters/17_Lightning.png`} alt="Lightning" class="character-avatar-mini" />
              <div>
                <div style="font-family: var(--font-heading); font-size: 1.15rem; font-weight: 800; color: #fff; line-height: 1;">LIGHTNING</div>
                <div style="font-size: 0.72rem; font-family: var(--font-mono); color: var(--color-brv);">LV 100 • COSMOS</div>
              </div>
            </div>
            <div style="text-align: right;">
              <div style="font-size: 0.7rem; color: var(--text-dim); font-family: var(--font-mono);">HP (8,190 / 9,999)</div>
              <div style="font-family: var(--font-mono); font-weight: 800; color: #34d399; font-size: 1.05rem;">8,190</div>
            </div>
          </div>

          <!-- HP Bar -->
          <div class="hud-gauge-bar" style="margin-bottom: 0.6rem;" title="Player HP Gauge">
            <div class="hud-gauge-fill-hp" style="width: 82%;"></div>
          </div>

          <!-- BRV Bank -->
          <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.25rem;">
            <span style="font-size: 0.75rem; font-family: var(--font-subheading); font-weight: 700; color: var(--color-brv); letter-spacing: 0.05em;">BRAVERY (BRV)</span>
            <span style="font-family: var(--font-mono); font-weight: 800; font-size: 1.35rem; color: #38bdf8; text-shadow: 0 0 12px rgba(56,189,248,0.7);">
              3,450
            </span>
          </div>
          <div class="hud-gauge-bar" style="margin-bottom: 0.85rem;" title="Player BRV Gauge">
            <div class="hud-gauge-fill-brv" style="width: 55%;"></div>
          </div>

          <!-- Assist & EX Gauge Status -->
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; padding-top: 0.5rem; border-top: 1px solid rgba(255,255,255,0.08);">
            <div>
              <div style="font-size: 0.7rem; font-family: var(--font-mono); color: var(--color-assist); margin-bottom: 0.25rem; font-weight: 700;">
                ASSIST GAUGE (2 BARS)
              </div>
              <div class="assist-meter-box">
                <div class="assist-meter-segment" title="Bar 1: Assist BRV / Escape Ready"></div>
                <div class="assist-meter-segment" title="Bar 2: Assist HP Ready"></div>
              </div>
            </div>
            <div>
              <div style="font-size: 0.7rem; font-family: var(--font-mono); color: var(--color-ex-gauge); margin-bottom: 0.25rem; font-weight: 700;">
                EX GAUGE (FULL)
              </div>
              <div class="hud-gauge-bar">
                <div class="hud-gauge-fill-ex" style="width: 100%;"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- OPPONENT HUD (SEPHIROTH) -->
        <div style="background: rgba(14, 20, 36, 0.7); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: var(--radius-sm); padding: 1rem;">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.6rem;">
            <div style="display: flex; align-items: center; gap: 0.6rem;">
              <img src={`${baseUrl}dissidia_012_characters/24_Sephiroth.png`} alt="Sephiroth" class="character-avatar-mini" style="border-color: var(--color-chaos);" />
              <div>
                <div style="font-family: var(--font-heading); font-size: 1.15rem; font-weight: 800; color: #fff; line-height: 1;">SEPHIROTH</div>
                <div style="font-size: 0.72rem; font-family: var(--font-mono); color: var(--color-chaos);">LV 100 • CHAOS</div>
              </div>
            </div>
            <div style="text-align: right;">
              <div style="font-size: 0.7rem; color: var(--text-dim); font-family: var(--font-mono);">HP (4,200 / 9,999)</div>
              <div style="font-family: var(--font-mono); font-weight: 800; color: #f87171; font-size: 1.05rem;">4,200</div>
            </div>
          </div>

          <!-- HP Bar -->
          <div class="hud-gauge-bar" style="margin-bottom: 0.6rem;" title="Opponent HP Gauge">
            <div class="hud-gauge-fill-hp" style="width: 42%; background: linear-gradient(90deg, #dc2626 0%, #f87171 100%);"></div>
          </div>

          <!-- BRV Bank -->
          <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.25rem;">
            <span style="font-size: 0.75rem; font-family: var(--font-subheading); font-weight: 700; color: var(--color-hp); letter-spacing: 0.05em;">BRAVERY (BRV)</span>
            <span style="font-family: var(--font-mono); font-weight: 800; font-size: 1.35rem; color: #f43f5e; text-shadow: 0 0 12px rgba(244,63,94,0.7);">
              1,120
            </span>
          </div>
          <div class="hud-gauge-bar" style="margin-bottom: 0.85rem;" title="Opponent BRV Gauge">
            <div class="hud-gauge-fill-brv" style="width: 25%; background: linear-gradient(90deg, #be123c 0%, #f43f5e 100%);"></div>
          </div>

          <!-- Assist & EX Gauge Status -->
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; padding-top: 0.5rem; border-top: 1px solid rgba(255,255,255,0.08);">
            <div>
              <div style="font-size: 0.7rem; font-family: var(--font-mono); color: var(--color-assist); margin-bottom: 0.25rem; font-weight: 700;">
                ASSIST GAUGE (1 BAR)
              </div>
              <div class="assist-meter-box">
                <div class="assist-meter-segment"></div>
                <div class="assist-meter-segment empty"></div>
              </div>
            </div>
            <div>
              <div style="font-size: 0.7rem; font-family: var(--font-mono); color: var(--color-ex-gauge); margin-bottom: 0.25rem; font-weight: 700;">
                EX GAUGE (40%)
              </div>
              <div class="hud-gauge-bar">
                <div class="hud-gauge-fill-ex" style="width: 40%; animation: none;"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 1: THE BRAVERY & HP SYSTEM -->
  <section id="brv-hp-system" class="guide-section">
    <div class="section-header">
      <div class="section-title">
        <span class="badge-pill badge-cosmos">Core Engine</span>
