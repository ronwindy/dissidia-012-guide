    notes: "Must be dodged or countered via Assist Change / EX Revenge."
  },
  {
    tier: "Weak Magic",
    icon: "✨",
    examples: "Single energy darts, small fireballs, rapid pellets (e.g., Terra Fire, Kuja Ring Holy startup)",
    vsGuard: "Reflected back at Attacker",
    vsMagic: "Nullified by Weak/Mid/Strong Physical & Magic",
    notes: "Easily reflected by standard Guard (R)."
  },
  {
    tier: "Mid Magic",
    icon: "🔮",
    examples: "Medium projectiles, homing orbs (e.g., Ultimecia Knight's Arrows, Shantotto Tier-2 Spells, Lightning Watera)",
