    charImages: ["30_Gilgamesh.png", "23_Kefka_Palazzo.png"],
    mechanic: "Stop spinning slot reels on matching jackpot icons (HIT, CRIT, Excalibur) for maximum multi-hits.",
    badgeInput: "psp-square",
    badgeLabel: "🔲 Stop Reel"
  }
];

const summonClassifications = [
  {
    category: "BRV Draining & Halving",
    icon: "🩸",
    summons: "Odin, Bahamut, Shiva, Leviathan, Ramuh",
    effect: "Instantly slashes the opponent's current Bravery in half, drains points over time, or redistributes BRV to the caster.",
    tactic: "Best used against opponents hoarding 4,000+ Bravery to prevent instant lethal HP finishes."
  },
  {
    category: "BRV Locking & Freezing",
    icon: "❄️",
    summons: "Carbuncle, Magic Pot, Cactuar, Tonberry",
