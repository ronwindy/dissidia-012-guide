    tactic: "Ideal for neutralizing enemy Break Bonuses or preserving your own high Bravery pool."
  },
  {
    category: "BRV Swapping & Cloning",
    icon: "🔄",
    summons: "Alexander, Titan, Ifrit, Phoenix, Chocobo",
