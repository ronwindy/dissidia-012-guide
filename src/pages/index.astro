---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/common/Icon.astro";
import { gameInfo, getPortals } from "../data/homeData";

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const portals = getPortals(baseUrl);
---

<BaseLayout title="Dissidia 012 [duodecim] Guide Portal" currentPath="home">
  <!-- Hero Section -->
  <div class="hero-panel">
    <div class="hero-brand">
      <img
        src={`${baseUrl}logo.png`}
        alt="Dissidia 012 [duodecim] Final Fantasy Logo"
        class="hero-logo-img"
        width="420"
        height="240"
        loading="eager"
        decoding="async"
      />
    </div>

    <h1
      style="font-family: var(--font-wallpoet, 'Wallpoet', cursive, sans-serif); font-size: clamp(2.2rem, 2.5rem, 3rem); margin-bottom: 0.5rem; line-height: 1.05; letter-spacing: 0.05em; color: #ffffff; text-shadow: 0 0 20px rgba(56, 189, 248, 0.4);"
    >
      DISSIDIA [duodecim] 012 FINAL FANTASY
    </h1>
    <p
      style="font-size: 1.15rem; color: var(--color-brv); font-family: var(--font-subheading); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 1.25rem;"
    >
      Ronwindy's Personal Guide
    </p>
    <p
      style="font-size: 1.02rem; color: var(--text-sub); max-width: 880px; line-height: 1.7; margin-bottom: 1.75rem;"
    >
      This is AI-created for my personal playthrough only. If you are
      accidentally here, please leave 🙏.
    </p>

    <!-- Game Specifications & Credits -->
    <div class="game-specs-grid">
      {
        gameInfo.map((info) => (
          <div class="stat-panel game-spec-card">
            <div>
              <div class="game-spec-header">
                <Icon name={info.icon} size={18} class="game-spec-icon" />
                <span class="game-spec-label">
                  {info.label}
                </span>
              </div>
              <div class="game-spec-value">
                {info.value}
              </div>
            </div>
            <div class="game-spec-sub">
              {info.sub}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Portal Navigation Grid -->
  <h2 style="margin-top: 3rem;">QUICK LINKS</h2>
  <div
    class="card-grid"
    style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem;"
  >
    {
      portals.map((p) => (
        <div class="crystal-panel portal-card">
          <div class="portal-card-top">
            <div class="portal-badge-bar">
              <span class={`badge-pill ${p.badgeClass}`}>{p.badge}</span>
            </div>
            <div class="portal-card-body">
              <div class={`portal-icon-box ${p.badgeClass}`}>
                <Icon name={p.icon} size={22} />
              </div>
              <div class="portal-card-text">
                <h3 class="portal-card-title">{p.title}</h3>
                <p class="portal-card-desc">{p.desc}</p>
              </div>
            </div>
          </div>
          <div>
            <a
              href={p.href}
              class="btn-action"
              style="width: 100%; box-sizing: border-box;"
            >
              {p.cta} &rarr;
            </a>
          </div>
        </div>
      ))
    }
  </div>
</BaseLayout>

<style>
  /* Game Specifications & Credits */
  .game-specs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
    border-top: 1px solid var(--border-panel-subtle);
    padding-top: 1.5rem;
  }

  .game-spec-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .game-spec-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
    color: var(--color-brv);
  }

  .game-spec-icon {
    opacity: 0.9;
  }

  .game-spec-label {
    font-size: 0.76rem;
    font-family: var(--font-subheading);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .game-spec-value {
    font-size: 1.12rem;
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--text-main);
    line-height: 1.25;
    margin-bottom: 0.25rem;
  }

  .game-spec-sub {
    font-size: 0.76rem;
    color: var(--text-dim);
    font-family: var(--font-mono);
    line-height: 1.4;
  }
</style>
