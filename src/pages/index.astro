---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Info, Sparkles } from "@lucide/astro";
import { gameInfo } from "../data/homeData";
import { getToc } from "../lib/guideData";
import { navCategoryIcon, navEntryIcon } from "../lib/icons";

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const categories = getToc();
---

<BaseLayout>
  <!-- Hero Section -->
  <header class="hero-brand">
    <h1 class="sr-only">Dissidia 012 [duodecim] Final Fantasy Guide Portal</h1>
    <img
      src={`${baseUrl}logo.png`}
      alt="Dissidia 012 [duodecim] Final Fantasy Logo"
      class="hero-logo-img"
      width="420"
      height="240"
      loading="eager"
      decoding="async"
    />
  </header>

  <!-- Game Specifications & Credits -->
  <section class="crystal-panel" aria-labelledby="specs-heading">
    <div class="panel-header">
      <Info size={24} class="panel-header-icon" aria-hidden="true" />
      <h2 id="specs-heading" class="panel-heading">
        GAME SPECIFICATIONS & CREDITS
      </h2>
    </div>
    <div class="game-specs-showcase">
      <div class="game-box-wrapper">
        <img
          src={`${baseUrl}3d-box.png`}
          alt="Dissidia 012 [duodecim] Final Fantasy 3D Box Art"
          class="game-box-img"
          width="180"
          height="300"
          loading="lazy"
          decoding="async"
        />
      </div>
      <dl class="game-specs-grid">
        {
          gameInfo.map((info) => (
            <div class="stat-panel game-spec-card">
              <dt class="game-spec-header">
                <info.icon size={18} class="game-spec-icon" aria-hidden="true" />
                <span class="game-spec-label">{info.label}</span>
              </dt>
              <dd class="game-spec-value">{info.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Game Introduction -->
  <section class="game-intro-section" aria-labelledby="intro-heading">
    <div class="crystal-panel intro-panel">
      <div class="panel-header">
        <Sparkles size={24} class="panel-header-icon" aria-hidden="true" />
        <h2 id="intro-heading" class="panel-heading">OVERVIEW & PREMISE</h2>
      </div>

      <div class="intro-body">
        <p>
          <strong>Dissidia 012 [duodecim] Final Fantasy</strong> is the critically
          acclaimed 3D arena action-RPG for the PlayStation Portable, serving as both
          a dramatic prequel and a vastly expanded definitive edition of the original
          <em>Dissidia Final Fantasy</em>. Set in a desolate realm locked in an
          eternal war between <strong>Cosmos</strong>, the goddess of harmony,
          and <strong>Chaos</strong>, the god of discord, both deities summon
          legendary champions from across the <em>Final Fantasy</em> multiverse to
          wage endless battle in a tragic cycle of death and rebirth.
        </p>

        <p>
          This installment chronicles the previously untold <strong
            >12th Cycle of the War</strong
          >. A newly summoned vanguard of heroes—led by <strong
            >Lightning</strong
          > (FFXIII), <strong>Vaan</strong> (FFXII), <strong
            >Laguna Loire</strong
          > (FFVIII), <strong>Yuna</strong> (FFX), <strong>Kain Highwind</strong
          > (FFIV), and <strong>Tifa Lockhart</strong> (FFVII)—uncovers the cruel
          truth behind their perpetual conflict. Realizing that victory in this cycle
          is impossible, they embark on a perilous, self-sacrificing quest to halt
          the inexhaustible horde of Manikins, buying precious time and leaving behind
          the crystals that will empower their comrades to finally break the cycle
          in the 13th war.
        </p>

        <p>
          Combat in <em>Dissidia 012</em> elevates the signature Bravery battle system
          to new tactical depths. Warriors exchange swift <strong
            >Bravery Attacks</strong
          > to shatter defenses and siphon combat power, then convert their stored
          Bravery into devastating <strong>HP Attacks</strong>. The flagship <strong
            >Assist System</strong
          > allows combatants to summon allied fighters for offensive aerial combo
          extensions or clutch defensive escapes, while <strong
            >EX Revenge</strong
          > enables fighters to dilute time itself and turn the tides during desperate
          moments.
        </p>

        <p>
          Featuring the remastered classic 13th cycle campaign (<em
            >013: Light to All</em
          >), an expansive post-game open-world adventure (<em
            >000: Confessions of the Creator</em
          >), the challenging Labyrinth dungeon crawler, and an iconic roster of
          over 30 heroes and villains, <em>Dissidia 012</em> stands as the ultimate
          celebration of <em>Final Fantasy</em> heritage and combat.
        </p>
      </div>
    </div>
  </section>

  <!-- Guide Contents -->
  <section class="crystal-panel" aria-labelledby="contents-heading">
    <div class="panel-header">
      <h2 id="contents-heading" class="panel-heading">GUIDE CONTENTS</h2>
    </div>
    <a class="progress-resume" data-progress-resume href={baseUrl} hidden>Continue reading</a>
    {categories.map((cat) => (
      <div class="contents-cat">
        <h3 class="contents-cat-title">
          {(() => { const CatIcon = navCategoryIcon(cat.category); return <CatIcon size={18} aria-hidden="true" />; })()}
          <span>{cat.category}</span>
        </h3>
        <ul class="section-index">
          {cat.entries.map((entry) => {
            const EntryIcon = navEntryIcon(cat.category, entry.title);
            return (
              <li>
                <a href={`${baseUrl}guide/${entry.id}`} data-page-id={entry.id}>
                  <EntryIcon size={18} aria-hidden="true" />
                  <span>{entry.title}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </section>
</BaseLayout>

<style>
  /* Screen Reader Only */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  /* Hero Brand & Typography */
  .hero-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .hero-logo-img {
    max-width: 420px;
    width: 100%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 8px 24px rgba(0, 0, 0, 0.85));
  }

  /* Shared Panel Header */
  .panel-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-panel-subtle);
  }

  .panel-header-icon {
    color: var(--color-brv);
    flex-shrink: 0;
  }

  .panel-heading {
    margin: 0;
    font-size: var(--font-size-h3);
    font-family: var(--font-heading);
    letter-spacing: 0.06em;
    color: var(--text-main);
  }

  /* Game Specifications & Credits Showcase */
  .game-specs-showcase {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .game-box-wrapper {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .game-box-img {
    width: 175px;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 14px 28px rgba(0, 0, 0, 0.75))
      drop-shadow(0 0 16px rgba(56, 189, 248, 0.2));
    transition:
      transform var(--transition-normal, 0.3s ease),
      filter var(--transition-normal, 0.3s ease);
  }

  .game-box-img:hover {
    transform: translateY(-4px) scale(1.03);
    filter: drop-shadow(0 18px 36px rgba(0, 0, 0, 0.85))
      drop-shadow(0 0 24px rgba(56, 189, 248, 0.35));
  }

  .game-specs-grid {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
  }

  .game-spec-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.35rem;
  }

  .game-spec-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-brv);
    margin: 0;
  }

  .game-spec-icon {
    opacity: 0.9;
  }

  .game-spec-label {
    font-size: var(--font-size-xs);
    font-family: var(--font-subheading);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .game-spec-value {
    font-size: var(--font-size-lg);
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--text-main);
    line-height: 1.25;
    margin: 0;
  }

  /* Game Introduction */
  .game-intro-section {
    margin-top: 2.5rem;
  }

  .intro-panel {
    padding: 2rem;
  }

  .intro-body {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .intro-body p {
    margin: 0;
    color: var(--text-sub);
    font-size: var(--font-size-base);
    line-height: 1.75;
  }

  .contents-cat-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1.25rem 0 0.5rem;
    font-size: var(--font-size-lg);
    color: var(--color-brv);
  }

  .section-index {
    list-style: none;
    padding-left: 0.25rem;
    margin: 0;
  }

  .section-index a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
  }

  .progress-resume {
    display: block;
    margin-bottom: 0.75rem;
  }

  .progress-resume[hidden] {
    display: none;
  }

  @media (max-width: 860px) {
    .game-specs-grid {
      width: 100%;
    }

    .game-box-img {
      width: 150px;
    }
  }

  @media (max-width: 640px) {
    .game-specs-showcase {
      flex-direction: column;
      gap: 1.5rem;
    }

    .intro-panel {
      padding: 1.25rem;
    }

    .panel-heading {
      font-size: var(--font-size-lg);
    }
  }
</style>
