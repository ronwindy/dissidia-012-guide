---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/common/Icon.astro";
import { gameInfo, getPortals } from "../data/homeData";

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const portals = getPortals(baseUrl);
---

<BaseLayout title="Dissidia 012 [duodecim] Guide Portal" currentPath="home">
  <!-- Hero Section -->
  <div class="hero-panel">
    <div class="hero-brand">
      <img
        src={`${baseUrl}logo.png`}
        alt="Dissidia 012 [duodecim] Final Fantasy Logo"
        class="hero-logo-img"
        width="420"
        height="240"
        loading="eager"
        decoding="async"
      />
    </div>

    <h1
      style="font-family: var(--font-wallpoet, 'Wallpoet', cursive, sans-serif); font-size: clamp(2.2rem, 2.5rem, 3rem); margin-bottom: 0.5rem; line-height: 1.05; letter-spacing: 0.05em; color: #ffffff; text-shadow: 0 0 20px rgba(56, 189, 248, 0.4);"
    >
      DISSIDIA [duodecim] 012 FINAL FANTASY
    </h1>
    <p
      style="font-size: 1.15rem; color: var(--color-brv); font-family: var(--font-subheading); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 1.25rem;"
    >
      Ronwindy's Personal Guide
    </p>
    <p
      style="font-size: 1.02rem; color: var(--text-sub); max-width: 880px; line-height: 1.7; margin-bottom: 1.75rem;"
    >
      This is AI-created for my personal playthrough only. If you are
      accidentally here, please leave 🙏.
    </p>

    <!-- Game Specifications & Credits -->
    <div
      style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-top: 1.5rem; border-top: 1px solid var(--border-panel-subtle); padding-top: 1.5rem;"
    >
      {
        gameInfo.map((info) => (
          <div
            class="stat-panel"
            style="display: flex; flex-direction: column; justify-content: space-between;"
          >
            <div>
              <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.35rem; color: var(--color-brv);">
                <Icon name={info.icon} size={18} style="opacity: 0.9;" />
                <span style="font-size: 0.76rem; font-family: var(--font-subheading); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted);">
                  {info.label}
                </span>
              </div>
              <div style="font-size: 1.12rem; font-family: var(--font-heading); font-weight: 700; color: var(--text-main); line-height: 1.25; margin-bottom: 0.25rem;">
                {info.value}
              </div>
            </div>
            <div style="font-size: 0.76rem; color: var(--text-dim); font-family: var(--font-mono); line-height: 1.4;">
              {info.sub}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Portal Navigation Grid -->
  <h2 style="margin-top: 3rem;">QUICK LINKS</h2>
  <div
    class="card-grid"
    style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem;"
  >
    {
      portals.map((p) => (
        <div class="crystal-panel portal-card">
          <div class="portal-card-top">
            <div class="portal-badge-bar">
              <span class={`badge-pill ${p.badgeClass}`}>{p.badge}</span>
            </div>
            <div class="portal-card-body">
              <div class={`portal-icon-box ${p.badgeClass}`}>
                <Icon name={p.icon} size={22} />
              </div>
              <div class="portal-card-text">
                <h3 class="portal-card-title">{p.title}</h3>
                <p class="portal-card-desc">{p.desc}</p>
              </div>
            </div>
          </div>
          <div>
            <a
              href={p.href}
              class="btn-action"
              style="width: 100%; box-sizing: border-box;"
            >
              {p.cta} &rarr;
            </a>
          </div>
        </div>
      ))
    }
  </div>

  <!-- Featured Highlights -->
  <h2 style="margin-top: 3.5rem;">Combat Mechanics Quick Look</h2>
  <div
    style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.25rem; margin-top: 1rem;"
  >
    <div class="crystal-panel" style="border-left: 4px solid var(--color-brv);">
      <div
        style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.6rem;"
      >
        <span
          style="color: var(--color-brv); display: flex; align-items: center;"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M14.5 17.5 3 6 3 3 6 3 17.5 14.5"></path><line
              x1="13"
              y1="19"
              x2="19"
              y2="13"></line><line x1="16" y1="16" x2="20" y2="20"></line><line
              x1="19"
              y1="21"
              x2="21"
              y2="19"></line></svg
          >
        </span>
        <h3 style="margin: 0; font-size: 1.2rem; color: var(--color-brv);">
          Bravery & HP Battle System
        </h3>
      </div>
      <p
        style="font-size: 0.92rem; color: var(--text-sub); margin-bottom: 0; line-height: 1.6;"
      >
        Attacks are divided into <strong>Bravery (BRV)</strong> attacks that steal
        the opponent's battle power and <strong>HP attacks</strong> that deal actual
        damage equal to your current Bravery. Reduce opponent Bravery below zero to
        inflict <strong>BREAK</strong> and gain the stage's Bravery Pool bonus.
      </p>
    </div>

    <div
      class="crystal-panel"
      style="border-left: 4px solid var(--color-cosmos);"
    >
      <div
        style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.6rem;"
      >
        <span
          style="color: var(--color-cosmos); display: flex; align-items: center;"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle
              cx="9"
              cy="7"
              r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path
              d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg
          >
        </span>
        <h3 style="margin: 0; font-size: 1.2rem; color: var(--color-cosmos);">
          Assist System & Gauge Management
        </h3>
      </div>
      <p
        style="font-size: 0.92rem; color: var(--text-sub); margin-bottom: 0; line-height: 1.6;"
      >
        Spend 1 Assist Bar to summon a partner for a <strong
          >Bravery Attack</strong
        > or <strong>Assist Change</strong> (dodge out of hitstun), or spend 2 bars
        for an <strong>Assist HP Attack</strong> or <strong
          >Assist Charge</strong
        > to break out of enemy combos and initiate Assist Chases.
      </p>
    </div>

    <div
      class="crystal-panel"
      style="border-left: 4px solid var(--color-chaos);"
    >
      <div
        style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.6rem;"
      >
        <span
          style="color: var(--color-chaos); display: flex; align-items: center;"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"
            ></polygon></svg
          >
        </span>
        <h3 style="margin: 0; font-size: 1.2rem; color: var(--color-chaos);">
          EX Mode & EX Revenge
        </h3>
      </div>
      <p
        style="font-size: 0.92rem; color: var(--text-sub); margin-bottom: 0; line-height: 1.6;"
      >
        Gather EX Cores and Force to max out the EX Gauge. Activate <strong
          >EX Mode</strong
        > (R+Square) for empowered abilities and fatal EX Bursts, or activate <strong
          >EX Revenge</strong
        > while taking damage to freeze time and retaliate with an unblockable combo
        flurry.
      </p>
    </div>
  </div>

  <div style="margin-top: 1.5rem; text-align: center;">
    <a
      href={`${baseUrl}mechanics/`}
      class="btn-action"
      style="padding: 0.75rem 2rem; font-size: 1.1rem; display: inline-flex;"
    >
      Explore Full 9-System Combat Mechanics Guide &rarr;
    </a>
  </div>
</BaseLayout>

<style>
  /* Hero Eyebrow Strategy Guide Emblem */
  .hero-guide-eyebrow {
    position: relative;
    display: inline-flex;
    align-items: center;
    margin-bottom: 1.25rem;
    cursor: default;
    user-select: none;
  }

  .guide-eyebrow-glow {
    position: absolute;
    inset: -2px;
    border-radius: 9999px;
    background: linear-gradient(
      90deg,
      rgba(56, 189, 248, 0.6) 0%,
      rgba(251, 191, 36, 0.45) 50%,
      rgba(168, 85, 247, 0.45) 100%
    );
    filter: blur(12px);
    opacity: 0.55;
    transition:
      opacity 0.35s ease,
      filter 0.35s ease;
    pointer-events: none;
  }

  .hero-guide-eyebrow:hover .guide-eyebrow-glow {
    opacity: 0.9;
    filter: blur(16px);
  }

  .guide-eyebrow-inner {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.42rem 1.25rem 0.42rem 1.05rem;
    background: linear-gradient(
      135deg,
      rgba(14, 23, 44, 0.94) 0%,
      rgba(9, 13, 25, 0.98) 100%
    );
    border: 1px solid rgba(56, 189, 248, 0.45);
    border-radius: 9999px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.22),
      0 6px 20px rgba(0, 0, 0, 0.5),
      0 0 18px rgba(56, 189, 248, 0.2);
    backdrop-filter: blur(10px);
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hero-guide-eyebrow:hover .guide-eyebrow-inner {
    border-color: rgba(56, 189, 248, 0.8);
    transform: translateY(-2px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.35),
      0 8px 26px rgba(0, 0, 0, 0.6),
      0 0 26px rgba(56, 189, 248, 0.4);
  }

  /* Moving light sheen across the capsule */
  .guide-eyebrow-inner::after {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 60%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.2) 50%,
      transparent 100%
    );
    transform: skewX(-25deg);
    animation: badgeLightSweep 5s ease-in-out infinite;
    pointer-events: none;
  }

  /* Shimmering fancy gradient text */
  .guide-eyebrow-text {
    font-family: var(--font-heading, "Rajdhani", sans-serif);
    font-size: clamp(0.92rem, 1.4vw, 1.12rem);
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    background: linear-gradient(
      115deg,
      #f8fafc 0%,
      #38bdf8 25%,
      #ffffff 50%,
      #fbbf24 75%,
      #38bdf8 100%
    );
    background-size: 250% 100%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: crystalShimmer 4.5s ease-in-out infinite;
    filter: drop-shadow(0 0 10px rgba(56, 189, 248, 0.45));
    line-height: 1.2;
  }

  .hero-guide-eyebrow:hover .guide-eyebrow-text {
    filter: drop-shadow(0 0 14px rgba(56, 189, 248, 0.75))
      drop-shadow(0 0 24px rgba(251, 191, 36, 0.4));
  }

  /* Crystal sparkle icons */
  .guide-crystal-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-brv, #38bdf8);
    filter: drop-shadow(0 0 6px rgba(56, 189, 248, 0.7));
    animation: pulseSparkle 3.5s ease-in-out infinite;
    flex-shrink: 0;
  }

  .spark-trailing {
    animation-delay: 1.75s;
    opacity: 0.75;
  }

  @keyframes crystalShimmer {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  @keyframes pulseSparkle {
    0%,
    100% {
      transform: scale(0.95) rotate(0deg);
      opacity: 0.85;
      color: var(--color-brv, #38bdf8);
      filter: drop-shadow(0 0 5px rgba(56, 189, 248, 0.7));
    }
    50% {
      transform: scale(1.2) rotate(90deg);
      opacity: 1;
      color: var(--color-cosmos, #fbbf24);
      filter: drop-shadow(0 0 10px rgba(251, 191, 36, 0.85));
    }
  }

  @keyframes badgeLightSweep {
    0%,
    40% {
      left: -100%;
    }
    70%,
    100% {
      left: 200%;
    }
  }

  @media (max-width: 640px) {
    .guide-eyebrow-inner {
      padding: 0.35rem 0.95rem 0.35rem 0.8rem;
      gap: 0.5rem;
    }
    .guide-eyebrow-text {
      font-size: 0.85rem;
      letter-spacing: 0.12em;
    }
    .spark-trailing {
      display: none;
    }
  }
</style>
