---
import BaseLayout from "../layouts/BaseLayout.astro";
import AlertCallout from "../components/common/AlertCallout.astro";

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const quickStats = [
  {
    label: "Playable Fighters",
    value: "32 + 1",
    desc: "10 New, 11 Cosmos, 11 Chaos, Aerith Assist",
  },
  {
    label: "Battle Arenas",
    value: "19+ Stages",
    desc: "12 Omega hazards, 7 new 012 maps, Battlegen drops",
  },
  {
    label: "Campaign Cycles",
    value: "3 Cycles",
    desc: "012 Treachery, 013 Light, 000 Confessions",
  },
  {
    label: "Archival Reports",
    value: "20 Reports",
    desc: "Lore secrets, battle triggers, PP catalog unlocks",
  },
  {
    label: "Legendary Sets",
    value: "7+ High Sets",
    desc: "Lufenian, Genji, Machine, Honey, Shell & Excalibur II",
  },
];

const portals = [
  {
    title: "Character Database & Movelists",
    badge: "32 Fighters",
    badgeClass: "badge-new",
    desc: "Complete move properties, frame cancels, wall rush triggers, EX Bursts, and assist synergy for all 32 playable heroes and villains.",
    href: `${baseUrl}characters/`,
    cta: "Explore Roster & Moves",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="14.5 17.5 3 6 3 3 6 3 17.5 14.5"/><line x1="13" y1="19" x2="19" y2="13"/><line x1="16" y1="16" x2="20" y2="20"/><line x1="19" y1="21" x2="21" y2="19"/><polyline points="14.5 6.5 18 3 21 3 21 6 17.5 9.5"/><line x1="5" y1="14" x2="9" y2="18"/><line x1="7" y1="17" x2="3" y2="21"/><line x1="3" y1="19" x2="5" y2="21"/></svg>`,
  },
  {
    title: "Combat Mechanics Master Guide",
    badge: "System Deep-Dive",
    badgeClass: "badge-cosmos",
    desc: "Complete breakdown of Bravery & HP formulas, 012 Assist dynamics, EX Revenge time-dilation, collision priorities, frame cancels, and booster builds.",
    href: `${baseUrl}mechanics/`,
    cta: "Master Combat Mechanics",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
  },
  {
    title: "Arena & Stage Master Guide",
    badge: "19+ Arenas",
    badgeClass: "badge-crystal",
    desc: "Complete 3D geometry breakdown, standard vs. Omega hazards, destructible objects, Stage Battlegen drops, and character synergy ratings for all 19 stages.",
    href: `${baseUrl}arenas/`,
    cta: "Explore Battle Arenas",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
  },
  {
    title: "012: Treachery of the Gods",
    badge: "Main Story",
    badgeClass: "badge-cosmos",
    desc: "Full walkthrough for the 12th cycle: Prologue to Chapter 7, Epilogue, all gateway floors, enemy parties, KP conditions, and treasure chests.",
    href: `${baseUrl}story/012-treachery/`,
    cta: "Start 012 Walkthrough",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>`,
  },
  {
    title: "013: Light to All",
    badge: "Classic Cycle",
    badgeClass: "badge-crystal",
    desc: "Full remastered 13th cycle walkthrough covering Chapters 1 through 10, Destiny Odysseys, terms, and final boss showdowns.",
    href: `${baseUrl}story/013-light/`,
    cta: "Start 013 Walkthrough",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>`,
  },
  {
    title: "000: Confessions of the Creator",
    badge: "Post-Game / Open World",
    badgeClass: "badge-chaos",
    desc: "Open-world navigation, Dragon King's Gateway, The Forsaken Lands, Chasm of the Rotting Land, Moogle shops, and Feral Chaos gauntlets.",
    href: `${baseUrl}story/000-creator/`,
    cta: "Explore 000 Gateways",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>`,
  },
  {
    title: "Crafting, Sets & Grinding Hub",
    badge: "Equipment & KP",
    badgeClass: "badge-cosmos",
    desc: "Step-by-step acquisition for Lufenian, Genji, Machine, and Smiting Soul sets. Includes fastest KP, AP, and Megalixer farming tricks.",
    href: `${baseUrl}crafting/`,
    cta: "View Crafting & Farming",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 12L2 9z"/><path d="M11 3 8 9l4 12 4-12-3-6"/><path d="M2 9h20"/></svg>`,
  },
  {
    title: "20 Reports & Secret Unlocks",
    badge: "Lore & Characters",
    badgeClass: "badge-crystal",
    desc: "Full archival logs with highlightable battle triggers. Unlock Prishe, Gilgamesh, and Feral Chaos in the PP Catalog.",
    href: `${baseUrl}reports/`,
    cta: "Unlock Secret Reports",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>`,
  },
  {
    title: "Custom Quests & Friend Cards",
    badge: "Community",
    badgeClass: "badge-new",
    desc: "Community quest storylines (Frustra Amare, World At War) and high-yield Friend Cards for farming rare drops and Rosetta Stones.",
    href: `${baseUrl}quests/`,
    cta: "View Quests & Cards",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>`,
  },
  {
    title: "FAQ & Mechanics Glossary",
    badge: "Reference",
    badgeClass: "badge-new",
    desc: "Answers to common mechanics questions, dodge block frame timing, booster accessories, credit roll, and version changelog.",
    href: `${baseUrl}faq/`,
    cta: "View FAQ & System Guide",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`,
  },
];
---

<BaseLayout title="Dissidia 012 [duodecim] Guide Portal" currentPath="home">
  <!-- Hero Section -->
  <div class="hero-panel">
    <div class="hero-brand">
      <img
        src={`${baseUrl}logo.png`}
        alt="Dissidia 012 [duodecim] Final Fantasy Logo"
        class="hero-logo-img"
        width="420"
        height="240"
        loading="eager"
        decoding="async"
      />
    </div>

    <h1
      style="font-family: var(--font-wallpoet, 'Wallpoet', cursive, sans-serif); font-size: clamp(2.2rem, 4.5vw, 3.4rem); margin-bottom: 0.5rem; line-height: 1.05; letter-spacing: 0.05em; color: #ffffff; text-shadow: 0 0 20px rgba(56, 189, 248, 0.4);"
    >
      DISSIDIA 012 [duodecim]
    </h1>
    <p
      style="font-size: 1.15rem; color: var(--color-brv); font-family: var(--font-subheading); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 1.25rem;"
    >
      Complete Walkthrough
    </p>
    <p
      style="font-size: 1.02rem; color: var(--text-sub); max-width: 880px; line-height: 1.7; margin-bottom: 1.75rem;"
    >
      Welcome to the definitive static knowledge base for <em
        >Dissidia 012 [duodecim] Final Fantasy</em
      > on the PlayStation Portable. Built directly from comprehensive community guides
      by Suih / Zahlzeit, this guide provides 100% data fidelity with zero missing
      mechanics: frame cancel data, assist synergy, story gateway floor layouts, secret
      report battle triggers, and advanced crafting recipes.
    </p>

    <!-- Stat Grid -->
    <div
      style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-top: 1.5rem; border-top: 1px solid var(--border-panel-subtle); padding-top: 1.5rem;"
    >
      {
        quickStats.map((stat) => (
          <div class="stat-panel">
            <div style="font-size: 1.65rem; font-family: var(--font-heading); font-weight: 800; color: var(--color-brv); line-height: 1.15;">
              {stat.value}
            </div>
            <div style="font-size: 0.88rem; font-family: var(--font-subheading); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-main); margin-bottom: 0.2rem;">
              {stat.label}
            </div>
            <div style="font-size: 0.76rem; color: var(--text-dim); font-family: var(--font-mono);">
              {stat.desc}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <AlertCallout type="tip" title="HOW TO USE THIS STATIC GUIDE">
    Use the persistent left Command Terminal (or top toggle on mobile) to jump
    between chapters. Check off completed story gateways and unlocked reports
    using the built-in <strong>Progress Trackers</strong>—your progress is
    securely saved in your browser's local storage without requiring any account
    or backend!
  </AlertCallout>

  <!-- Portal Navigation Grid -->
  <h2 style="margin-top: 3rem;">Guide Portals & Core Modules</h2>
  <div
    class="card-grid"
    style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem;"
  >
    {
      portals.map((p) => (
        <div class="crystal-panel portal-card">
          <div class="portal-card-top">
            <div class="portal-badge-bar">
              <span class={`badge-pill ${p.badgeClass}`}>{p.badge}</span>
            </div>
            <div class="portal-card-body">
              <div
                class={`portal-icon-box ${p.badgeClass}`}
                set:html={p.icon}
              />
              <div class="portal-card-text">
                <h3 class="portal-card-title">{p.title}</h3>
                <p class="portal-card-desc">{p.desc}</p>
              </div>
            </div>
          </div>
          <div>
            <a
              href={p.href}
              class="btn-action"
              style="width: 100%; box-sizing: border-box;"
            >
              {p.cta} &rarr;
            </a>
          </div>
        </div>
      ))
    }
  </div>

  <!-- Featured Highlights -->
  <h2 style="margin-top: 3.5rem;">Combat Mechanics Quick Look</h2>
  <div
    style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.25rem; margin-top: 1rem;"
  >
    <div class="crystal-panel" style="border-left: 4px solid var(--color-brv);">
      <div
        style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.6rem;"
      >
        <span
          style="color: var(--color-brv); display: flex; align-items: center;"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M14.5 17.5 3 6 3 3 6 3 17.5 14.5"></path><line
              x1="13"
              y1="19"
              x2="19"
              y2="13"></line><line x1="16" y1="16" x2="20" y2="20"></line><line
              x1="19"
              y1="21"
              x2="21"
              y2="19"></line></svg
          >
        </span>
        <h3 style="margin: 0; font-size: 1.2rem; color: var(--color-brv);">
          Bravery & HP Battle System
        </h3>
      </div>
      <p
        style="font-size: 0.92rem; color: var(--text-sub); margin-bottom: 0; line-height: 1.6;"
      >
        Attacks are divided into <strong>Bravery (BRV)</strong> attacks that steal
        the opponent's battle power and <strong>HP attacks</strong> that deal actual
        damage equal to your current Bravery. Reduce opponent Bravery below zero to
        inflict <strong>BREAK</strong> and gain the stage's Bravery Pool bonus.
      </p>
    </div>

    <div
      class="crystal-panel"
      style="border-left: 4px solid var(--color-cosmos);"
    >
      <div
        style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.6rem;"
      >
        <span
          style="color: var(--color-cosmos); display: flex; align-items: center;"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle
              cx="9"
              cy="7"
              r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path
              d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg
          >
        </span>
        <h3 style="margin: 0; font-size: 1.2rem; color: var(--color-cosmos);">
          Assist System & Gauge Management
        </h3>
      </div>
      <p
        style="font-size: 0.92rem; color: var(--text-sub); margin-bottom: 0; line-height: 1.6;"
      >
        Spend 1 Assist Bar to summon a partner for a <strong
          >Bravery Attack</strong
        > or <strong>Assist Change</strong> (dodge out of hitstun), or spend 2 bars
        for an <strong>Assist HP Attack</strong> or <strong
          >Assist Charge</strong
        > to break out of enemy combos and initiate Assist Chases.
      </p>
    </div>

    <div
      class="crystal-panel"
      style="border-left: 4px solid var(--color-chaos);"
    >
      <div
        style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.6rem;"
      >
        <span
          style="color: var(--color-chaos); display: flex; align-items: center;"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"
            ></polygon></svg
          >
        </span>
        <h3 style="margin: 0; font-size: 1.2rem; color: var(--color-chaos);">
          EX Mode & EX Revenge
        </h3>
      </div>
      <p
        style="font-size: 0.92rem; color: var(--text-sub); margin-bottom: 0; line-height: 1.6;"
      >
        Gather EX Cores and Force to max out the EX Gauge. Activate <strong
          >EX Mode</strong
        > (R+Square) for empowered abilities and fatal EX Bursts, or activate <strong
          >EX Revenge</strong
        > while taking damage to freeze time and retaliate with an unblockable combo
        flurry.
      </p>
    </div>
  </div>

  <div style="margin-top: 1.5rem; text-align: center;">
    <a
      href={`${baseUrl}mechanics/`}
      class="btn-action"
      style="padding: 0.75rem 2rem; font-size: 1.1rem; display: inline-flex;"
    >
      Explore Full 9-System Combat Mechanics Guide &rarr;
    </a>
  </div>
</BaseLayout>

<style>
  /* Hero Eyebrow Strategy Guide Emblem */
  .hero-guide-eyebrow {
    position: relative;
    display: inline-flex;
    align-items: center;
    margin-bottom: 1.25rem;
    cursor: default;
    user-select: none;
  }

  .guide-eyebrow-glow {
    position: absolute;
    inset: -2px;
    border-radius: 9999px;
    background: linear-gradient(
      90deg,
      rgba(56, 189, 248, 0.6) 0%,
      rgba(251, 191, 36, 0.45) 50%,
      rgba(168, 85, 247, 0.45) 100%
    );
    filter: blur(12px);
    opacity: 0.55;
    transition:
      opacity 0.35s ease,
      filter 0.35s ease;
    pointer-events: none;
  }

  .hero-guide-eyebrow:hover .guide-eyebrow-glow {
    opacity: 0.9;
    filter: blur(16px);
  }

  .guide-eyebrow-inner {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.42rem 1.25rem 0.42rem 1.05rem;
    background: linear-gradient(
      135deg,
      rgba(14, 23, 44, 0.94) 0%,
      rgba(9, 13, 25, 0.98) 100%
    );
    border: 1px solid rgba(56, 189, 248, 0.45);
    border-radius: 9999px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.22),
      0 6px 20px rgba(0, 0, 0, 0.5),
      0 0 18px rgba(56, 189, 248, 0.2);
    backdrop-filter: blur(10px);
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hero-guide-eyebrow:hover .guide-eyebrow-inner {
    border-color: rgba(56, 189, 248, 0.8);
    transform: translateY(-2px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.35),
      0 8px 26px rgba(0, 0, 0, 0.6),
      0 0 26px rgba(56, 189, 248, 0.4);
  }

  /* Moving light sheen across the capsule */
  .guide-eyebrow-inner::after {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 60%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.2) 50%,
      transparent 100%
    );
    transform: skewX(-25deg);
    animation: badgeLightSweep 5s ease-in-out infinite;
    pointer-events: none;
  }

  /* Shimmering fancy gradient text */
  .guide-eyebrow-text {
    font-family: var(--font-heading, "Rajdhani", sans-serif);
    font-size: clamp(0.92rem, 1.4vw, 1.12rem);
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    background: linear-gradient(
      115deg,
      #f8fafc 0%,
      #38bdf8 25%,
      #ffffff 50%,
      #fbbf24 75%,
      #38bdf8 100%
    );
    background-size: 250% 100%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: crystalShimmer 4.5s ease-in-out infinite;
    filter: drop-shadow(0 0 10px rgba(56, 189, 248, 0.45));
    line-height: 1.2;
  }

  .hero-guide-eyebrow:hover .guide-eyebrow-text {
    filter: drop-shadow(0 0 14px rgba(56, 189, 248, 0.75))
      drop-shadow(0 0 24px rgba(251, 191, 36, 0.4));
  }

  /* Crystal sparkle icons */
  .guide-crystal-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-brv, #38bdf8);
    filter: drop-shadow(0 0 6px rgba(56, 189, 248, 0.7));
    animation: pulseSparkle 3.5s ease-in-out infinite;
    flex-shrink: 0;
  }

  .spark-trailing {
    animation-delay: 1.75s;
    opacity: 0.75;
  }

  @keyframes crystalShimmer {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  @keyframes pulseSparkle {
    0%,
    100% {
      transform: scale(0.95) rotate(0deg);
      opacity: 0.85;
      color: var(--color-brv, #38bdf8);
      filter: drop-shadow(0 0 5px rgba(56, 189, 248, 0.7));
    }
    50% {
      transform: scale(1.2) rotate(90deg);
      opacity: 1;
      color: var(--color-cosmos, #fbbf24);
      filter: drop-shadow(0 0 10px rgba(251, 191, 36, 0.85));
    }
  }

  @keyframes badgeLightSweep {
    0%,
    40% {
      left: -100%;
    }
    70%,
    100% {
      left: 200%;
    }
  }

  @media (max-width: 640px) {
    .guide-eyebrow-inner {
      padding: 0.35rem 0.95rem 0.35rem 0.8rem;
      gap: 0.5rem;
    }
    .guide-eyebrow-text {
      font-size: 0.85rem;
      letter-spacing: 0.12em;
    }
    .spark-trailing {
      display: none;
    }
  }
</style>
