---
import BaseLayout from '../layouts/BaseLayout.astro';
import AlertCallout from '../components/common/AlertCallout.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const quickStats = [
  { label: "Playable Fighters", value: "32 + 1", desc: "10 New, 11 Cosmos, 11 Chaos, Aerith Assist" },
  { label: "Campaign Cycles", value: "3 Cycles", desc: "012 Treachery, 013 Light, 000 Confessions" },
  { label: "Archival Reports", value: "20 Reports", desc: "Lore secrets, battle triggers, PP catalog unlocks" },
  { label: "Legendary Sets", value: "7+ High Sets", desc: "Lufenian, Genji, Machine, Honey, Shell & Excalibur II" }
];

const portals = [
  {
    title: "Character Database & Movelists",
    badge: "32 Fighters",
    badgeClass: "badge-new",
    desc: "Complete move properties, frame cancels, wall rush triggers, EX Bursts, and assist synergy for all 32 playable heroes and villains.",
    href: `${baseUrl}characters/`,
    cta: "Explore Roster & Moves",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="14.5 17.5 3 6 3 3 6 3 17.5 14.5"/><line x1="13" y1="19" x2="19" y2="13"/><line x1="16" y1="16" x2="20" y2="20"/><line x1="19" y1="21" x2="21" y2="19"/><polyline points="14.5 6.5 18 3 21 3 21 6 17.5 9.5"/><line x1="5" y1="14" x2="9" y2="18"/><line x1="7" y1="17" x2="3" y2="21"/><line x1="3" y1="19" x2="5" y2="21"/></svg>`
  },
  {
    title: "012: Treachery of the Gods",
    badge: "Main Story",
    badgeClass: "badge-cosmos",
    desc: "Full walkthrough for the 12th cycle: Prologue to Chapter 7, Epilogue, all gateway floors, enemy parties, KP conditions, and treasure chests.",
    href: `${baseUrl}story/012-treachery/`,
    cta: "Start 012 Walkthrough",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>`
  },
  {
    title: "013: Light to All",
    badge: "Classic Cycle",
    badgeClass: "badge-crystal",
    desc: "Full remastered 13th cycle walkthrough covering Chapters 1 through 10, Destiny Odysseys, terms, and final boss showdowns.",
    href: `${baseUrl}story/013-light/`,
    cta: "Start 013 Walkthrough",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>`
  },
  {
    title: "000: Confessions of the Creator",
    badge: "Post-Game / Open World",
    badgeClass: "badge-chaos",
    desc: "Open-world navigation, Dragon King's Gateway, The Forsaken Lands, Chasm of the Rotting Land, Moogle shops, and Feral Chaos gauntlets.",
    href: `${baseUrl}story/000-creator/`,
    cta: "Explore 000 Gateways",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>`
  },
  {
    title: "Crafting, Sets & Grinding Hub",
    badge: "Equipment & KP",
    badgeClass: "badge-cosmos",
    desc: "Step-by-step acquisition for Lufenian, Genji, Machine, and Smiting Soul sets. Includes fastest KP, AP, and Megalixer farming tricks.",
    href: `${baseUrl}crafting/`,
    cta: "View Crafting & Farming",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 12L2 9z"/><path d="M11 3 8 9l4 12 4-12-3-6"/><path d="M2 9h20"/></svg>`
  },
  {
    title: "20 Reports & Secret Unlocks",
    badge: "Lore & Characters",
    badgeClass: "badge-crystal",
    desc: "Full archival logs with highlightable battle triggers. Unlock Prishe, Gilgamesh, and Feral Chaos in the PP Catalog.",
    href: `${baseUrl}reports/`,
    cta: "Unlock Secret Reports",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>`
  },
  {
    title: "Custom Quests & Friend Cards",
    badge: "Community",
    badgeClass: "badge-new",
    desc: "Community quest storylines (Frustra Amare, World At War) and high-yield Friend Cards for farming rare drops and Rosetta Stones.",
    href: `${baseUrl}quests/`,
    cta: "View Quests & Cards",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>`
  },
  {
    title: "FAQ & Mechanics Glossary",
    badge: "Reference",
    badgeClass: "badge-new",
    desc: "Answers to common mechanics questions, dodge block frame timing, booster accessories, credit roll, and version changelog.",
    href: `${baseUrl}faq/`,
    cta: "View FAQ & System Guide",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`
  }
];
---

<BaseLayout title="Dissidia 012 [duodecim] Guide Portal" currentPath="home">
  <!-- Hero Section -->
  <div class="hero-panel">
    <div style="display: flex; align-items: center; gap: 0.65rem; margin-bottom: 1.25rem; flex-wrap: wrap;">
      <span class="badge-pill badge-cosmos">PSP Ultimate Strategy Guide</span>
      <span class="badge-pill badge-new">Static & Zero-JS Core</span>
      <span class="badge-pill badge-crystal">100% Data Fidelity</span>
    </div>

    <div class="hero-brand">
      <img 
        src={`${baseUrl}logo.png`} 
        alt="Dissidia 012 [duodecim] Final Fantasy Logo" 
        class="hero-logo-img" 
        width="420" 
        height="240"
        loading="eager"
        decoding="async"
      />
    </div>

    <h1 style="font-family: var(--font-display); font-size: clamp(2.2rem, 4.5vw, 3.4rem); margin-bottom: 0.5rem; line-height: 1.05; letter-spacing: 0.05em; color: #ffffff; text-shadow: 0 0 20px rgba(56, 189, 248, 0.4);">
      DISSIDIA 012 [duodecim]
    </h1>
    <p style="font-size: 1.15rem; color: var(--color-brv); font-family: var(--font-subheading); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 1.25rem;">
      FINAL FANTASY &bull; Complete Master Walkthrough, Move Lists & Mechanics Compendium
    </p>
    <p style="font-size: 1.02rem; color: var(--text-sub); max-width: 880px; line-height: 1.7; margin-bottom: 1.75rem;">
      Welcome to the definitive static knowledge base for <em>Dissidia 012 [duodecim] Final Fantasy</em> on the PlayStation Portable. Built directly from comprehensive community guides by Suih / Zahlzeit, this guide provides 100% data fidelity with zero missing mechanics: frame cancel data, assist synergy, story gateway floor layouts, secret report battle triggers, and advanced crafting recipes.
    </p>

    <!-- Stat Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-top: 1.5rem; border-top: 1px solid var(--border-panel-subtle); padding-top: 1.5rem;">
      {quickStats.map(stat => (
        <div class="stat-panel">
          <div style="font-size: 1.65rem; font-family: var(--font-heading); font-weight: 800; color: var(--color-brv); line-height: 1.15;">{stat.value}</div>
          <div style="font-size: 0.88rem; font-family: var(--font-subheading); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-main); margin-bottom: 0.2rem;">{stat.label}</div>
          <div style="font-size: 0.76rem; color: var(--text-dim); font-family: var(--font-mono);">{stat.desc}</div>
        </div>
      ))}
    </div>
  </div>

  <AlertCallout type="tip" title="HOW TO USE THIS STATIC GUIDE">
    Use the persistent left Command Terminal (or top toggle on mobile) to jump between chapters. Check off completed story gateways and unlocked reports using the built-in <strong>Progress Trackers</strong>—your progress is securely saved in your browser's local storage without requiring any account or backend!
  </AlertCallout>

  <!-- Portal Navigation Grid -->
  <h2 style="margin-top: 3rem;">Guide Portals & Core Modules</h2>
  <div class="card-grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem;">
    {portals.map(p => (
      <div class="crystal-panel portal-card">
        <div class="portal-card-top">
          <div class="portal-badge-bar">
            <span class={`badge-pill ${p.badgeClass}`}>{p.badge}</span>
          </div>
          <div class="portal-card-body">
            <div class={`portal-icon-box ${p.badgeClass}`} set:html={p.icon} />
            <div class="portal-card-text">
              <h3 class="portal-card-title">{p.title}</h3>
              <p class="portal-card-desc">
                {p.desc}
              </p>
            </div>
          </div>
        </div>
        <div>
          <a href={p.href} class="btn-action" style="width: 100%; box-sizing: border-box;">
            {p.cta} &rarr;
          </a>
        </div>
      </div>
    ))}
  </div>

  <!-- Featured Highlights -->
  <h2 style="margin-top: 3.5rem;">Combat Mechanics Quick Look</h2>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.25rem; margin-top: 1rem;">
    <div class="crystal-panel" style="border-left: 4px solid var(--color-brv);">
      <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.6rem;">
        <span style="color: var(--color-brv); display: flex; align-items: center;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 17.5 3 6 3 3 6 3 17.5 14.5"/><line x1="13" y1="19" x2="19" y2="13"/><line x1="16" y1="16" x2="20" y2="20"/><line x1="19" y1="21" x2="21" y2="19"/></svg>
        </span>
        <h3 style="margin: 0; font-size: 1.2rem; color: var(--color-brv);">Bravery & HP Battle System</h3>
      </div>
      <p style="font-size: 0.92rem; color: var(--text-sub); margin-bottom: 0; line-height: 1.6;">
        Attacks are divided into <strong>Bravery (BRV)</strong> attacks that steal the opponent's battle power and <strong>HP attacks</strong> that deal actual damage equal to your current Bravery. Reduce opponent Bravery below zero to inflict <strong>BREAK</strong> and gain the stage's Bravery Pool bonus.
      </p>
    </div>

    <div class="crystal-panel" style="border-left: 4px solid var(--color-cosmos);">
      <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.6rem;">
        <span style="color: var(--color-cosmos); display: flex; align-items: center;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </span>
        <h3 style="margin: 0; font-size: 1.2rem; color: var(--color-cosmos);">Assist System & Gauge Management</h3>
      </div>
      <p style="font-size: 0.92rem; color: var(--text-sub); margin-bottom: 0; line-height: 1.6;">
        Spend 1 Assist Bar to summon a partner for a <strong>Bravery Attack</strong> or <strong>Assist Change</strong> (dodge out of hitstun), or spend 2 bars for an <strong>Assist HP Attack</strong> or <strong>Assist Charge</strong> to break out of enemy combos and initiate Assist Chases.
      </p>
    </div>

    <div class="crystal-panel" style="border-left: 4px solid var(--color-chaos);">
      <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.6rem;">
        <span style="color: var(--color-chaos); display: flex; align-items: center;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        </span>
        <h3 style="margin: 0; font-size: 1.2rem; color: var(--color-chaos);">EX Mode & EX Revenge</h3>
      </div>
      <p style="font-size: 0.92rem; color: var(--text-sub); margin-bottom: 0; line-height: 1.6;">
        Gather EX Cores and Force to max out the EX Gauge. Activate <strong>EX Mode</strong> (R+Square) for empowered abilities and fatal EX Bursts, or activate <strong>EX Revenge</strong> while taking damage to freeze time and retaliate with an unblockable combo flurry.
      </p>
    </div>
  </div>
</BaseLayout>
