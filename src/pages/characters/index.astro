---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CharacterCard from '../../components/character/CharacterCard.astro';
import AlertCallout from '../../components/common/AlertCallout.astro';
import { charactersData } from '../../data/charactersData';

const newCount = charactersData.filter(c => c.alignment === 'New' || c.alignment === 'Assist').length;
const cosmosCount = charactersData.filter(c => c.alignment === 'Cosmos').length;
const chaosCount = charactersData.filter(c => c.alignment === 'Chaos').length;
const assistCount = charactersData.filter(c => c.alignment === 'Assist').length;
const totalCount = charactersData.length;
---

<BaseLayout title="Character Roster Database" currentPath="roster">
  <!-- Page Hero Header -->
  <div class="roster-hero-header">
    <div class="roster-badge-row">
      <span class="badge-pill badge-new">31 Playable Fighters + 1 Assist</span>
      <span class="badge-pill badge-cosmos">Full Frame Data & Strategy</span>
      <span class="badge-pill badge-crystal">100% Fidelity</span>
    </div>
    <h1 class="roster-title">CHARACTER ROSTER DATABASE</h1>
    <p class="roster-subtitle">
      Explore complete movesets, EX Bursts, frame properties, assist synergies, and combat strategies for the entire Dissidia 012 [duodecim] roster.
    </p>
  </div>

  <!-- Interactive Search & Filter Controls -->
  <div class="crystal-panel controls-card">
    <!-- Live Search Input -->
    <div class="search-box-wrapper">
      <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input 
        type="text" 
        id="characterSearchInput" 
        class="search-input" 
        placeholder="Search character by name, origin game (e.g. FF VII, FF XIII), or playstyle..." 
        autocomplete="off"
        aria-label="Search characters"
      />
      <button type="button" id="clearSearchBtn" class="clear-search-btn" aria-label="Clear search" style="display: none;">
        &times;
      </button>
    </div>

    <!-- Faction Filter Bar -->
    <div class="filter-btn-group">
      <span class="filter-label">Faction:</span>
      <button class="filter-btn active" data-filter="all">All ({totalCount})</button>
      <button class="filter-btn" data-filter="New">012 New ({charactersData.filter(c => c.alignment === 'New').length})</button>
      <button class="filter-btn" data-filter="Cosmos">Cosmos ({cosmosCount})</button>
      <button class="filter-btn" data-filter="Chaos">Chaos ({chaosCount})</button>
      <button class="filter-btn" data-filter="Assist">Assist ({assistCount})</button>
    </div>
  </div>

  <!-- Search Results Counter & Status -->
  <div id="resultsCountBar" class="results-count-bar">
    Showing <strong id="visibleCount">{totalCount}</strong> of {totalCount} fighters
  </div>

  <!-- Empty Search Results State -->
  <div id="emptyResultsState" class="crystal-panel empty-state" style="display: none;">
    <div class="empty-icon">🔍</div>
    <h3>No Fighters Found</h3>
    <p>No roster characters matched your search query. Try adjusting your search keywords or resetting the faction filter.</p>
    <button type="button" id="resetFiltersBtn" class="btn-action" style="margin-top: 1rem;">
      Reset Filters
    </button>
  </div>

  <!-- Character Card Grid -->
  <div class="card-grid character-roster-grid" id="characterGrid">
    {charactersData.map(c => (
      <div 
        class="character-item" 
        data-alignment={c.alignment}
        data-name={c.name.toLowerCase()}
        data-origin={c.origin.toLowerCase()}
        data-origin-short={c.originShort.toLowerCase()}
        data-type={c.type.toLowerCase()}
        data-title={c.title.toLowerCase()}
      >
        <CharacterCard {...c} />
      </div>
    ))}
  </div>

  <!-- Assist Synergy Strategic Advice -->
  <AlertCallout type="tip" title="ASSIST PAIRING SYSTEM">
    Looking to build the optimal team? Characters like <strong>Terra</strong> (Graviga unblockable pressure), <strong>Jecht</strong> (HP combo link crutch), and <strong>Aerith</strong> (Seal Evil stasis + BRV Cure) offer the highest universal assist synergy across the entire cast.
  </AlertCallout>

  <style>
    .roster-hero-header {
      margin-bottom: 2rem;
    }

    .roster-badge-row {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      margin-bottom: 0.6rem;
      flex-wrap: wrap;
    }

    .roster-title {
      margin: 0;
      font-size: clamp(2rem, 3.5vw, 2.75rem);
      letter-spacing: 0.05em;
    }

    .roster-subtitle {
      color: var(--text-muted);
      font-size: 1.05rem;
      margin-top: 0.5rem;
      max-width: 860px;
      line-height: 1.6;
    }

    /* Controls Card */
    .controls-card {
      padding: 1.25rem 1.35rem;
      margin-bottom: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    /* Search Box */
    .search-box-wrapper {
      position: relative;
      display: flex;
      align-items: center;
      width: 100%;
    }

    .search-icon {
      position: absolute;
      left: 1rem;
      color: var(--text-dim);
      pointer-events: none;
    }

    .search-input {
      width: 100%;
      min-height: 48px;
      padding: 0.65rem 2.85rem 0.65rem 2.85rem;
      background: var(--surface-panel-alt);
      border: 1px solid var(--border-panel);
      border-radius: var(--radius-sm);
      color: var(--text-main);
      font-family: var(--font-body);
      font-size: 0.98rem;
      transition: all var(--transition-fast);
    }

    .search-input:focus {
      outline: none;
      border-color: var(--color-brv);
      box-shadow: 0 0 16px rgba(56, 189, 248, 0.25);
      background: var(--surface-panel-hover);
    }

    .search-input::placeholder {
      color: var(--text-dim);
      font-size: 0.92rem;
    }

    .clear-search-btn {
      position: absolute;
      right: 0.85rem;
      background: transparent;
      border: none;
      color: var(--text-dim);
      font-size: 1.5rem;
      cursor: pointer;
      padding: 0.25rem 0.5rem;
      line-height: 1;
      border-radius: var(--radius-xs);
      min-width: 36px;
      min-height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .clear-search-btn:hover {
      color: var(--text-main);
    }

    /* Filter Buttons */
    .filter-btn-group {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      align-items: center;
    }

    .filter-label {
      font-size: 0.8rem;
      font-family: var(--font-mono);
      color: var(--text-dim);
      text-transform: uppercase;
      margin-right: 0.25rem;
      letter-spacing: 0.08em;
    }

    .filter-btn {
      background: var(--surface-panel-alt);
      border: 1px solid var(--border-panel-subtle);
      border-radius: var(--radius-sm);
      color: var(--text-muted);
      font-family: var(--font-subheading);
      font-size: 0.95rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      padding: 0.4rem 0.95rem;
      cursor: pointer;
      min-height: 44px;
      transition: all var(--transition-fast);
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }

    .filter-btn:hover {
      color: var(--text-main);
      border-color: var(--color-brv);
      background: var(--surface-panel-hover);
    }

    .filter-btn.active {
      background: var(--color-brv);
      color: var(--text-inverse);
      border-color: var(--color-brv);
      box-shadow: 0 0 14px rgba(56, 189, 248, 0.4);
    }

    /* Results Count Bar */
    .results-count-bar {
      font-size: 0.88rem;
      color: var(--text-dim);
      margin-bottom: 1.25rem;
      font-family: var(--font-mono);
      padding: 0 0.25rem;
    }

    .results-count-bar strong {
      color: var(--color-brv);
    }

    /* Grid */
    .character-roster-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
      gap: 1.5rem;
      margin-bottom: 2.5rem;
    }

    .character-item {
      display: flex;
      flex-direction: column;
    }

    /* Empty State */
    .empty-state {
      text-align: center;
      padding: 3rem 1.5rem;
      margin-bottom: 2.5rem;
    }

    .empty-icon {
      font-size: 2.5rem;
      margin-bottom: 0.75rem;
    }

    .empty-state h3 {
      font-size: 1.35rem;
      margin-bottom: 0.5rem;
    }

    .empty-state p {
      color: var(--text-muted);
      max-width: 500px;
      margin: 0 auto;
    }

    @media (max-width: 640px) {
      .character-roster-grid {
        grid-template-columns: 1fr;
        gap: 1.25rem;
      }
    }
  </style>

  <script is:inline>
    if (typeof document !== "undefined") {
      const searchInput = document.getElementById("characterSearchInput");
      const clearSearchBtn = document.getElementById("clearSearchBtn");
      const filterBtns = document.querySelectorAll(".filter-btn");
      const items = document.querySelectorAll(".character-item");
      const visibleCountEl = document.getElementById("visibleCount");
      const emptyStateEl = document.getElementById("emptyResultsState");
      const resetFiltersBtn = document.getElementById("resetFiltersBtn");

      let currentFilter = "all";
      let currentQuery = "";

      function filterCards() {
        let visibleCount = 0;

        items.forEach(item => {
          const alignment = item.getAttribute("data-alignment") || "";
          const name = item.getAttribute("data-name") || "";
          const origin = item.getAttribute("data-origin") || "";
          const originShort = item.getAttribute("data-origin-short") || "";
          const type = item.getAttribute("data-type") || "";
          const title = item.getAttribute("data-title") || "";

          // Alignment Filter Check
          const matchesFilter = (currentFilter === "all") || (alignment === currentFilter);

          // Search Query Check
          const query = currentQuery.trim().toLowerCase();
          const matchesSearch = !query || 
            name.includes(query) || 
            origin.includes(query) || 
            originShort.includes(query) || 
            type.includes(query) ||
            title.includes(query);

          if (matchesFilter && matchesSearch) {
            item.style.display = "flex";
            visibleCount++;
          } else {
            item.style.display = "none";
          }
        });

        if (visibleCountEl) {
          visibleCountEl.textContent = visibleCount.toString();
        }

        if (emptyStateEl) {
          emptyStateEl.style.display = visibleCount === 0 ? "block" : "none";
        }
      }

      // Filter Button Clicks
      filterBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          filterBtns.forEach(b => b.classList.remove("active"));
          btn.classList.add("active");
          currentFilter = btn.getAttribute("data-filter") || "all";
          filterCards();
        });
      });

      // Search Input Events
      if (searchInput) {
        searchInput.addEventListener("input", (e) => {
          currentQuery = e.target.value;
          if (clearSearchBtn) {
            clearSearchBtn.style.display = currentQuery ? "flex" : "none";
          }
          filterCards();
        });
      }

      // Clear Search Button
      if (clearSearchBtn) {
        clearSearchBtn.addEventListener("click", () => {
          if (searchInput) {
            searchInput.value = "";
            searchInput.focus();
          }
          currentQuery = "";
          clearSearchBtn.style.display = "none";
          filterCards();
        });
      }

      // Reset Filters in Empty State
      if (resetFiltersBtn) {
        resetFiltersBtn.addEventListener("click", () => {
          if (searchInput) searchInput.value = "";
          currentQuery = "";
          if (clearSearchBtn) clearSearchBtn.style.display = "none";

          filterBtns.forEach(b => b.classList.remove("active"));
          const allBtn = document.querySelector('.filter-btn[data-filter="all"]');
          if (allBtn) allBtn.classList.add("active");
          currentFilter = "all";

          filterCards();
        });
      }
    }
  </script>
</BaseLayout>
