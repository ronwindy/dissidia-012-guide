---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import project from '../../../project.config.json';
import Board from '../../components/guide/Board.astro';
import EnemyCard from '../../components/guide/EnemyCard.astro';
import Figure from '../../components/guide/Figure.astro';
import CharacterIntro from '../../components/guide/CharacterIntro.astro';
import Callout from '../../components/guide/Callout.astro';
import { getPages, getPageToc, getNeighbours } from '../../lib/guideData';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('guide');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const pages = await getPages();
const page = pages.find((p) => p.id === entry.id)!;
const { prev, next } = await getNeighbours(entry.id);
const { Content } = await render(entry);
const toc = await getPageToc(entry);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (id: string) => `${baseUrl}/guide/${id}`;
---

<BaseLayout
  title={`${page.title} - ${project.pageTitleSuffix}`}
  description={`${project.pageDescriptionPrefix} - ${page.category}: ${page.title}`}
  currentId={page.id}
  toc={toc}
>
  <article>
    <p class="breadcrumb">
      <a href={`${baseUrl}/`}>Contents</a> / {page.category}
    </p>
    <div class="guide-body">
      <Content components={{ Board, EnemyCard, Figure, CharacterIntro, Callout }} />
    </div>

    <div class="page-actions">
      <button type="button" class="mark-read" data-mark-read={page.id} aria-pressed="false">Mark as read</button>
    </div>

    <nav class="page-nav" aria-label="Previous and next">
      {prev ? <a href={href(prev.id)}>&larr; {prev.title}</a> : <span></span>}
      {next ? <a href={href(next.id)}>{next.title} &rarr;</a> : <span></span>}
    </nav>
  </article>
</BaseLayout>
