---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import project from '../../../project.config.json';
import Board from '../../components/guide/Board.astro';
import EnemyCard from '../../components/guide/EnemyCard.astro';
import Figure from '../../components/guide/Figure.astro';
import CharacterIntro from '../../components/guide/CharacterIntro.astro';
import Callout from '../../components/guide/Callout.astro';
import Gateway from '../../components/guide/Gateway.astro';
import BossFight from '../../components/guide/BossFight.astro';
import PanelSection from '../../components/guide/PanelSection.astro';
import GuideContents from '../../components/guide/GuideContents.astro';
import { getPages, getPageSections, getPageToc, getNeighbours, CONTENTS_ID } from '../../lib/guideData';

export async function getStaticPaths() {
  const pages = await getPages();
  return pages.map((page) => ({ params: { id: page.id } }));
}

const { id } = Astro.params;
const pages = await getPages();
const page = pages.find((p) => p.id === id)!;
const { prev, next } = await getNeighbours(page.id);
const sections = await Promise.all((await getPageSections(page.id)).map((s) => render(s)));
const toc = getPageToc(sections.flatMap((s) => s.headings));
const components = { Board, EnemyCard, Figure, CharacterIntro, Callout, Gateway, PanelSection, BossFight, GuideContents };
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (id: string) => `${baseUrl}/guide/${id}`;
---

<BaseLayout
  title={`${page.title} - ${project.pageTitleSuffix}`}
  description={`${project.pageDescriptionPrefix} - ${page.category}: ${page.title}`}
  currentId={page.id}
  toc={toc}
>
  <article>
    <p class="breadcrumb">
      <a href={href(CONTENTS_ID)}>Contents</a> / {page.category}
    </p>
    <div class="guide-body">
      {sections.map(({ Content }) => <Content components={components} />)}
    </div>

    {page.id !== CONTENTS_ID && (
      <div class="page-actions">
        <button type="button" class="mark-read" data-mark-read={page.id} aria-pressed="false">Mark as read</button>
      </div>
    )}

    <nav class="page-nav" aria-label="Previous and next">
      {prev ? <a href={href(prev.id)}>&larr; {prev.title}</a> : <span></span>}
      {next ? <a href={href(next.id)}>{next.title} &rarr;</a> : <span></span>}
    </nav>
  </article>
</BaseLayout>
