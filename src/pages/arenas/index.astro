---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArenaCard from '../../components/arenas/ArenaCard.astro';
import { arenasData, arenaCategories } from '../../data/arenasData';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

// Quick statistics
const totalArenas = arenasData.length;
const totalOmega = arenasData.filter(a => a.hasOmega).length;
const totalNew012 = arenasData.filter(a => a.type === "012 New Stage").length;
const totalStarters = arenasData.filter(a => a.competitiveData.tier.includes("Starter")).length;
---

<BaseLayout 
  title="Arena & Stage Master Guide" 
  description="Complete strategy guide for all 19+ arenas in Dissidia 012 Final Fantasy. Features standard vs. Omega mechanics, destructible objects, Battlegen components, EX Core routes, and competitive tier lists."
  currentPath="arenas"
>
  <!-- Hero Banner -->
  <div class="hero-panel">
    <div style="display: flex; align-items: center; gap: 0.65rem; margin-bottom: 1.25rem; flex-wrap: wrap;">
      <span class="badge-pill badge-cosmos">Combat Arenas Database</span>
      <span class="badge-pill badge-new">19+ Playable Stages</span>
      <span class="badge-pill badge-crystal">12 Omega (Ω) Variants</span>
      <span class="badge-pill badge-chaos">Stage Battlegen Matrix</span>
    </div>

    <h1 style="font-family: var(--font-display); font-size: clamp(2.2rem, 4.5vw, 3.4rem); margin-bottom: 0.75rem; line-height: 1.1; letter-spacing: 0.05em; color: #ffffff; text-shadow: 0 0 20px rgba(56, 189, 248, 0.4);">
      ARENA & STAGE MASTER GUIDE
    </h1>

    <p style="font-size: 1.05rem; color: var(--text-sub); max-width: 900px; line-height: 1.6; margin-bottom: 1.5rem;">
      Master 3D spatial geometry, destructible environments, grind rails, and environmental hazards across all 19 iconic battlegrounds from <strong style="color: var(--color-brv);">Final Fantasy I through XIII</strong>. Learn how <strong style="color: var(--color-chaos);">Omega (Ω) Mode</strong> mutates Stage Bravery formulas, optimize <strong style="color: var(--color-lufenia);">Stage Battlegen</strong> farming, and leverage stage synergy for every character.
    </p>

    <!-- Quick Stats Cards -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-num">{totalArenas}</div>
        <div class="stat-label">Total Battlegrounds</div>
        <div class="stat-desc">FFI to FFXIII + Original Realms</div>
      </div>
      <div class="stat-card">
        <div class="stat-num" style="color: var(--color-chaos);">{totalOmega}</div>
        <div class="stat-label">Omega (Ω) Hazards</div>
        <div class="stat-desc">Stage Bravery mutation modes</div>
      </div>
      <div class="stat-card">
        <div class="stat-num" style="color: var(--color-assist);">{totalNew012}</div>
        <div class="stat-label">012 New Stages</div>
        <div class="stat-desc">Bahamut, Cradle, Train & more</div>
      </div>
      <div class="stat-card">
        <div class="stat-num" style="color: var(--color-cosmos);">{totalStarters}</div>
        <div class="stat-label">Tournament Starters</div>
        <div class="stat-desc">Standard legal competitive maps</div>
      </div>
    </div>
  </div>

  <!-- Stage System Architecture Guide -->
  <section class="hud-panel" style="margin-bottom: 2rem; padding: 1.75rem;">
    <h2 class="section-title">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
      </svg>
      Core Stage Mechanics & Spatial Tactics
    </h2>

    <div class="system-rules-grid">
      <div class="system-rule-card">
        <div class="rule-header">
          <span class="rule-icon" style="color: var(--color-brv);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </span>
          <h4>Standard vs. Omega (Ω) Mode</h4>
        </div>
        <p>
          In <strong>Standard Mode</strong>, arenas feature stable neutral geometry with predictable Wall Rush angles. In <strong>Omega (Ω) Mode</strong>, environmental anomalies activate: continuous Bravery siphoning (Old Chaos Shrine), floor dissolves (World of Darkness), lethal wall spikes (Pandaemonium), and randomized Stage Bravery (Ultimecia's Castle).
        </p>
      </div>

      <div class="system-rule-card">
        <div class="rule-header">
          <span class="rule-icon" style="color: var(--color-lufenia);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M6 3h12l4 6-10 12L2 9z"></path>
              <path d="M11 3 8 9l4 12 4-12-3-6"></path>
              <path d="M2 9h20"></path>
            </svg>
          </span>
          <h4>Stage Battlegen & Destruction</h4>
        </div>
        <p>
          Specific raw trade components (e.g. <em>Blackcrystal Silver, Demon Soul, Materia, Moon Stone</em>) can only be generated by shattering destructible pillars, severed chandeliers, or executing high-impact Wall Rushes against stage landmarks. Equip <strong>Sunrise (+50% Battlegen)</strong> and max <strong>LUK</strong> to maximize drop frequency.
        </p>
      </div>

      <div class="system-rule-card">
        <div class="rule-header">
          <span class="rule-icon" style="color: var(--color-hp);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
              <line x1="12" y1="9" x2="12" y2="13"></line>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
          </span>
          <h4>Wall Rush Physics & Assist Lock</h4>
        </div>
        <p>
          Striking a wall, floor, or ceiling inflicts extra Bravery damage proportional to initial attack velocity. In narrow corridors like <em>Pandaemonium</em> or <em>Phantom Train</em>, wall density is extreme; calling an Assist character without clear line-of-sight risks <strong>Assist Lock (15s cooldown)</strong> if the ally is struck before departing.
        </p>
      </div>

      <div class="system-rule-card">
        <div class="rule-header">
          <span class="rule-icon" style="color: var(--color-ex-gauge);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          </span>
          <h4>Grind Rails & EX Core Trajectories</h4>
        </div>
        <p>
          Pressing the <strong>Dash button (Triangle / Air Dash)</strong> near glowing grind rails locks your character into high-speed transit. You are immune to ground traps during rail slides and can cancel directly into airborne HP attacks. EX Cores spawn along elevated rail nodes in high-ceiling stages.
        </p>
      </div>
    </div>
  </section>

  <!-- Quick Reference Master Table -->
  <section class="hud-panel" style="margin-bottom: 2.5rem; padding: 1.75rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.75rem;">
      <h2 class="section-title" style="margin-bottom: 0;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="8" y1="6" x2="21" y2="6"></line>
          <line x1="8" y1="12" x2="21" y2="12"></line>
          <line x1="8" y1="18" x2="21" y2="18"></line>
          <line x1="3" y1="6" x2="3.01" y2="6"></line>
          <line x1="3" y1="12" x2="3.01" y2="12"></line>
          <line x1="3" y1="18" x2="3.01" y2="18"></line>
        </svg>
        Master Stage & Battlegen Quick Reference
      </h2>
      <span class="badge-pill badge-crystal">19 Battlegrounds Cataloged</span>
    </div>

    <div class="table-responsive">
      <table class="master-arena-table">
        <thead>
          <tr>
            <th>FF Origin</th>
            <th>Arena Name</th>
            <th>Stage Type</th>
            <th>Competitive Tier</th>
            <th>Battlegen Trade Drop</th>
            <th>Base Rate</th>
            <th>Omega (Ω) Hazard Summary</th>
            <th>Jump</th>
          </tr>
        </thead>
        <tbody>
          {arenasData.map(arena => (
            <tr>
              <td>
                <span class="badge-pill badge-cosmos">{arena.gameNumber}</span>
              </td>
              <td>
                <strong>{arena.name}</strong>
                <div style="font-size: 0.75rem; color: var(--text-dim);">{arena.geometry.size} • {arena.geometry.structure}</div>
              </td>
              <td>
                <span class={`badge-pill ${arena.type === '012 New Stage' ? 'badge-new' : arena.type === 'Boss Arena' ? 'badge-chaos' : 'badge-crystal'}`}>
                  {arena.type}
                </span>
              </td>
              <td>
                <span class={`badge-pill ${arena.competitiveData.tier.includes('Starter') ? 'badge-cosmos' : arena.competitiveData.tier.includes('Counterpick') ? 'badge-crystal' : 'badge-chaos'}`}>
                  {arena.competitiveData.tier}
                </span>
              </td>
              <td>
                <strong style="color: #e9d5ff;">{arena.battlegen.item}</strong>
              </td>
              <td>
                <span style="font-family: var(--font-mono); color: var(--color-brv);">{arena.battlegen.baseRate}</span>
              </td>
              <td>
                {arena.omegaMechanics ? (
                  <span style="font-size: 0.82rem; color: #fca5a5;">
                    <strong>{arena.omegaMechanics.title}:</strong> {arena.omegaMechanics.hazardBehavior}
                  </span>
                ) : (
                  <span style="font-size: 0.8rem; color: var(--text-dim); font-style: italic;">Standard Only (No Ω Hazard)</span>
                )}
              </td>
              <td>
                <a href={`#arena-${arena.id}`} class="btn-table-jump" title={`Jump to ${arena.name} guide`}>
                  View
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Interactive Filter & Search Controls -->
  <section class="hud-panel filter-controls-panel" style="margin-bottom: 2rem; padding: 1.25rem 1.5rem;">
    <div class="filter-top-row">
      <div class="search-box-wrap">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input 
          type="text" 
          id="arenaSearchInput" 
          class="arena-search-input" 
          placeholder="Filter by name, Final Fantasy title, Battlegen drop, or keyword..." 
          aria-label="Search arenas"
        />
      </div>
      <div class="active-count-tag">
        Showing <span id="visibleCount" style="color: var(--color-brv); font-family: var(--font-mono); font-weight: 700;">{arenasData.length}</span> of {arenasData.length} Arenas
      </div>
    </div>

    <!-- Category Tabs -->
    <div class="filter-pills-row" id="filterPillsRow">
      {arenaCategories.map((cat, idx) => (
        <button 
          class={`filter-pill-btn ${idx === 0 ? 'active' : ''}`} 
          data-filter={cat.id}
          aria-pressed={idx === 0 ? "true" : "false"}
        >
          {cat.label}
        </button>
      ))}
    </div>
  </section>

  <!-- Full Arena Cards Catalog -->
  <section class="arena-cards-stream" id="arenaCardsStream">
    {arenasData.map(arena => (
      <ArenaCard arena={arena} />
    ))}
  </section>

  <!-- Empty State Fallback -->
  <div id="noResultsState" class="hud-panel no-results-box" style="display: none;">
    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--text-dim); margin-bottom: 1rem;">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      <line x1="8" y1="11" x2="14" y2="11"></line>
    </svg>
    <h3>No matching arenas found</h3>
    <p>Try clearing your search query or switching category filters.</p>
    <button class="badge-pill badge-cosmos" id="resetFiltersBtn" style="margin-top: 1rem; cursor: pointer; border: none;">
      Reset Filters
    </button>
  </div>
</BaseLayout>

<script is:inline>
  // Client-side instant filtering & search logic with SSR safety
  if (typeof document !== "undefined") {
    const searchInput = document.getElementById("arenaSearchInput");
    const filterButtons = document.querySelectorAll(".filter-pill-btn");
    const arenaCards = document.querySelectorAll(".arena-card");
    const countEl = document.getElementById("visibleCount");
    const noResultsEl = document.getElementById("noResultsState");
    const resetBtn = document.getElementById("resetFiltersBtn");

    let currentFilter = "all";
    let searchQuery = "";

    function filterArenas() {
      let visible = 0;
      const q = searchQuery.toLowerCase().trim();

      arenaCards.forEach(card => {
        const text = card.textContent?.toLowerCase() || "";
        const game = card.getAttribute("data-game") || "";
        const type = card.getAttribute("data-type") || "";
        const tier = card.getAttribute("data-tier") || "";
        const hasOmega = card.getAttribute("data-has-omega") === "true";

        let matchesCat = true;
        if (currentFilter === "classic") matchesCat = type === "Classic Stage";
        else if (currentFilter === "new-012") matchesCat = type === "012 New Stage";
        else if (currentFilter === "boss") matchesCat = type === "Boss Arena";
        else if (currentFilter === "starter") matchesCat = tier.includes("Starter");
        else if (currentFilter === "omega") matchesCat = hasOmega;

        const matchesSearch = q === "" || text.includes(q);

        if (matchesCat && matchesSearch) {
          card.style.display = "block";
          visible++;
        } else {
          card.style.display = "none";
        }
      });

      if (countEl) countEl.textContent = visible.toString();
      if (noResultsEl) {
        noResultsEl.style.display = visible === 0 ? "flex" : "none";
      }
    }

    searchInput?.addEventListener("input", (e) => {
      searchQuery = e.target.value;
      filterArenas();
    });

    filterButtons.forEach(btn => {
      btn.addEventListener("click", () => {
        filterButtons.forEach(b => {
          b.classList.remove("active");
          b.setAttribute("aria-pressed", "false");
        });
        btn.classList.add("active");
        btn.setAttribute("aria-pressed", "true");
        currentFilter = btn.getAttribute("data-filter") || "all";
        filterArenas();
      });
    });

    resetBtn?.addEventListener("click", () => {
      if (searchInput) searchInput.value = "";
      searchQuery = "";
      filterButtons.forEach((b, idx) => {
        if (idx === 0) {
          b.classList.add("active");
          b.setAttribute("aria-pressed", "true");
        } else {
          b.classList.remove("active");
          b.setAttribute("aria-pressed", "false");
        }
      });
      currentFilter = "all";
      filterArenas();
    });
  }
</script>

<style>
  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    color: var(--text-main);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
    letter-spacing: 0.03em;
  }

  /* Stats Grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .stat-card {
    background: var(--surface-panel-alt);
    border: 1px solid var(--border-panel-subtle);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--color-brv);
  }

  .stat-num {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-brv);
    line-height: 1;
    margin-bottom: 0.35rem;
  }

  .stat-label {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text-main);
    margin-bottom: 0.15rem;
  }

  .stat-desc {
    font-size: 0.78rem;
    color: var(--text-dim);
  }

  /* System Rules Grid */
  .system-rules-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .system-rule-card {
    background: var(--surface-panel-alt);
    border: 1px solid var(--border-panel-subtle);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .rule-header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .rule-header h4 {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    color: var(--text-main);
  }

  .system-rule-card p {
    font-size: 0.88rem;
    color: var(--text-sub);
    line-height: 1.5;
  }

  /* Master Arena Table */
  .table-responsive {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--border-panel-subtle);
    border-radius: var(--radius-md);
  }

  .master-arena-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.86rem;
    text-align: left;
    background: var(--surface-panel-alt);
  }

  .master-arena-table th {
    background: var(--surface-hud);
    color: var(--text-dim);
    font-family: var(--font-heading);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border-panel);
    white-space: nowrap;
  }

  .master-arena-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    color: var(--text-sub);
    vertical-align: middle;
  }

  .master-arena-table tr:hover td {
    background: rgba(56, 189, 248, 0.04);
  }

  .btn-table-jump {
    display: inline-block;
    padding: 0.25rem 0.65rem;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid var(--border-panel);
    color: var(--color-brv);
    border-radius: var(--radius-xs);
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 700;
    transition: all var(--transition-fast);
  }

  .btn-table-jump:hover {
    background: var(--color-brv);
    color: #070a13;
  }

  /* Filter Controls */
  .filter-controls-panel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .filter-top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .search-box-wrap {
    position: relative;
    flex: 1;
    min-width: 280px;
  }

  .search-icon {
    position: absolute;
    left: 0.85rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-dim);
    pointer-events: none;
  }

  .arena-search-input {
    width: 100%;
    padding: 0.65rem 0.85rem 0.65rem 2.4rem;
    background: var(--surface-panel-alt);
    border: 1px solid var(--border-panel);
    border-radius: var(--radius-sm);
    color: var(--text-main);
    font-family: var(--font-body);
    font-size: 0.92rem;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .arena-search-input:focus {
    outline: none;
    border-color: var(--color-brv);
    box-shadow: 0 0 10px rgba(56, 189, 248, 0.25);
  }

  .active-count-tag {
    font-size: 0.85rem;
    color: var(--text-dim);
    white-space: nowrap;
  }

  .filter-pills-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-pill-btn {
    padding: 0.4rem 0.85rem;
    background: var(--surface-panel-alt);
    border: 1px solid var(--border-panel-subtle);
    border-radius: var(--radius-full);
    color: var(--text-sub);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-pill-btn:hover {
    border-color: var(--color-brv);
    color: var(--text-main);
  }

  .filter-pill-btn.active {
    background: rgba(56, 189, 248, 0.2);
    border-color: var(--color-brv);
    color: var(--color-brv);
    box-shadow: 0 0 8px rgba(56, 189, 248, 0.3);
  }

  /* No Results Box */
  .no-results-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
    text-align: center;
    color: var(--text-muted);
  }

  .no-results-box h3 {
    color: var(--text-main);
    font-family: var(--font-display);
    margin-bottom: 0.35rem;
  }
</style>
