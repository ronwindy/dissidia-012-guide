---
interface Props {
  /** Visual variant; sets accent color, icon and default label. */
  type?: 'tip' | 'warning' | 'note' | 'info';
  /** Header label; defaults to the type's name. */
  title?: string;
}

const { type = 'note', title } = Astro.props;
const labels = { tip: 'Tip', warning: 'Warning', note: 'Note', info: 'Info' };
const label = title ?? labels[type];
---

<aside class={`callout callout--${type}`}>
  <header class="callout__head">
    <svg class="callout__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      {type === 'tip' && (
        <>
          <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5" />
          <path d="M9 18h6" />
          <path d="M10 22h4" />
        </>
      )}
      {type === 'warning' && (
        <>
          <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
          <path d="M12 9v4" />
          <path d="M12 17h.01" />
        </>
      )}
      {type === 'note' && (
        <>
          <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
          <path d="M14 2v6h6" />
          <path d="M8 13h8" />
          <path d="M8 17h5" />
        </>
      )}
      {type === 'info' && (
        <>
          <circle cx="12" cy="12" r="10" />
          <path d="M12 16v-4" />
          <path d="M12 8h.01" />
        </>
      )}
    </svg>
    <span class="callout__label">{label}</span>
  </header>
  <div class="callout__body"><slot /></div>
</aside>
