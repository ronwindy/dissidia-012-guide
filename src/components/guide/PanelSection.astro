---
import { Link, Users, Skull, Target, Gem, Lightbulb, TriangleAlert } from '@lucide/astro';

interface Props {
  /** Category; sets label and icon. Omit for an unlabeled general section. */
  kind?: 'chain' | 'assist' | 'enemies' | 'objective' | 'treasure' | 'tips' | 'warnings';
  /** Override the default label. */
  title?: string;
}

const { kind, title } = Astro.props;
const labels = {
  chain: 'Chain',
  assist: 'Assist',
  enemies: 'Enemies',
  objective: 'Objective',
  treasure: 'Treasure',
  tips: 'Strategy',
  warnings: 'Watch out',
};
const icons = {
  chain: Link,
  assist: Users,
  enemies: Skull,
  objective: Target,
  treasure: Gem,
  tips: Lightbulb,
  warnings: TriangleAlert,
};
const label = kind ? (title ?? labels[kind]) : title;
const Icon = kind ? icons[kind] : undefined;
---

<div class={`panel-section${kind ? ` panel-section--${kind}` : ''}`}>
  {label && (
    <div class="panel-section__head">
      {Icon && <Icon class="panel-section__icon" stroke-width={2.25} aria-hidden="true" />}
      <span class="panel-section__label">{label}</span>
    </div>
  )}
  <div class="panel-section__body"><slot /></div>
</div>
