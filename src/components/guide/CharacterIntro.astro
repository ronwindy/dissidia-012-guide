---
interface Props {
  /** Character name shown in the panel header. */
  name: string;
  /** Portrait path under public/, e.g. "drake/Laguna012.PNG". */
  src: string;
  width: number;
  height: number;
  /** Alt text; defaults to the image file name without extension. */
  alt?: string;
  /** Header label; defaults to "Playable Character". */
  label?: string;
}

const { name, src, width, height, label = 'Playable Character' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const alt = Astro.props.alt ?? src.replace(/^.*\//, '').replace(/\.[^.]+$/, '');
---

<section class="char-intro">
  <header class="char-intro__head">
    <span class="char-intro__label">{label}</span>
    <span class="char-intro__name">{name}</span>
  </header>
  <div class="char-intro__body">
    <figure class="char-intro__portrait">
      <img src={`${base}/${src}`} alt={alt} width={width} height={height} loading="lazy" />
    </figure>
    <slot />
  </div>
</section>
