---
interface Props {
  id: string;
  label?: string;
  subtext?: string;
}

const { id, label = "Mark Complete", subtext } = Astro.props;
---

<button 
  type="button" 
  class="progress-tracker-btn" 
  data-item-id={id} 
  aria-label={`Toggle completion for ${label}`}
  title="Click to toggle completion status"
>
  <span class="tracker-checkbox">
    <svg class="tracker-check-svg" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="20 6 9 17 4 12"></polyline>
    </svg>
  </span>
  <span class="tracker-content">
    <span class="tracker-label">{label}</span>
    {subtext && <span class="tracker-subtext">{subtext}</span>}
  </span>
  <span class="tracker-status-pill status-incomplete">Incomplete</span>
</button>

<style>
  .progress-tracker-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.4rem 0.75rem;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.015) 100%), rgba(12, 17, 30, 0.7);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.1), 0 2px 8px rgba(0, 0, 0, 0.3);
    border-radius: var(--radius-sm);
    color: var(--text-main);
    cursor: pointer;
    user-select: none;
    transition: all var(--transition-fast);
    text-align: left;
    font-family: inherit;
    max-width: 100%;
    box-sizing: border-box;
  }

  .progress-tracker-btn:hover {
    border-color: rgba(56, 189, 248, 0.45);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%), rgba(18, 25, 44, 0.8);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.2), 0 4px 12px rgba(0, 0, 0, 0.4);
    transform: translateY(-1px);
  }

  .tracker-checkbox {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    border: 1.5px solid rgba(255, 255, 255, 0.25);
    background: rgba(0, 0, 0, 0.35);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all var(--transition-fast);
  }

  .progress-tracker-btn:hover .tracker-checkbox {
    border-color: var(--accent-primary);
  }

  .tracker-check-svg {
    opacity: 0;
    transform: scale(0.6);
    transition: all var(--transition-fast);
    color: #fff;
  }

  .tracker-content {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .tracker-label {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--text-main);
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color var(--transition-fast);
  }

  .tracker-subtext {
    font-size: 0.72rem;
    color: var(--text-dim);
    font-family: var(--font-mono);
  }

  .tracker-status-pill {
    font-size: 0.7rem;
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
    white-space: nowrap;
    flex-shrink: 0;
    margin-left: 0.35rem;
    transition: all var(--transition-fast);
  }

  .tracker-status-pill.status-incomplete {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-dim);
  }

  /* Completed Active State */
  .progress-tracker-btn.completed {
    border-color: rgba(16, 185, 129, 0.45);
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.12) 0%, rgba(12, 17, 30, 0.75) 100%);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.15), 0 0 16px rgba(16, 185, 129, 0.15);
  }

  .progress-tracker-btn.completed .tracker-checkbox {
    background: var(--accent-success);
    border-color: var(--accent-success);
  }

  .progress-tracker-btn.completed .tracker-check-svg {
    opacity: 1;
    transform: scale(1);
  }

  .progress-tracker-btn.completed .tracker-label {
    color: #6ee7b7;
    text-decoration: line-through;
    opacity: 0.85;
  }

  .progress-tracker-btn.completed .tracker-status-pill {
    background: rgba(16, 185, 129, 0.18);
    border: 1px solid rgba(16, 185, 129, 0.4);
    color: #34d399;
  }
</style>

<script is:inline>
  if (typeof document !== "undefined") {
    const STORAGE_KEY = "dissidia-012-guide-progress";

    function getCompleted() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        return raw ? JSON.parse(raw) : [];
      } catch {
        return [];
      }
    }

    function setCompleted(list) {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
        window.dispatchEvent(new Event("storage"));
      } catch (e) {
        console.error("Storage error", e);
      }
    }

    function updateItemUI(btn, isDone) {
      const pill = btn.querySelector(".tracker-status-pill");
      if (isDone) {
        btn.classList.add("completed");
        if (pill) {
          pill.textContent = "Completed ✓";
          pill.classList.remove("status-incomplete");
        }
      } else {
        btn.classList.remove("completed");
        if (pill) {
          pill.textContent = "Incomplete";
          pill.classList.add("status-incomplete");
        }
      }
    }

    // Initialize all items on page
    document.querySelectorAll(".progress-tracker-btn").forEach(btn => {
      const id = btn.getAttribute("data-item-id");
      if (!id) return;

      const completed = getCompleted();
      updateItemUI(btn, completed.includes(id));

      btn.addEventListener("click", () => {
        const current = getCompleted();
        const exists = current.includes(id);
        const next = exists ? current.filter(x => x !== id) : [...current, id];
        setCompleted(next);
        updateItemUI(btn, !exists);
      });
    });
  }
</script>
