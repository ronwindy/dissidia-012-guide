---
interface Props {
  id: string;
  label: string;
  subtext?: string;
}

const { id, label, subtext } = Astro.props;
---

<div class="progress-track-item" data-item-id={id} style="display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-card); border-radius: var(--radius-sm); margin-bottom: 0.5rem; transition: background var(--transition-fast);">
  <div style="display: flex; align-items: center; gap: 0.75rem;">
    <button 
      type="button" 
      class="progress-toggle-btn" 
      data-target-id={id} 
      aria-label={`Toggle completion for ${label}`}
      style="min-width: 44px; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; background: transparent; border: 2px solid var(--border-card); border-radius: 6px; cursor: pointer; color: var(--accent-success); font-size: 1.2rem; transition: all var(--transition-fast);"
    >
      <span class="check-icon" style="opacity: 0;">✓</span>
    </button>
    <div>
      <div class="progress-label" style="font-weight: 600; color: var(--text-main); font-size: 0.95rem;">{label}</div>
      {subtext && <div style="font-size: 0.78rem; color: var(--text-dim);">{subtext}</div>}
    </div>
  </div>
  <span class="status-pill" style="font-size: 0.72rem; font-family: var(--font-mono); color: var(--text-dim); text-transform: uppercase;">Incomplete</span>
</div>

<script is:inline>
  if (typeof document !== "undefined") {
    const STORAGE_KEY = "dissidia-012-guide-progress";

    function getCompleted() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        return raw ? JSON.parse(raw) : [];
      } catch {
        return [];
      }
    }

    function setCompleted(list) {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
        window.dispatchEvent(new Event("storage"));
      } catch (e) {
        console.error("Storage error", e);
      }
    }

    function updateItemUI(container, isDone) {
      const btn = container.querySelector(".progress-toggle-btn");
      const icon = container.querySelector(".check-icon");
      const pill = container.querySelector(".status-pill");
      const label = container.querySelector(".progress-label");

      if (isDone) {
        container.style.borderColor = "rgba(16, 185, 129, 0.4)";
        container.style.background = "rgba(16, 185, 129, 0.08)";
        if (btn) btn.style.borderColor = "var(--accent-success)";
        if (icon) icon.style.opacity = "1";
        if (pill) {
          pill.textContent = "Complete";
          pill.style.color = "var(--accent-success)";
        }
        if (label) label.style.textDecoration = "line-through";
      } else {
        container.style.borderColor = "var(--border-card)";
        container.style.background = "rgba(255, 255, 255, 0.03)";
        if (btn) btn.style.borderColor = "var(--border-card)";
        if (icon) icon.style.opacity = "0";
        if (pill) {
          pill.textContent = "Incomplete";
          pill.style.color = "var(--text-dim)";
        }
        if (label) label.style.textDecoration = "none";
      }
    }

    // Initialize all items on page
    document.querySelectorAll(".progress-track-item").forEach(container => {
      const id = container.getAttribute("data-item-id");
      if (!id) return;

      const completed = getCompleted();
      updateItemUI(container, completed.includes(id));

      const btn = container.querySelector(".progress-toggle-btn");
      btn?.addEventListener("click", () => {
        const current = getCompleted();
        const exists = current.includes(id);
        const next = exists ? current.filter(x => x !== id) : [...current, id];
        setCompleted(next);
        updateItemUI(container, !exists);
      });
    });
  }
</script>
