---
interface Props {
  label?: string;
  total?: number;
  prefix?: string;
  class?: string;
}

const {
  label = "Drake's Guide Progress:",
  total = 27,
  prefix = "drake-ch-",
  class: className = "",
} = Astro.props;
---

<div class={`sidebar-progress ${className}`}>
  <div class="progress-inner">
    <span class="progress-label">{label}</span>
    <span
      id="globalProgressCount"
      class="progress-count"
      data-total={total}
      data-prefix={prefix}
    >
      0 / {total}
    </span>
  </div>
</div>

<style>
  .sidebar-progress {
    padding: 1rem 1.25rem;
    border-top: 1px solid var(--border-panel);
    font-size: 0.78rem;
    color: var(--text-dim);
    background: var(--surface-panel);
  }

  .progress-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .progress-label {
    user-select: none;
  }

  .progress-count {
    color: var(--color-assist);
    font-weight: 700;
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
</style>

<script is:inline>
  if (typeof document !== "undefined") {
    function updateGlobalProgress() {
      try {
        const raw = localStorage.getItem("dissidia-012-guide-progress");
        const countEl = document.getElementById("globalProgressCount");
        if (!countEl) return;

        const total = countEl.getAttribute("data-total") || "27";
        const prefix = countEl.getAttribute("data-prefix") || "drake-ch-";

        if (raw) {
          const list = JSON.parse(raw);
          if (Array.isArray(list)) {
            const drakeDone = list.filter((id) =>
              typeof id === "string" && id.startsWith(prefix)
            ).length;
            countEl.textContent = `${drakeDone} / ${total}`;
          }
        }
      } catch (e) {
        console.warn("Storage sync notice:", e);
      }
    }

    updateGlobalProgress();
    window.addEventListener("storage", updateGlobalProgress);
  }
</script>
