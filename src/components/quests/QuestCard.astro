---
interface Props {
  title: string;
  series?: string;
  part?: string;
  author: string;
  format: string;
  characters: string;
  summary: string;
  slot?: number | string;
  version?: string;
  date?: string;
  authorNote?: string;
  reviewerNote?: string;
  tags?: string[];
}

const {
  title,
  series,
  part,
  author,
  format,
  characters,
  summary,
  slot,
  version = "USA",
  date,
  authorNote,
  reviewerNote,
  tags = []
} = Astro.props;
---

<div class="crystal-panel quest-card" style="margin-bottom: 1.5rem; border-left: 4px solid var(--color-brv);">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem;">
    <div>
      {part && (
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.2rem;">
          <span style="font-size: 0.75rem; font-family: var(--font-mono); color: var(--color-cosmos); text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em;">
            {part}
          </span>
          {series && <span style="font-size: 0.75rem; color: var(--text-dim); font-family: var(--font-mono);">&bull; {series}</span>}
        </div>
      )}
      <h4 style="margin: 0.1rem 0; font-size: 1.28rem; color: var(--text-main); font-family: var(--font-heading); letter-spacing: 0.02em;">{title}</h4>
      <div style="font-size: 0.85rem; color: var(--text-dim); display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.2rem; font-family: var(--font-mono);">
        <span>Created by: <strong style="color: var(--text-sub);">{author}</strong></span>
        {date && <span>&bull; Updated: <code>{date}</code></span>}
      </div>
    </div>
    <div style="display: flex; gap: 0.4rem; font-size: 0.75rem; font-family: var(--font-mono); flex-wrap: wrap;">
      <span class="badge-pill badge-new">{format}</span>
      {slot !== undefined && <span class="badge-pill badge-cosmos">Slot {slot}</span>}
      <span class="badge-pill badge-crystal">{version}</span>
    </div>
  </div>

  <div style="background: var(--surface-panel-alt); padding: 0.85rem 1rem; border-radius: var(--radius-sm); font-size: 0.9rem; margin-bottom: 0.85rem; border: 1px solid var(--border-panel-subtle);">
    <div style="margin-bottom: 0.4rem;">
      <strong style="color: var(--color-brv);">Playable Cast:</strong> 
      <span style="color: var(--text-main);">{characters}</span>
    </div>
    <div style="color: var(--text-muted); font-style: italic; line-height: 1.55;">&ldquo;{summary}&rdquo;</div>
  </div>

  {tags.length > 0 && (
    <div style="display: flex; gap: 0.35rem; flex-wrap: wrap; margin-bottom: 0.6rem;">
      {tags.map(tag => (
        <span style="font-size: 0.72rem; font-family: var(--font-mono); background: var(--surface-panel-alt); color: var(--text-sub); padding: 0.15rem 0.5rem; border-radius: var(--radius-xs); border: 1px solid var(--border-panel-subtle);">
          #{tag}
        </span>
      ))}
    </div>
  )}

  {(authorNote || reviewerNote) && (
    <div style="display: flex; flex-direction: column; gap: 0.45rem; font-size: 0.85rem; border-top: 1px solid var(--border-panel-subtle); padding-top: 0.65rem; color: var(--text-sub);">
      {authorNote && (
        <div style="line-height: 1.5;">
          <strong style="color: #cbd5e1;">Author Note:</strong> {authorNote}
        </div>
      )}
      {reviewerNote && (
        <div style="line-height: 1.5;">
          <strong style="color: var(--color-cosmos);">Suih / Zahlzeit Review:</strong> {reviewerNote}
        </div>
      )}
    </div>
  )}
</div>
