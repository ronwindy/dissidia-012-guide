---
import type { FriendCard } from '../../data/friendCardsData';

interface Props {
  card: FriendCard;
}

const { card } = Astro.props;

const getRankClass = (rank: string) => {
  switch (rank) {
    case 'SSS': return 'badge-cosmos';
    case 'SS': return 'badge-new';
    case 'S': return 'badge-crystal';
    case 'A': return 'badge-brv';
    default: return '';
  }
};
---

<div class="crystal-panel friend-card" style="margin-bottom: 1.75rem; border-left: 4px solid var(--color-cosmos);">
  <!-- Header with Badges -->
  <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1rem; border-bottom: 1px solid var(--border-panel-subtle); padding-bottom: 0.75rem;">
    <div>
      <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
        <h3 style="margin: 0; font-size: 1.45rem; color: var(--text-main); font-family: var(--font-heading);">{card.name}</h3>
        <span style="font-family: var(--font-mono); font-size: 0.92rem; color: var(--color-brv);">
          Ghost: <strong style="color: #fff;">{card.ghost}</strong> (Lv{card.level})
        </span>
      </div>
      {card.author && (
        <div style="font-size: 0.82rem; color: var(--text-dim); margin-top: 0.2rem; font-family: var(--font-mono);">
          Created by: <strong style="color: var(--text-muted);">{card.author}</strong>
        </div>
      )}
    </div>

    <div style="display: flex; gap: 0.4rem; font-size: 0.75rem; font-family: var(--font-mono); flex-wrap: wrap;">
      <span class={`badge-pill ${getRankClass(card.rank)}`}>Rank {card.rank}</span>
      <span class="badge-pill" style="background: var(--surface-panel-alt); border-color: var(--border-panel-subtle); color: var(--text-sub);">
        {card.behavior}
      </span>
      <span class="badge-pill" style={card.rules === 'On' ? "background: rgba(16, 185, 129, 0.15); border-color: rgba(16, 185, 129, 0.4); color: #34d399;" : "background: rgba(239, 68, 68, 0.15); border-color: rgba(239, 68, 68, 0.4); color: #f87171;"}>
        Rules: {card.rules}
      </span>
      <span class="badge-pill badge-crystal">{card.version}</span>
    </div>
  </div>

  <!-- Target Drops Highlight -->
  <div style="background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.3); border-radius: var(--radius-sm); padding: 0.75rem 1rem; margin-bottom: 1rem;">
    <div style="font-size: 0.75rem; font-family: var(--font-mono); text-transform: uppercase; color: var(--color-cosmos); font-weight: 700; margin-bottom: 0.35rem; display: flex; align-items: center; gap: 0.35rem; letter-spacing: 0.05em;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 12L2 9z"/><path d="M11 3 8 9l4 12 4-12-3-6"/><path d="M2 9h20"/></svg>
      Key Farming Targets & Battlegen Drops
    </div>
    <ul style="margin: 0; padding-left: 1.2rem; font-size: 0.9rem; color: #fef08a; line-height: 1.55;">
      {card.targetDrops.map(drop => (
        <li>{drop}</li>
      ))}
    </ul>
  </div>

  <!-- Equipment & Accessories Loadouts -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; margin-bottom: 1rem;">
    <!-- Equipment -->
    <div class="stat-panel">
      <div style="font-size: 0.78rem; font-family: var(--font-subheading); text-transform: uppercase; color: var(--color-brv); font-weight: 700; letter-spacing: 0.06em; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.4rem;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="14.5 17.5 3 6 3 3 6 3 17.5 14.5"/><line x1="13" y1="19" x2="19" y2="13"/><line x1="16" y1="16" x2="20" y2="20"/><line x1="19" y1="21" x2="21" y2="19"/><polyline points="14.5 6.5 18 3 21 3 21 6 17.5 9.5"/></svg>
        Ghost Equipment (4 Pieces)
      </div>
      <div style="display: grid; grid-template-columns: 1fr; gap: 0.35rem;">
        {card.equipment.map((item, idx) => {
          const slots = ["Weapon", "Hand / Shield", "Headgear", "Body Armor"];
          return (
            <div style="display: flex; justify-content: space-between; align-items: center; background: var(--surface-panel); border: 1px solid var(--border-panel-subtle); padding: 0.35rem 0.65rem; border-radius: var(--radius-xs); font-size: 0.85rem;">
              <span style="font-size: 0.72rem; color: var(--text-dim); font-family: var(--font-mono);">{slots[idx]}</span>
              <strong style="color: var(--text-main);">{item}</strong>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Accessories -->
    <div class="stat-panel">
      <div style="font-size: 0.78rem; font-family: var(--font-subheading); text-transform: uppercase; color: var(--color-lufenia); font-weight: 700; letter-spacing: 0.06em; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.4rem;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/></svg>
        Ghost Accessories (10 Slots)
      </div>
      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.35rem;">
        {card.accessories.map((acc, idx) => (
          <div style="background: var(--surface-panel); border: 1px solid var(--border-panel-subtle); padding: 0.3rem 0.55rem; border-radius: var(--radius-xs); font-size: 0.8rem; color: var(--text-sub); display: flex; align-items: center; gap: 0.35rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title={acc}>
            <span style="font-size: 0.68rem; color: var(--text-dim); font-family: var(--font-mono);">{idx + 1}.</span>
            <span style="overflow: hidden; text-overflow: ellipsis;">{acc}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Combat & Battlegen Strategy -->
  <div style="background: var(--surface-panel-alt); border-radius: var(--radius-sm); padding: 0.85rem 1.15rem; font-size: 0.88rem; border: 1px solid var(--border-panel-subtle);">
    <div style="margin-bottom: 0.35rem;">
      <strong style="color: var(--color-brv);">Combat & Battlegen Strategy:</strong> 
      <span style="color: var(--text-sub);">{card.strategy}</span>
    </div>
    {card.authorNote && (
      <div style="margin-top: 0.45rem; padding-top: 0.45rem; border-top: 1px solid rgba(255, 255, 255, 0.06); color: var(--text-dim); font-size: 0.82rem;">
        <strong style="color: #cbd5e1;">Author Note:</strong> {card.authorNote}
      </div>
    )}
    {card.reviewerNote && (
      <div style="margin-top: 0.45rem; padding-top: 0.45rem; border-top: 1px solid rgba(255, 255, 255, 0.06); color: var(--text-dim); font-size: 0.82rem;">
        <strong style="color: var(--color-cosmos);">Suih / Zahlzeit Advice:</strong> {card.reviewerNote}
      </div>
    )}
  </div>
</div>
