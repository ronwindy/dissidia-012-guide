---
import ProgressTracker from '../common/ProgressTracker.astro';

export interface LegendItem {
  key: string;
  name: string;
  type?: 'enemy' | 'boss' | 'chest' | 'assist' | 'summon' | 'emblem' | 'deploy' | 'goal' | 'potion' | 'other';
}

export interface WalkthroughImage {
  src: string;
  alt?: string;
  caption?: string;
}

export interface FloorItem {
  floorNumber: number | string;
  name?: string;
  kpChance?: string;
  rules?: string;
  skills?: string;
  bonusLine?: number | string;
  asciiMap?: string;
  legend?: (string | LegendItem)[];
  enemies?: string[];
  chests?: string[];
  notes?: string;
  images?: WalkthroughImage[];
}

interface Props {
  id: string;
  title: string;
  chapter?: string;
  character?: string;
  isOptional?: boolean;
  kpChance?: string;
  rules?: string;
  skills?: string;
  bonusLine?: number | string;
  asciiMap?: string;
  legend?: (string | LegendItem)[];
  enemies?: string[];
  chests?: string[];
  strategy?: string;
  notes?: string;
  images?: WalkthroughImage[];
  floors?: FloorItem[];
}

const {
  id,
  title,
  chapter,
  character,
  isOptional = false,
  kpChance,
  rules = "Disabled",
  skills = "Enabled",
  bonusLine,
  asciiMap,
  legend = [],
  enemies,
  chests,
  strategy,
  notes,
  images = [],
  floors
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const resolveImg = (src: string) => src.startsWith('http') ? src : `${baseUrl}${src.startsWith('/') ? src.slice(1) : src}`;

// Helper to determine legend token badge styling
function getLegendBadgeClass(keyStr: string): string {
  const k = keyStr.trim().toUpperCase();
  if (k.startsWith('D')) return 'badge-deploy';
  if (k.startsWith('G')) return 'badge-goal';
  if (k.startsWith('B')) return 'badge-boss';
  if (k.startsWith('A')) return 'badge-assist';
  if (k.startsWith('C')) return 'badge-chest';
  if (k.startsWith('S')) return 'badge-summon';
  if (k.startsWith('E')) return 'badge-emblem';
  if (k.startsWith('P') || k.startsWith('R')) return 'badge-potion';
  return 'badge-enemy';
}

function parseLegendItem(item: string | LegendItem): { key: string; text: string; badgeClass: string } {
  if (typeof item === 'object') {
    return {
      key: item.key,
      text: item.name,
      badgeClass: item.type ? `badge-${item.type}` : getLegendBadgeClass(item.key)
    };
  }
  const parts = item.split('=');
  if (parts.length >= 2) {
    const key = parts[0].trim();
    const text = parts.slice(1).join('=').trim();
    return {
      key,
      text,
      badgeClass: getLegendBadgeClass(key)
    };
  }
  return {
    key: '•',
    text: item,
    badgeClass: 'badge-enemy'
  };
}
---

<div class="crystal-panel gateway-map-card guide-section" id={id} style="margin-bottom: 2.5rem; border-top: 3px solid var(--color-lufenia);">
  <!-- Header Bar -->
  <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1rem;">
    <div>
      <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.25rem;">
        {chapter && (
          <span style="font-size: 0.75rem; font-family: var(--font-mono); color: var(--color-cosmos); text-transform: uppercase; font-weight: bold; letter-spacing: 0.05em;">
            {chapter}
          </span>
        )}
        {character && (
          <span class="badge-pill badge-new">
            {character}
          </span>
        )}
        {isOptional && (
          <span class="badge-pill badge-crystal">
            Optional (Blue)
          </span>
        )}
      </div>
      <h3 style="margin: 0.15rem 0 0.4rem; font-size: 1.5rem; color: var(--text-main); font-family: var(--font-heading); letter-spacing: 0.03em;">
        {title}
      </h3>
    </div>
    <div>
      <ProgressTracker id={`gateway-clear-${id}`} label="Cleared" />
    </div>
  </div>

  <!-- Gateway Conditions & Rules Bar -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0.6rem; background: var(--surface-panel-alt); border: 1px solid var(--border-panel-subtle); border-radius: var(--radius-sm); padding: 0.75rem 1rem; margin-bottom: 1.25rem; font-size: 0.85rem; font-family: var(--font-mono);">
    {kpChance && (
      <div>
        <span style="color: var(--text-dim);">KP Chance:</span>{' '}
        <strong style="color: var(--color-cosmos);">{kpChance}</strong>
      </div>
    )}
    <div>
      <span style="color: var(--text-dim);">Rules:</span>{' '}
      <strong style={rules.toLowerCase() === 'enabled' ? 'color: var(--color-assist);' : 'color: var(--text-muted);'}>{rules}</strong>
    </div>
    <div>
      <span style="color: var(--text-dim);">Skills:</span>{' '}
      <strong style={skills.toLowerCase() === 'enabled' ? 'color: var(--color-assist);' : 'color: var(--text-muted);'}>{skills}</strong>
    </div>
    {bonusLine !== undefined && bonusLine !== null && (
      <div>
        <span style="color: var(--text-dim);">Bonus Line:</span>{' '}
        <strong style="color: var(--color-brv);">{bonusLine}</strong>
      </div>
    )}
  </div>

  <!-- Single Floor ASCII Map & Legend -->
  {asciiMap && (
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem; align-items: start;">
      <!-- ASCII Map Grid Container -->
      <div style="background: #040711; border: 1px solid rgba(56, 189, 248, 0.3); border-radius: var(--radius-sm); padding: 1.15rem; box-shadow: inset 0 0 24px rgba(0, 0, 0, 0.8); overflow-x: auto; -webkit-overflow-scrolling: touch;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem; border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 0.35rem;">
          <span style="font-size: 0.72rem; font-family: var(--font-mono); color: var(--color-brv); text-transform: uppercase; font-weight: bold; letter-spacing: 0.06em;">
            &lang; Board Layout Map &rang;
          </span>
          <span style="font-size: 0.7rem; color: var(--text-dim); font-family: var(--font-mono);">
            [D]=Deploy [G]=Goal [B]=Boss
          </span>
        </div>
        <pre class="ascii-grid" style="font-family: 'JetBrains Mono', 'Share Tech Mono', monospace; font-size: 0.92rem; line-height: 1.45; color: #e0f2fe; margin: 0; white-space: pre;">{asciiMap}</pre>
      </div>

      <!-- Legend Breakdown Column -->
      {legend && legend.length > 0 && (
        <div style="background: var(--surface-panel-alt); border: 1px solid var(--border-panel-subtle); border-radius: var(--radius-sm); padding: 1rem;">
          <div style="font-size: 0.75rem; font-family: var(--font-mono); color: var(--color-cosmos); text-transform: uppercase; font-weight: bold; margin-bottom: 0.65rem; letter-spacing: 0.06em;">
            Encounter & Loot Legend
          </div>
          <div style="display: flex; flex-direction: column; gap: 0.4rem;">
            {legend.map(item => {
              const parsed = parseLegendItem(item);
              return (
                <div style="display: flex; align-items: flex-start; gap: 0.5rem; font-size: 0.85rem; line-height: 1.4;">
                  <span class={`map-token-pill ${parsed.badgeClass}`} style="font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; padding: 0.1rem 0.45rem; border-radius: var(--radius-xs); flex-shrink: 0; min-width: 24px; text-align: center;">
                    {parsed.key}
                  </span>
                  <span style="color: var(--text-sub);">{parsed.text}</span>
                </div>
              );
            })}
          </div>
        </div>
      )}
    </div>
  )}

  <!-- Fallback / Multi-Floor List View -->
  {floors && floors.length > 0 && (
    <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.25rem;">
      {floors.map(floor => (
        <div style="background: var(--surface-panel-alt); border: 1px solid var(--border-panel-subtle); border-radius: var(--radius-sm); padding: 1rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-panel-subtle); padding-bottom: 0.45rem; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
            <h4 style="margin: 0; font-size: 1.08rem; color: var(--text-main); font-family: var(--font-heading);">
              Floor {floor.floorNumber} {floor.name ? `— ${floor.name}` : ''}
            </h4>
            <div style="display: flex; gap: 0.65rem; font-size: 0.8rem; font-family: var(--font-mono);">
              {floor.kpChance && (
                <span style="color: var(--color-cosmos);">KP Chance: <strong style="color: #fbbf24;">{floor.kpChance}</strong></span>
              )}
              {floor.bonusLine && (
                <span style="color: var(--text-dim);">Bonus Line: <strong style="color: var(--color-brv);">{floor.bonusLine}</strong></span>
              )}
            </div>
          </div>

          {floor.asciiMap && (
            <div style="background: #040711; border: 1px solid rgba(56, 189, 248, 0.25); border-radius: var(--radius-sm); padding: 0.9rem; margin-bottom: 0.85rem; overflow-x: auto;">
              <pre class="ascii-grid" style="font-family: 'JetBrains Mono', monospace; font-size: 0.88rem; line-height: 1.45; color: #e0f2fe; margin: 0; white-space: pre;">{floor.asciiMap}</pre>
            </div>
          )}

          {floor.legend && floor.legend.length > 0 && (
            <div style="display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 0.75rem;">
              {floor.legend.map(item => {
                const parsed = parseLegendItem(item);
                return (
                  <div style="display: flex; align-items: flex-start; gap: 0.5rem; font-size: 0.84rem;">
                    <span class={`map-token-pill ${parsed.badgeClass}`} style="font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.4rem; border-radius: var(--radius-xs); flex-shrink: 0; min-width: 22px; text-align: center;">
                      {parsed.key}
                    </span>
                    <span style="color: var(--text-sub);">{parsed.text}</span>
                  </div>
                );
              })}
            </div>
          )}

          {floor.enemies && floor.enemies.length > 0 && (
            <div style="margin-bottom: 0.5rem;">
              <div style="font-size: 0.72rem; font-family: var(--font-mono); color: var(--color-chaos); text-transform: uppercase; font-weight: bold; margin-bottom: 0.25rem;">Enemies</div>
              <ul style="margin: 0; padding-left: 1.2rem; font-size: 0.85rem; color: var(--text-sub);">
                {floor.enemies.map(enemy => (
                  <li>{enemy}</li>
                ))}
              </ul>
            </div>
          )}

          {floor.chests && floor.chests.length > 0 && (
            <div style="margin-bottom: 0.5rem;">
              <div style="font-size: 0.72rem; font-family: var(--font-mono); color: var(--color-cosmos); text-transform: uppercase; font-weight: bold; margin-bottom: 0.25rem;">Chests</div>
              <ul style="margin: 0; padding-left: 1.2rem; font-size: 0.85rem; color: #fde68a;">
                {floor.chests.map(chest => (
                  <li>{chest}</li>
                ))}
              </ul>
            </div>
          )}

          {floor.images && floor.images.length > 0 && (
            <div style="margin: 0.85rem 0 0.5rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.75rem;">
              {floor.images.map(img => (
                <div class="walkthrough-image-box" style="background: var(--surface-panel); border: 1px solid var(--border-panel); border-radius: var(--radius-sm); overflow: hidden; display: flex; flex-direction: column;">
                  <div style="position: relative; overflow: hidden; background: #000; display: flex; align-items: center; justify-content: center;">
                    <img 
                      src={resolveImg(img.src)} 
                      alt={img.alt || img.caption || title} 
                      loading="lazy"
                      style="width: 100%; height: auto; display: block; object-fit: contain; max-height: 220px; transition: transform 0.3s ease;"
                      class="walkthrough-preview-img"
                    />
                  </div>
                  {img.caption && (
                    <div style="padding: 0.45rem 0.65rem; background: var(--surface-panel-alt); border-top: 1px solid var(--border-panel-subtle); font-size: 0.8rem; font-family: var(--font-mono); color: var(--color-lufenia); text-align: center;">
                      {img.caption}
                    </div>
                  )}
                </div>
              ))}
            </div>
          )}

          {floor.notes && (
            <div style="font-size: 0.82rem; color: var(--text-dim); border-top: 1px dashed var(--border-panel-subtle); padding-top: 0.5rem; margin-top: 0.5rem;">
              <em>{floor.notes}</em>
            </div>
          )}
        </div>
      ))}
    </div>
  )}

  <!-- Single / Gateway Level Images -->
  {images && images.length > 0 && (
    <div style="margin: 1rem 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem;">
      {images.map(img => (
        <div class="walkthrough-image-box" style="background: var(--surface-panel); border: 1px solid var(--border-panel); border-radius: var(--radius-sm); overflow: hidden; display: flex; flex-direction: column;">
          <div style="position: relative; overflow: hidden; background: #000; display: flex; align-items: center; justify-content: center;">
            <img 
              src={resolveImg(img.src)} 
              alt={img.alt || img.caption || title} 
              loading="lazy"
              style="width: 100%; height: auto; display: block; object-fit: contain; max-height: 280px; transition: transform 0.3s ease;"
              class="walkthrough-preview-img"
            />
          </div>
          {img.caption && (
            <div style="padding: 0.5rem 0.75rem; background: var(--surface-panel-alt); border-top: 1px solid var(--border-panel-subtle); font-size: 0.82rem; font-family: var(--font-mono); color: var(--color-lufenia); text-align: center;">
              {img.caption}
            </div>
          )}
        </div>
      ))}
    </div>
  )}

  <!-- Strategy or Extra Notes -->
  {strategy && (
    <div style="background: var(--surface-panel-alt); border-left: 3px solid var(--color-brv); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; padding: 0.75rem 1rem; font-size: 0.9rem; color: var(--text-sub); margin-top: 0.75rem;">
      <strong style="color: var(--color-brv);">Strategy Tip:</strong> {strategy}
    </div>
  )}

  {notes && (
    <div style="background: var(--surface-panel-alt); border-left: 3px solid var(--color-cosmos); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; padding: 0.75rem 1rem; font-size: 0.9rem; color: var(--text-sub); margin-top: 0.75rem;">
      <strong style="color: var(--color-cosmos);">Note:</strong> {notes}
    </div>
  )}
</div>
