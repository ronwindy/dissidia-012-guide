---
interface NavItem {
  id: string;
  label: string;
  sublabel?: string;
}

interface Props {
  title: string;
  items: NavItem[];
}

const { title, items } = Astro.props;
---

<div class="crystal-panel story-nav-box" style="margin-bottom: 2rem; padding: 1.25rem; border-top: 3px solid var(--color-brv);">
  <div style="font-size: 0.8rem; font-family: var(--font-mono); text-transform: uppercase; color: var(--color-brv); margin-bottom: 0.75rem; font-weight: bold; letter-spacing: 0.06em;">
    {title} &bull; Table of Contents
  </div>
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.6rem;">
    {items.map(item => (
      <a 
        href={`#${item.id}`} 
        class="story-nav-link"
        style="padding: 0.6rem 0.85rem; background: var(--surface-panel-alt); border: 1px solid var(--border-panel-subtle); border-radius: var(--radius-sm); font-size: 0.88rem; color: var(--text-sub); display: block; text-decoration: none; transition: all var(--transition-fast);"
      >
        <div style="font-weight: 700; color: var(--text-main); font-family: var(--font-heading);">{item.label}</div>
        {item.sublabel && <div style="font-size: 0.74rem; color: var(--text-dim); font-family: var(--font-mono); margin-top: 0.15rem;">{item.sublabel}</div>}
      </a>
    ))}
  </div>
</div>

<style>
  .story-nav-link:hover {
    color: var(--color-brv) !important;
    border-color: var(--color-brv) !important;
    background: var(--surface-panel-hover) !important;
    box-shadow: 0 0 10px rgba(56, 189, 248, 0.2);
    transform: translateY(-1px);
  }
</style>
