---
import type { ArenaData } from '../../data/arenasData';

interface Props {
  arena: ArenaData;
}

const { arena } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const tierBadgeClass = arena.competitiveData.tier.includes("Starter")
  ? "badge-cosmos"
  : arena.competitiveData.tier.includes("Counterpick")
  ? "badge-crystal"
  : "badge-chaos";

const typeBadgeClass = arena.type === "012 New Stage"
  ? "badge-new"
  : arena.type === "Boss Arena"
  ? "badge-chaos"
  : "badge-crystal";
---

<article class="arena-card hud-panel" id={`arena-${arena.id}`} data-game={arena.gameSlug} data-type={arena.type} data-tier={arena.competitiveData.tier} data-has-omega={arena.hasOmega ? "true" : "false"}>
  <!-- Card Header Banner -->
  <header class="arena-card-header">
    <div class="arena-title-area">
      <div class="arena-badges-top">
        <span class="badge-pill badge-cosmos">{arena.gameNumber} • {arena.gameOrigin}</span>
        <span class={`badge-pill ${typeBadgeClass}`}>{arena.type}</span>
        <span class={`badge-pill ${tierBadgeClass}`}>{arena.competitiveData.tier}</span>
        {arena.hasOmega && <span class="badge-pill badge-new">Ω Variant Available</span>}
      </div>
      <h3 class="arena-name">{arena.name}</h3>
      <span class="arena-jp-name">{arena.japaneseName}</span>
    </div>
  </header>

  <!-- Arena Body Grid -->
  <div class="arena-body-grid">
    <!-- Visual Thumbnail / Graphic & Geometry HUD -->
    <div class="arena-visual-col">
      <div class="arena-image-container">
        {arena.image ? (
          <img 
            src={`${baseUrl}${arena.image}`} 
            alt={`${arena.name} battle arena`} 
            class="arena-thumb-img" 
            loading="lazy" 
            decoding="async" 
            width="414"
            height="205"
          />
        ) : (
          <div class="arena-placeholder-img">
            <div class="placeholder-icon">
              <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"></polygon>
                <line x1="9" y1="3" x2="9" y2="18"></line>
                <line x1="15" y1="6" x2="15" y2="21"></line>
              </svg>
            </div>
            <span class="placeholder-tag">{arena.name}</span>
            <span class="placeholder-note">{arena.gameOrigin} • 012 Remaster</span>
          </div>
        )}
        <div class="arena-image-overlay">
          <span class="arena-size-badge">{arena.geometry.size} Arena • {arena.geometry.structure}</span>
        </div>
      </div>

      <!-- Geometry Specs Panel -->
      <div class="arena-geo-panel">
        <div class="geo-stat-row">
          <span class="geo-label">Ceiling:</span>
          <span class="geo-val">{arena.geometry.ceilingHeight}</span>
        </div>
        <div class="geo-stat-row">
          <span class="geo-label">Wall Density:</span>
          <span class="geo-val">{arena.geometry.wallDensity}</span>
        </div>
        <div class="geo-stat-row">
          <span class="geo-label">Grind Rails:</span>
          <span class="geo-val-text">{arena.geometry.grindRails}</span>
        </div>
        <div class="geo-stat-row">
          <span class="geo-label">EX Core Spawns:</span>
          <span class="geo-val-text">{arena.geometry.exCoreRoutes}</span>
        </div>
      </div>
    </div>

    <!-- Mechanics & Strategy Column -->
    <div class="arena-details-col">
      <!-- Lore Quote -->
      <p class="arena-lore-text">{arena.lore}</p>

      <!-- Standard Mode Features -->
      <div class="arena-sub-section">
        <h4 class="sub-heading standard-heading">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          Standard Stage Mechanics
        </h4>
        <p class="section-desc">{arena.standardMechanics.description}</p>
        <ul class="feature-bullets">
          {arena.standardMechanics.features.map(f => (
            <li>{f}</li>
          ))}
        </ul>

        {arena.standardMechanics.destructibleObjects.length > 0 && (
          <div class="destructible-tag-list">
            <span class="tag-title">Destructibles:</span>
            {arena.standardMechanics.destructibleObjects.map(obj => (
              <span class="destruct-tag">{obj}</span>
            ))}
          </div>
        )}
      </div>

      <!-- Omega Mode (if available) -->
      {arena.omegaMechanics && (
        <div class="arena-sub-section omega-section">
          <div class="omega-header">
            <h4 class="sub-heading omega-heading">
              <span class="omega-glyph">Ω</span>
              Omega Mode: {arena.omegaMechanics.title}
            </h4>
            <span class="badge-pill badge-chaos">Hazard Active</span>
          </div>
          <p class="section-desc">{arena.omegaMechanics.description}</p>
          <div class="omega-specs-grid">
            <div class="omega-spec-box">
              <span class="spec-label">Stage Bravery Formula:</span>
              <span class="spec-val-code">{arena.omegaMechanics.stageBraveryFormula}</span>
            </div>
            <div class="omega-spec-box">
              <span class="spec-label">Hazard Behavior:</span>
              <span class="spec-val-text">{arena.omegaMechanics.hazardBehavior}</span>
            </div>
          </div>
          <div class="omega-implication">
            <strong>Tactical Impact:</strong> {arena.omegaMechanics.tacticalImplication}
          </div>
        </div>
      )}

      <!-- Stage Battlegen & Rewards -->
      <div class="arena-sub-section battlegen-section">
        <h4 class="sub-heading battlegen-heading">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 3h12l4 6-10 12L2 9z"></path>
            <path d="M11 3 8 9l4 12 4-12-3-6"></path>
            <path d="M2 9h20"></path>
          </svg>
          Stage Battlegen & Destruction Drops
        </h4>
        <div class="battlegen-box">
          <div class="battlegen-top">
            <div class="battlegen-item-name">
              <span class="item-label">Trade Accessory Drop:</span>
              <strong class="item-value">{arena.battlegen.item}</strong>
            </div>
            <span class="badge-pill badge-crystal">Base Rate: {arena.battlegen.baseRate}</span>
          </div>
          <p class="battlegen-desc">{arena.battlegen.description}</p>
          <div class="battlegen-reqs">
            <div><span class="req-label">Drop Trigger:</span> {arena.battlegen.condition}</div>
            <div><span class="req-label">Fastest Farm Tech:</span> {arena.battlegen.bestTechnique}</div>
          </div>
        </div>
      </div>

      <!-- Competitive Ratings & Synergies -->
      <div class="arena-sub-section comp-section">
        <h4 class="sub-heading comp-heading">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="14.5 17.5 3 6 3 3 6 3 17.5 14.5"></polyline>
            <line x1="13" y1="19" x2="19" y2="13"></line>
            <line x1="16" y1="16" x2="20" y2="20"></line>
            <line x1="19" y1="21" x2="21" y2="19"></line>
            <polyline points="14.5 6.5 18 3 21 3 21 6 17.5 9.5"></polyline>
            <line x1="5" y1="14" x2="9" y2="18"></line>
            <line x1="7" y1="17" x2="3" y2="21"></line>
            <line x1="3" y1="19" x2="5" y2="21"></line>
          </svg>
          Competitive Viability & Matchup Synergy
        </h4>

        <!-- Rating meters -->
        <div class="comp-meters-row">
          <div class="meter-col">
            <span class="meter-title">Wall Rush:</span>
            <span class={`meter-badge meter-${arena.competitiveData.wallRushAdvantage.toLowerCase()}`}>
              {arena.competitiveData.wallRushAdvantage}
            </span>
          </div>
          <div class="meter-col">
            <span class="meter-title">Aerial Freedom:</span>
            <span class={`meter-badge meter-${arena.competitiveData.aerialAdvantage.toLowerCase()}`}>
              {arena.competitiveData.aerialAdvantage}
            </span>
          </div>
          <div class="meter-col">
            <span class="meter-title">Projectile Spacing:</span>
            <span class={`meter-badge meter-${arena.competitiveData.projectileAdvantage.toLowerCase()}`}>
              {arena.competitiveData.projectileAdvantage}
            </span>
          </div>
        </div>

        <p class="comp-summary">{arena.competitiveData.summary}</p>

        <!-- Character Synergy Chips -->
        <div class="synergy-list">
          {arena.competitiveData.characterSynergies.map(syn => (
            <div class={`synergy-card syn-${syn.role.toLowerCase()}`}>
              <div class="syn-header">
                <a href={`${baseUrl}characters/${syn.slug}/`} class="syn-char-link">
                  <strong>{syn.name}</strong>
                </a>
                <span class={`syn-role-badge ${syn.role === 'Advantaged' ? 'badge-cosmos' : 'badge-chaos'}`}>
                  {syn.role}
                </span>
              </div>
              <span class="syn-reason">{syn.reason}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Tactical Tips Pro Box -->
      <div class="arena-sub-section tips-section">
        <h4 class="sub-heading tips-heading">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
          </svg>
          Pro Battlefield Directives
        </h4>
        <ul class="tips-bullets">
          {arena.tacticalTips.map(tip => (
            <li>{tip}</li>
          ))}
        </ul>
      </div>

    </div>
  </div>
</article>

<style>
  .arena-card {
    background: var(--surface-panel);
    border: 1px solid var(--border-panel);
    border-radius: var(--radius-lg);
    margin-bottom: 2.25rem;
    overflow: hidden;
    transition: transform var(--transition-normal), border-color var(--transition-normal);
  }

  .arena-card:hover {
    border-color: var(--border-panel-hover);
  }

  /* Header Banner */
  .arena-card-header {
    background: linear-gradient(180deg, var(--surface-panel-alt) 0%, rgba(10, 14, 26, 0.95) 100%);
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border-panel-subtle);
  }

  .arena-badges-top {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .arena-name {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    color: var(--text-main);
    letter-spacing: 0.03em;
    margin-bottom: 0.2rem;
  }

  .arena-jp-name {
    font-size: 0.85rem;
    color: var(--text-dim);
    font-family: var(--font-mono);
  }

  /* Body Grid */
  .arena-body-grid {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 1.5rem;
    padding: 1.5rem;
  }

  @media (max-width: 960px) {
    .arena-body-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Visual Column */
  .arena-visual-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .arena-image-container {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border-panel-subtle);
    background: #000000;
    aspect-ratio: 414 / 205;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
  }

  .arena-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-normal);
  }

  .arena-card:hover .arena-thumb-img {
    transform: scale(1.03);
  }

  .arena-placeholder-img {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle, #18223c 0%, #080c16 100%);
    color: var(--text-muted);
    padding: 1rem;
    text-align: center;
    border: 1px dashed rgba(56, 189, 248, 0.3);
  }

  .placeholder-icon {
    color: var(--color-brv);
    margin-bottom: 0.5rem;
  }

  .placeholder-tag {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--text-main);
  }

  .placeholder-note {
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  .arena-image-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(0deg, rgba(7, 10, 19, 0.9) 0%, transparent 100%);
    padding: 0.6rem 0.8rem;
  }

  .arena-size-badge {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-brv);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .arena-geo-panel {
    background: var(--surface-panel-alt);
    border: 1px solid var(--border-panel-subtle);
    border-radius: var(--radius-md);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .geo-stat-row {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding-bottom: 0.4rem;
  }

  .geo-stat-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .geo-label {
    color: var(--text-dim);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
  }

  .geo-val {
    color: var(--color-brv);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .geo-val-text {
    color: var(--text-sub);
    font-size: 0.82rem;
    line-height: 1.35;
  }

  /* Details Column */
  .arena-details-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .arena-lore-text {
    font-size: 0.92rem;
    font-style: italic;
    color: var(--text-muted);
    border-left: 3px solid var(--color-brv);
    padding-left: 0.85rem;
    line-height: 1.5;
  }

  .arena-sub-section {
    background: rgba(18, 26, 46, 0.4);
    border: 1px solid var(--border-panel-subtle);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
  }

  .sub-heading {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.6rem;
    letter-spacing: 0.03em;
  }

  .standard-heading {
    color: var(--color-brv);
  }

  .section-desc {
    font-size: 0.9rem;
    color: var(--text-sub);
    line-height: 1.5;
    margin-bottom: 0.65rem;
  }

  .feature-bullets, .tips-bullets {
    padding-left: 1.2rem;
    margin-bottom: 0.65rem;
    font-size: 0.88rem;
    color: var(--text-sub);
    line-height: 1.5;
  }

  .feature-bullets li, .tips-bullets li {
    margin-bottom: 0.35rem;
  }

  .destructible-tag-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px dashed rgba(255, 255, 255, 0.08);
  }

  .tag-title {
    font-size: 0.78rem;
    color: var(--text-dim);
    font-weight: 600;
  }

  .destruct-tag {
    font-size: 0.78rem;
    padding: 0.15rem 0.5rem;
    background: rgba(244, 63, 94, 0.15);
    border: 1px solid rgba(244, 63, 94, 0.3);
    color: #fda4af;
    border-radius: var(--radius-xs);
    font-family: var(--font-mono);
  }

  /* Omega Section */
  .omega-section {
    background: rgba(239, 68, 68, 0.06);
    border-color: rgba(239, 68, 68, 0.3);
  }

  .omega-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .omega-heading {
    color: var(--color-chaos);
    margin-bottom: 0;
  }

  .omega-glyph {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin-right: 0.2rem;
  }

  .omega-specs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin: 0.75rem 0;
  }

  @media (max-width: 600px) {
    .omega-specs-grid {
      grid-template-columns: 1fr;
    }
  }

  .omega-spec-box {
    background: rgba(10, 14, 26, 0.7);
    border: 1px solid rgba(239, 68, 68, 0.2);
    border-radius: var(--radius-sm);
    padding: 0.6rem 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .spec-label {
    font-size: 0.72rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .spec-val-code {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-ex-gauge);
  }

  .spec-val-text {
    font-size: 0.82rem;
    color: var(--text-sub);
    line-height: 1.35;
  }

  .omega-implication {
    font-size: 0.85rem;
    color: #fecdd3;
    background: rgba(239, 68, 68, 0.12);
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-xs);
    border-left: 3px solid var(--color-chaos);
  }

  /* Battlegen Section */
  .battlegen-section {
    background: rgba(168, 85, 247, 0.05);
    border-color: rgba(168, 85, 247, 0.25);
  }

  .battlegen-heading {
    color: var(--color-lufenia);
  }

  .battlegen-box {
    background: rgba(10, 14, 26, 0.65);
    border: 1px solid rgba(168, 85, 247, 0.2);
    border-radius: var(--radius-sm);
    padding: 0.85rem;
  }

  .battlegen-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.4rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .battlegen-item-name {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.95rem;
  }

  .item-label {
    color: var(--text-dim);
    font-size: 0.8rem;
  }

  .item-value {
    color: #e9d5ff;
    font-family: var(--font-heading);
    letter-spacing: 0.02em;
  }

  .battlegen-desc {
    font-size: 0.85rem;
    color: var(--text-sub);
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }

  .battlegen-reqs {
    font-size: 0.82rem;
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    border-top: 1px dashed rgba(255, 255, 255, 0.08);
    padding-top: 0.5rem;
  }

  .req-label {
    color: var(--color-lufenia);
    font-weight: 700;
  }

  /* Competitive Section */
  .comp-heading {
    color: var(--color-cosmos);
  }

  .comp-meters-row {
    display: flex;
    gap: 0.85rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .meter-col {
    background: var(--surface-panel-alt);
    border: 1px solid var(--border-panel-subtle);
    padding: 0.4rem 0.65rem;
    border-radius: var(--radius-xs);
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
  }

  .meter-title {
    color: var(--text-dim);
  }

  .meter-badge {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.82rem;
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
  }

  .meter-high {
    background: rgba(16, 185, 129, 0.2);
    color: #6ee7b7;
    border: 1px solid rgba(16, 185, 129, 0.4);
  }

  .meter-medium {
    background: rgba(245, 158, 11, 0.2);
    color: #fcd34d;
    border: 1px solid rgba(245, 158, 11, 0.4);
  }

  .meter-low {
    background: rgba(244, 63, 94, 0.2);
    color: #fda4af;
    border: 1px solid rgba(244, 63, 94, 0.4);
  }

  .comp-summary {
    font-size: 0.88rem;
    color: var(--text-sub);
    line-height: 1.45;
    margin-bottom: 0.75rem;
  }

  .synergy-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.65rem;
  }

  .synergy-card {
    background: rgba(10, 14, 26, 0.75);
    border: 1px solid var(--border-panel-subtle);
    border-radius: var(--radius-sm);
    padding: 0.65rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .syn-advantaged {
    border-left: 3px solid var(--color-cosmos);
  }

  .syn-disadvantaged {
    border-left: 3px solid var(--color-chaos);
  }

  .syn-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .syn-char-link {
    color: var(--text-main);
    text-decoration: none;
    font-size: 0.88rem;
    transition: color var(--transition-fast);
  }

  .syn-char-link:hover {
    color: var(--color-brv);
    text-decoration: underline;
  }

  .syn-role-badge {
    font-size: 0.68rem;
    padding: 0.1rem 0.35rem;
    border-radius: var(--radius-full);
    font-weight: 700;
  }

  .syn-reason {
