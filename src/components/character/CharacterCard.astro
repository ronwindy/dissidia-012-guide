---
interface Props {
  name: string;
  title: string;
  origin: string;
  alignment: 'Cosmos' | 'Chaos' | 'New' | 'Assist';
  type: string;
  href?: string;
  description: string;
}

const { name, title, origin, alignment, type, href, description } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const targetUrl = href ? href : `${baseUrl}characters/${name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}/`;

const badgeClass = 
  alignment === 'Cosmos' ? 'badge-cosmos' :
  alignment === 'Chaos' ? 'badge-chaos' :
  alignment === 'New' ? 'badge-new' : 'badge-crystal';
---

<div class="glass-card character-card" style="display: flex; flex-direction: column; justify-content: space-between; position: relative; overflow: hidden;">
  <div>
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
      <div>
        <span style="font-size: 0.75rem; font-family: var(--font-mono); color: var(--text-dim); text-transform: uppercase;">{origin}</span>
        <h3 style="margin: 0.1rem 0 0.2rem 0; font-size: 1.4rem; color: var(--text-main);">{name}</h3>
        <div style="font-size: 0.85rem; color: var(--accent-primary); font-weight: 500;">{title}</div>
      </div>
      <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.35rem;">
        <span class={`badge-pill ${badgeClass}`}>{alignment}</span>
        <span style="font-size: 0.75rem; font-family: var(--font-mono); color: var(--text-muted);">{type}</span>
      </div>
    </div>

    <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.5; margin-bottom: 1.25rem;">
      {description}
    </p>
  </div>

  <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border-card-subtle); padding-top: 0.85rem; margin-top: 0.5rem;">
    <a href={targetUrl} class="btn-action" style="font-size: 0.85rem; padding: 0.4rem 0.9rem; min-height: 38px;">
      View Moves & Strategy &rarr;
    </a>
  </div>
</div>
