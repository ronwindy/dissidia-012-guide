---
interface Props {
  name: string;
  title: string;
  game: string;
  alignment: 'Cosmos' | 'Chaos' | 'New' | 'Assist';
  style: string;
  exModeName: string;
  exModeEffect: string;
  exBurstName: string;
  exBurstInput: string;
  bestStages?: string[];
  worstStages?: string[];
  assistRole?: string;
  recommendedAssists?: { name: string; reason?: string }[];
}

const {
  name,
  title,
  game,
  alignment,
  style,
  exModeName,
  exModeEffect,
  exBurstName,
  exBurstInput,
  bestStages = [],
  worstStages = [],
  assistRole,
  recommendedAssists = []
} = Astro.props;

const badgeClass = 
  alignment === 'Cosmos' ? 'badge-cosmos' :
  alignment === 'Chaos' ? 'badge-chaos' :
  alignment === 'New' ? 'badge-new' : 'badge-crystal';
---

<div class="glass-card character-header-box" style="margin-bottom: 2rem; border-left: 4px solid var(--accent-primary);">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
    <div>
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
        <span style="font-size: 0.8rem; font-family: var(--font-mono); color: var(--text-dim); text-transform: uppercase;">{game}</span>
        <span class={`badge-pill ${badgeClass}`}>{alignment}</span>
      </div>
      <h1 style="margin: 0; font-size: clamp(2.2rem, 4vw, 3.4rem); line-height: 1.05;">{name}</h1>
      <div style="font-size: 1.1rem; color: var(--accent-primary); font-weight: 600; font-family: var(--font-heading);">{title} &bull; <span style="color: var(--text-muted);">{style}</span></div>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.25rem; margin-top: 1.25rem; border-top: 1px solid var(--border-card-subtle); padding-top: 1.25rem;">
    <!-- EX Mode & Burst -->
    <div style="background: rgba(0,0,0,0.25); padding: 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-card);">
      <div style="font-size: 0.75rem; font-family: var(--font-mono); text-transform: uppercase; color: var(--accent-cosmos); margin-bottom: 0.4rem; font-weight: bold;">EX Mode & Burst</div>
      <div style="font-weight: 700; color: var(--text-main); font-size: 1.05rem;">{exModeName}</div>
      <p style="font-size: 0.88rem; color: var(--text-muted); margin: 0.35rem 0 0.75rem 0; line-height: 1.45;">{exModeEffect}</p>
      
      <div style="border-top: 1px dashed var(--border-card-subtle); padding-top: 0.5rem;">
        <div style="font-size: 0.9rem; font-weight: 600; color: #f43f5e;">{exBurstName}</div>
        <div style="font-size: 0.82rem; color: var(--text-muted);"><strong>Input:</strong> <code>{exBurstInput}</code></div>
      </div>
    </div>

    <!-- Assist & Stage Synergy -->
    <div style="background: rgba(0,0,0,0.25); padding: 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-card);">
      {assistRole && (
        <div style="margin-bottom: 0.75rem;">
          <div style="font-size: 0.75rem; font-family: var(--font-mono); text-transform: uppercase; color: var(--accent-primary); margin-bottom: 0.25rem; font-weight: bold;">Role as Assist</div>
          <div style="font-size: 0.86rem; color: var(--text-muted); line-height: 1.45;">{assistRole}</div>
        </div>
      )}

      {recommendedAssists.length > 0 && (
        <div style="margin-bottom: 0.75rem;">
          <div style="font-size: 0.75rem; font-family: var(--font-mono); text-transform: uppercase; color: var(--accent-success); margin-bottom: 0.25rem; font-weight: bold;">Recommended Assists</div>
          <ul style="margin: 0; padding-left: 1.2rem; font-size: 0.86rem; color: var(--text-muted);">
            {recommendedAssists.map(a => (
              <li><strong>{a.name}</strong> {a.reason ? `— ${a.reason}` : ''}</li>
            ))}
          </ul>
        </div>
      )}

      {(bestStages.length > 0 || worstStages.length > 0) && (
        <div style="display: flex; gap: 1rem; font-size: 0.82rem; margin-top: 0.5rem; flex-wrap: wrap;">
          {bestStages.length > 0 && (
            <div><span style="color: var(--accent-success); font-weight: bold;">Best:</span> {bestStages.join(', ')}</div>
          )}
          {worstStages.length > 0 && (
            <div><span style="color: var(--accent-danger); font-weight: bold;">Worst:</span> {worstStages.join(', ')}</div>
          )}
        </div>
      )}
    </div>
  </div>
</div>
