---
interface Props {
  name: string;
  type: 'BRV Ground' | 'BRV Aerial' | 'HP Ground' | 'HP Aerial' | 'Branch HP' | 'EX Mode Attack';
  cpCost?: number;
  apMaster?: number;
  range?: string;
  wallRush?: string;
  chase?: boolean;
  blockStagger?: boolean;
  branchTo?: string;
  description: string;
}

const {
  name,
  type,
  cpCost,
  apMaster,
  range,
  wallRush,
  chase,
  blockStagger,
  branchTo,
  description
} = Astro.props;

const isHP = type.includes('HP');
const badgeTypeClass = isHP ? 'badge-hp' : 'badge-brv';
const borderAccentColor = isHP ? 'var(--color-hp)' : 'var(--color-brv)';
---

<div class="crystal-panel move-card" style={`margin-bottom: 1.15rem; border-left: 4px solid ${borderAccentColor};`}>
  <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.65rem;">
    <div>
      <h4 style="margin: 0; font-size: 1.22rem; color: var(--text-main); display: inline-flex; align-items: center; gap: 0.6rem; letter-spacing: 0.03em;">
        {name}
        <span class={`badge-pill ${badgeTypeClass}`} style="font-size: 0.72rem; padding: 0.15rem 0.55rem;">{type}</span>
      </h4>
    </div>

    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; font-size: 0.8rem; font-family: var(--font-mono);">
      {cpCost !== undefined && (
        <span style="background: var(--surface-panel-alt); border: 1px solid var(--border-panel-subtle); padding: 0.2rem 0.55rem; border-radius: var(--radius-xs); color: var(--text-muted);">
          CP: <strong style="color: var(--text-main);">{cpCost}</strong>
        </span>
      )}
      {apMaster !== undefined && (
        <span style="background: var(--surface-panel-alt); border: 1px solid var(--border-panel-subtle); padding: 0.2rem 0.55rem; border-radius: var(--radius-xs); color: var(--text-muted);">
          AP: <strong style="color: var(--color-cosmos);">{apMaster}</strong>
        </span>
      )}
    </div>
  </div>

  <p style="font-size: 0.94rem; color: var(--text-sub); line-height: 1.55; margin-bottom: 0.85rem;">
    {description}
  </p>

  <!-- Move Properties Bar -->
  <div style="display: flex; gap: 0.85rem; flex-wrap: wrap; font-size: 0.82rem; border-top: 1px solid var(--border-panel-subtle); padding-top: 0.55rem; color: var(--text-dim); font-family: var(--font-mono);">
    {range && <div><strong style="color: var(--text-muted);">Range:</strong> <span style="color: var(--text-sub);">{range}</span></div>}
    {wallRush && <div><strong style="color: var(--color-chaos);">Wall Rush:</strong> <span style="color: var(--text-sub);">{wallRush}</span></div>}
    {chase && <div><strong style="color: var(--color-brv);">Chase:</strong> <span style="color: var(--text-sub);">Yes</span></div>}
    {blockStagger && <div><strong style="color: var(--color-cosmos);">Stagger on Block:</strong> <span style="color: var(--text-sub);">Yes</span></div>}
    {branchTo && <div><strong style="color: var(--color-lufenia);">Link Ability:</strong> <code>{branchTo}</code></div>}
  </div>

  <slot />
</div>
