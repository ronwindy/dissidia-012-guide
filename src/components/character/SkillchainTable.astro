---
interface Props {
  skillchains: {
    baseMove: string;
    links: { followup: string; skillchain: string }[];
  }[];
}

const { skillchains } = Astro.props;
---

<div class="glass-card skillchain-matrix" style="margin: 1.5rem 0;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
    <h4 style="margin: 0; font-size: 1.25rem; color: var(--accent-crystal);">Prishe Skillchain Matrix</h4>
    <span class="badge-pill badge-new">FFXI Weaponskill Links</span>
  </div>

  <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 1rem;">
    Chaining specific follow-up moves triggers elemental <strong>Skillchains</strong> for massive bonus Bravery damage. In <strong>EX Mode</strong>, Prishe executes the second attack twice; if both trigger skillchains, both burst effects activate!
  </p>

  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>Base Move</th>
          <th>Follow-Up Move</th>
          <th>Skillchain Effect</th>
          <th>Elemental Affinity</th>
        </tr>
      </thead>
      <tbody>
        {skillchains.map(group => 
          group.links.map((link, idx) => (
            <tr>
              {idx === 0 ? (
                <td rowspan={group.links.length} style="font-weight: 700; color: var(--text-main); background: rgba(255,255,255,0.02); vertical-align: top;">
                  {group.baseMove}
                </td>
              ) : null}
              <td><code>&rarr; {link.followup}</code></td>
              <td><strong style="color: var(--accent-primary);">{link.skillchain}</strong></td>
              <td style="font-size: 0.82rem; color: var(--text-dim);">
                {link.skillchain === 'Detonation' && 'Wind'}
                {link.skillchain === 'Liquefaction' && 'Fire'}
                {link.skillchain === 'Impaction' && 'Lightning'}
                {link.skillchain === 'Reverberation' && 'Water'}
                {link.skillchain === 'Compression' && 'Darkness'}
                {link.skillchain === 'Fusion' && 'Fire / Light'}
                {link.skillchain === 'Gravitation' && 'Earth / Darkness'}
                {link.skillchain === 'Transfixion' && 'Light'}
              </td>
            </tr>
          ))
        )}
      </tbody>
    </table>
  </div>
</div>
