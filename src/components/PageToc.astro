---
import '../styles/page-toc.css';
import type { PageToc } from '../lib/guideData';

interface Props {
  entries: PageToc[];
}

const { entries } = Astro.props;
---

{entries.length > 0 && (
  <nav class="page-toc" aria-label="On this page" data-page-toc>
    <details class="page-toc-box">
      <summary><span class="page-toc-label">On this page</span></summary>
      <ol class="page-toc-list">
        {entries.map((e) => <li><a href={`#${e.id}`} data-toc-link>{e.title}</a></li>)}
      </ol>
    </details>
  </nav>
)}

<script is:inline>
  (function () {
    var nav = document.querySelector('[data-page-toc]');
    if (!nav) return;
    var box = nav.querySelector('details');
    var wide = window.matchMedia('(min-width: 1280px), (orientation: landscape) and (max-height: 500px) and (min-width: 700px)');
    var land = window.matchMedia('(orientation: landscape) and (max-height: 500px) and (min-width: 700px)');
    var KEY = 'toc-collapsed';
    var stored = function () { try { return localStorage.getItem(KEY) === '1'; } catch (e) { return false; } };
    var sync = function () {
      if (!wide.matches) box.removeAttribute('open');
      else if (land.matches && stored()) box.removeAttribute('open');
      else box.setAttribute('open', '');
    };
    sync();
    box.addEventListener('toggle', function () {
      if (!land.matches) return;
      try { localStorage.setItem(KEY, box.open ? '0' : '1'); } catch (e) {}
    });
    if (land.addEventListener) land.addEventListener('change', sync);
    if (wide.addEventListener) wide.addEventListener('change', sync);

    var links = Array.prototype.slice.call(nav.querySelectorAll('[data-toc-link]'));
    var heads = links.map(function (a) { return document.getElementById(a.getAttribute('href').slice(1)); });
    var list = nav.querySelector('.page-toc-list');
    var article = document.querySelector('.guide-body');
    var current = -1;
    var progress = function () {
      if (!article) return;
      var r = article.getBoundingClientRect();
      var total = r.height - window.innerHeight * 0.5;
      var p = total > 0 ? Math.min(1, Math.max(0, (window.innerHeight * 0.25 - r.top) / total)) : 0;
      list.style.setProperty('--toc-progress', p.toFixed(3));
    };
    var update = function () {
      progress();
      var at = -1;
      for (var i = 0; i < heads.length; i++) {
        if (heads[i] && heads[i].getBoundingClientRect().top <= 120) at = i; else break;
      }
      if (at === current) return;
      current = at;
      links.forEach(function (a, i) {
        if (i === at) {
          a.setAttribute('aria-current', 'true');
          if (wide.matches) {
            var top = a.offsetTop, bottom = top + a.offsetHeight;
            if (top < list.scrollTop || bottom > list.scrollTop + list.clientHeight) list.scrollTop = top - list.clientHeight / 2;
          }
        } else a.removeAttribute('aria-current');
      });
    };
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>
