<button
  class="mobile-toggle-btn"
  id="sidebarToggle"
  aria-label="Toggle Command Menu"
  aria-expanded="false"
  aria-controls="appSidebar"
>
  <svg
    class="toggle-plate"
    width="38"
    height="34"
    viewBox="-1 -1 38 34"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <linearGradient id="toggleEdge" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#38bdf8" stop-opacity="1" />
        <stop offset="1" stop-color="#38bdf8" stop-opacity="0.9" />
      </linearGradient>
    </defs>
    <polygon
      points="8.5,0.5 35.5,0.5 35.5,23.5 27.5,31.5 0.5,31.5 0.5,8.5"
      fill="#000000"
      fill-opacity="0.6"
      transform="translate(0 3)"
      style="filter: blur(2px)"></polygon>
    <polygon
      points="8.5,0.5 35.5,0.5 35.5,23.5 27.5,31.5 0.5,31.5 0.5,8.5"
      fill="none"
      stroke="#38bdf8"
      stroke-width="4"
      stroke-opacity="0.55"
      style="filter: blur(3px)"></polygon>
    <polygon
      points="8.5,0.5 35.5,0.5 35.5,23.5 27.5,31.5 0.5,31.5 0.5,8.5"
      fill="#0d1322"
      stroke="url(#toggleEdge)"
      stroke-width="1"
      stroke-linejoin="miter"></polygon>
    <polyline
      points="0.5,8.5 8.5,0.5 35.5,0.5"
      fill="none"
      stroke="#ffffff"
      stroke-opacity="0.35"
      stroke-width="1"></polyline>
    <line x1="12" y1="11.5" x2="24" y2="11.5" stroke="#f8fafc" stroke-width="2" stroke-linecap="round"></line>
    <line x1="12" y1="16.5" x2="24" y2="16.5" stroke="#f8fafc" stroke-width="2" stroke-linecap="round"></line>
    <line x1="12" y1="21.5" x2="24" y2="21.5" stroke="#f8fafc" stroke-width="2" stroke-linecap="round"></line>
  </svg>
</button>

<style>
  .mobile-toggle-btn {
    display: inline-flex;
    flex-shrink: 0;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    background: none;
    border: 0;
    padding: 0;
    color: var(--text-main);
    cursor: pointer;
    transition: transform var(--transition-fast);
  }

  .toggle-plate {
    display: block;
    overflow: visible;
    transition: filter var(--transition-fast);
  }

  .mobile-toggle-btn:hover .toggle-plate {
    filter: brightness(1.15);
  }

  .mobile-toggle-btn:active {
    transform: scale(0.94);
  }

  .mobile-toggle-btn:focus-visible {
    outline: 2px solid var(--color-brv);
    outline-offset: 2px;
  }

  @media (max-width: 480px) {
    .mobile-toggle-btn {
      min-width: 40px;
      min-height: 40px;
    }
  }
</style>
