---
interface Props {
  baseUrl: string;
}

const { baseUrl } = Astro.props;
---

<a
  href={baseUrl}
  class="mobile-header-brand"
  aria-label="Dissidia 012 Guide Home"
  title="Dissidia 012 [duodecim] Strategy Guide"
>
  <img
    src={`${baseUrl}logo.png`}
    alt="Dissidia 012 Logo"
    class="mobile-brand-img"
  />
</a>

<style>
  .mobile-header-brand {
    display: flex;
    grid-column: 3;
    justify-self: end;
    align-items: center;
    justify-content: center;
    margin: 0;
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity var(--transition-fast);
  }

  .mobile-brand-img {
    height: 44px;
    width: auto;
    max-width: 170px;
    object-fit: contain;
    filter: drop-shadow(0 2px 14px rgba(56, 189, 248, 0.45));
    transition:
      transform var(--transition-fast),
      filter var(--transition-fast);
  }

  .mobile-header-brand:hover {
    text-decoration: none;
    opacity: 0.95;
  }

  .mobile-header-brand:hover .mobile-brand-img {
    transform: scale(1.04);
    filter: drop-shadow(0 2px 16px rgba(56, 189, 248, 0.65));
  }

  @media (max-width: 480px) {
    .mobile-brand-img {
      height: 36px;
      max-width: 130px;
    }
  }
</style>
