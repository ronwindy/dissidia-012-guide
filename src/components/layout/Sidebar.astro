---
import Icon from "../common/Icon.astro";
import { getNavGroups } from "../../data/navigation";

interface Props {
  currentPath?: string;
  baseUrl: string;
}

const { currentPath = "", baseUrl } = Astro.props;
const navGroups = getNavGroups(baseUrl);
---

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<aside class="app-sidebar" id="appSidebar" aria-label="Sidebar">
  <div class="sidebar-header">
    <a
      href={baseUrl}
      class="brand-link"
      title="Dissidia 012 [duodecim] Strategy Guide"
    >
      <img
        src={`${baseUrl}logo.png`}
        alt="Dissidia 012 Logo"
        class="sidebar-brand-img"
      />
      <div class="brand-text">
        <h1>DISSIDIA</h1>
        <span><span class="brand-num">012</span> DUODECIM GUIDE</span>
      </div>
    </a>
    <button
      class="sidebar-close-btn"
      id="sidebarClose"
      aria-label="Close Command Menu"
    >
      <Icon name="x" size={20} />
    </button>
  </div>

  <nav class="sidebar-nav" aria-label="Main Navigation">
    {
      navGroups.map((group) => (
        <div class="nav-group">
          <div class="nav-group-title">{group.title}</div>
          {group.links.map((link) => {
            const isDrakeRoute =
              Astro.url.pathname.includes("/story/drake") ||
              currentPath === "story-drake";
            const isCharacterRoute =
              Astro.url.pathname.includes("/characters/") ||
              currentPath === "roster";
            const isArenaRoute =
              Astro.url.pathname.includes("/arenas/") ||
              currentPath === "arenas";

            const checkActive = (id: string) => {
              if (id === "story-drake") return isDrakeRoute;
              if (id === "roster") return isCharacterRoute;
              if (id === "arenas") return isArenaRoute;
              if (id === "home")
                return currentPath === "" || currentPath === "home";
              return currentPath === id;
            };

            if (link.children && link.children.length > 0) {
              const hasActiveChild = link.children.some((child) =>
                checkActive(child.id),
              );
              return (
                <details
                  class={`nav-collapsible ${hasActiveChild ? "has-active-child" : ""}`}
                  open={hasActiveChild}
                >
                  <summary class="nav-collapsible-summary">
                    <span class="nav-icon">
                      <Icon name={link.icon} size={18} />
                    </span>
                    <span class="nav-label">{link.label}</span>
                    <span class="nav-chevron" aria-hidden="true">
                      <Icon name="chevron-down" size={14} />
                    </span>
                  </summary>
                  <div class="nav-collapsible-content">
                    {link.children.map((child) => {
                      const isChildActive = checkActive(child.id);
                      return (
                        <a
                          href={child.href}
                          class={`nav-link nav-sub-link ${isChildActive ? "active" : ""}`}
                        >
                          <span class="nav-icon">
                            <Icon name={child.icon} size={18} />
                          </span>
                          <span class="nav-label">{child.label}</span>
                        </a>
                      );
                    })}
                  </div>
                </details>
              );
            }

            const isActive = checkActive(link.id);
            return (
              <a
                href={link.href}
                class={`nav-link ${isActive ? "active" : ""}`}
              >
                <span class="nav-icon">
                  <Icon name={link.icon} size={18} />
                </span>
                <span class="nav-label">{link.label}</span>
              </a>
            );
          })}
        </div>
      ))
    }
  </nav>
</aside>

<script>
  function initSidebar() {
    const toggleBtn = document.getElementById("sidebarToggle");
    const closeBtn = document.getElementById("sidebarClose");
    const sidebar = document.getElementById("appSidebar");
    const overlay = document.getElementById("sidebarOverlay");

    function openMenu() {
      sidebar?.classList.add("open");
      overlay?.classList.add("open");
      toggleBtn?.setAttribute("aria-expanded", "true");
      document.body.classList.add("drawer-open");
    }

    function closeMenu() {
      sidebar?.classList.remove("open");
      overlay?.classList.remove("open");
      toggleBtn?.setAttribute("aria-expanded", "false");
      document.body.classList.remove("drawer-open");
    }

    function toggleMenu() {
      if (sidebar?.classList.contains("open")) {
        closeMenu();
      } else {
        openMenu();
      }
    }

    toggleBtn?.addEventListener("click", toggleMenu);
    closeBtn?.addEventListener("click", closeMenu);
    overlay?.addEventListener("click", closeMenu);

    // Escape key to close drawer
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && sidebar?.classList.contains("open")) {
        closeMenu();
      }
    });

    // Close sidebar on navigation clicks
    document.querySelectorAll(".nav-link").forEach((link) => {
      link.addEventListener("click", () => {
        closeMenu();
      });
    });

    // Auto-close on resize to desktop view
    window.addEventListener("resize", () => {
      if (window.innerWidth > 1024 && sidebar?.classList.contains("open")) {
        closeMenu();
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSidebar);
  } else {
    initSidebar();
  }
</script>

<style>
  /* Sidebar Overlay (Mobile Drawer Backdrop) */
  .sidebar-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 95;
    opacity: 0;
    transition: opacity var(--transition-normal);
    pointer-events: none;
  }

  .sidebar-overlay.open {
    display: block;
    opacity: 1;
    pointer-events: auto;
  }

  /* PSP Command Terminal Sidebar */
  .app-sidebar {
    width: var(--sidebar-width);
    background: var(--surface-hud);
    border-right: 1px solid var(--border-panel);
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    transition: transform var(--transition-normal);
    box-shadow: 4px 0 24px rgba(0, 0, 0, 0.6);
  }

  .sidebar-header {
    position: sticky;
    top: 0;
    z-index: 10;
    padding: 1.15rem 1.25rem;
    border-bottom: 2px solid rgba(56, 189, 248, 0.25);
    background:
      linear-gradient(
        180deg,
        rgba(56, 189, 248, 0.12) 0%,
        rgba(10, 14, 26, 0) 100%
      ),
      var(--surface-hud);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .sidebar-close-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    min-width: 36px;
    min-height: 36px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-panel);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    cursor: pointer;
    transition: all var(--transition-fast);
    flex-shrink: 0;
    margin-left: auto;
  }

  .sidebar-close-btn:hover {
    background: rgba(239, 68, 68, 0.15);
    border-color: rgba(239, 68, 68, 0.5);
    color: #f87171;
    transform: scale(1.05);
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    color: var(--text-main);
    transition: opacity var(--transition-fast);
  }

  .brand-link:hover {
    text-decoration: none;
    opacity: 0.95;
  }

  .sidebar-brand-img {
    height: 40px;
    width: auto;
    max-width: 58px;
    object-fit: contain;
    filter: drop-shadow(0 2px 12px rgba(56, 189, 248, 0.4));
    transition: transform var(--transition-fast);
  }

  .brand-link:hover .sidebar-brand-img {
    transform: scale(1.05);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .brand-text h1 {
    font-family: var(--font-wallpoet);
    font-size: 1.43rem;
    font-weight: 700;
    line-height: 1;
    margin: 0;
    letter-spacing: 0.12em;
    color: #ffffff;
    text-shadow: 0 0 12px rgba(56, 189, 248, 0.4);
  }

  .brand-text span {
    font-size: 0.7rem;
    font-family: var(--font-subheading);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #7dd3fc;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .brand-text .brand-num {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.05rem 0.3rem;
    background: rgba(56, 189, 248, 0.15);
    border: 1px solid rgba(56, 189, 248, 0.4);
    border-radius: var(--radius-xs);
    color: #38bdf8;
  }

  .sidebar-nav {
    padding: 1rem 0.75rem;
    flex: 1;
  }

  .nav-group {
    margin-bottom: 1.5rem;
  }

  .nav-group-title {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-dim);
    padding: 0.35rem 0.75rem;
    font-family: var(--font-subheading);
    font-weight: 700;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.75rem;
    min-height: 44px;
    color: var(--text-muted);
    border-radius: var(--radius-sm);
    font-family: var(--font-subheading);
    font-size: 0.98rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition: all var(--transition-fast);
    border: 1px solid transparent;
  }

  .nav-link .nav-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-dim);
    transition:
      color var(--transition-fast),
      transform var(--transition-fast);
    flex-shrink: 0;
  }

  .nav-link .nav-icon :global(svg),
  .nav-link .nav-icon svg {
    display: block;
  }

  .nav-link .nav-label {
    flex: 1;
  }

  .nav-link:hover {
    color: var(--text-main);
    background: var(--surface-panel-alt);
    border-color: rgba(56, 189, 248, 0.2);
    text-decoration: none;
  }

  .nav-link:hover .nav-icon {
    color: var(--color-brv);
    transform: scale(1.1);
  }

  .nav-link.active {
    color: #ffffff;
    background: linear-gradient(
      90deg,
      rgba(56, 189, 248, 0.22) 0%,
      rgba(56, 189, 248, 0.05) 100%
    );
    border: 1px solid rgba(56, 189, 248, 0.4);
    border-left: 3px solid var(--color-brv);
    font-weight: 700;
    box-shadow: inset 0 0 12px rgba(56, 189, 248, 0.12);
  }

  .nav-link.active .nav-icon {
    color: var(--color-brv);
    filter: drop-shadow(0 0 6px rgba(56, 189, 248, 0.6));
  }

  .nav-link .badge {
    font-size: 0.72rem;
    font-family: var(--font-mono);
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-muted);
  }

  /* Collapsible Submenu Navigation */
  .nav-collapsible {
    margin-top: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .nav-collapsible-summary {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.75rem;
    min-height: 44px;
    color: var(--text-muted);
    border-radius: var(--radius-sm);
    font-family: var(--font-subheading);
    font-size: 0.98rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition: all var(--transition-fast);
    border: 1px solid transparent;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .nav-collapsible-summary::-webkit-details-marker,
  .nav-collapsible-summary::marker {
    display: none;
  }

  .nav-collapsible-summary .nav-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-dim);
    transition:
      color var(--transition-fast),
      transform var(--transition-fast);
    flex-shrink: 0;
  }

  .nav-collapsible-summary .nav-icon :global(svg),
  .nav-collapsible-summary .nav-icon svg {
    display: block;
  }

  .nav-collapsible-summary .nav-label {
    flex: 1;
  }

  .nav-collapsible-summary:hover {
    color: var(--text-main);
    background: var(--surface-panel-alt);
    border-color: rgba(56, 189, 248, 0.2);
  }

  .nav-collapsible-summary:hover .nav-icon {
    color: var(--color-brv);
    transform: scale(1.1);
  }

  .nav-collapsible.has-active-child > .nav-collapsible-summary {
    color: #ffffff;
    background: rgba(56, 189, 248, 0.08);
    border-color: rgba(56, 189, 248, 0.25);
    font-weight: 700;
  }

  .nav-collapsible.has-active-child > .nav-collapsible-summary .nav-icon {
    color: var(--color-brv);
  }

  .nav-chevron {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-dim);
    transition:
      transform 0.2s ease,
      color var(--transition-fast);
    flex-shrink: 0;
  }

  .nav-collapsible[open] > .nav-collapsible-summary .nav-chevron {
    transform: rotate(180deg);
    color: var(--color-brv);
  }

  .nav-collapsible-content {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.25rem 0 0.25rem 0.6rem;
    margin-left: 0.85rem;
    border-left: 1px solid rgba(56, 189, 248, 0.2);
    margin-top: 0.2rem;
    margin-bottom: 0.35rem;
  }

  .nav-sub-link {
    font-size: 0.9rem;
    min-height: 38px;
    padding: 0.4rem 0.65rem;
    border-radius: var(--radius-sm);
  }

  .nav-sub-link .nav-icon :global(svg),
  .nav-sub-link .nav-icon svg {
    width: 16px;
    height: 16px;
  }

  /* Responsive Media Queries */
  @media (max-width: 1024px) {
    .sidebar-overlay.open {
      display: block;
      opacity: 1;
      pointer-events: auto;
    }

    .app-sidebar {
      width: min(300px, 85vw);
      transform: translateX(-100%);
    }

    .app-sidebar.open {
      transform: translateX(0);
      box-shadow: 10px 0 30px rgba(0, 0, 0, 0.85);
    }

    .sidebar-close-btn {
      display: inline-flex;
    }

    :global(body.drawer-open) {
      overflow: hidden;
    }
  }

  /* Print Optimization */
  @media print {
    .app-sidebar,
    .sidebar-overlay {
      display: none !important;
    }
  }
</style>
