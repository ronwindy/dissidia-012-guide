---
import SidebarHeader from "./sidebar/SidebarHeader.astro";
import SidebarNav from "./sidebar/SidebarNav.astro";
import type { PageToc } from "../../lib/guideData";

interface Props {
  currentId?: string;
  baseUrl: string;
  toc?: PageToc[];
}

const { currentId = "", baseUrl, toc = [] } = Astro.props;
---

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<aside class="app-sidebar" id="appSidebar" aria-label="Sidebar">
  <SidebarHeader baseUrl={baseUrl} />
  <SidebarNav currentId={currentId} toc={toc} />
</aside>

<script>
  function initSidebar() {
    const toggleBtn = document.getElementById("sidebarToggle");
    const closeBtn = document.getElementById("sidebarClose");
    const sidebar = document.getElementById("appSidebar");
    const overlay = document.getElementById("sidebarOverlay");

    function openMenu() {
      sidebar?.classList.add("open");
      overlay?.classList.add("open");
      toggleBtn?.setAttribute("aria-expanded", "true");
      document.body.classList.add("drawer-open");
    }

    function closeMenu() {
      sidebar?.classList.remove("open");
      overlay?.classList.remove("open");
      toggleBtn?.setAttribute("aria-expanded", "false");
      document.body.classList.remove("drawer-open");
    }

    function toggleMenu() {
      if (sidebar?.classList.contains("open")) {
        closeMenu();
      } else {
        openMenu();
      }
    }

    toggleBtn?.addEventListener("click", toggleMenu);
    closeBtn?.addEventListener("click", closeMenu);
    overlay?.addEventListener("click", closeMenu);

    // Escape key to close drawer
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && sidebar?.classList.contains("open")) {
        closeMenu();
      }
    });

    // Close sidebar on navigation clicks
    document.querySelectorAll(".nav-link, [data-toc-link]").forEach((link) => {
      link.addEventListener("click", () => {
        closeMenu();
      });
    });

    // Auto-close on resize to desktop view
    window.addEventListener("resize", () => {
      if (window.innerWidth > 1024 && sidebar?.classList.contains("open")) {
        closeMenu();
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSidebar);
  } else {
    initSidebar();
  }
</script>

<style>
  /* Sidebar Overlay (Mobile Drawer Backdrop) */
  .sidebar-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 95;
    opacity: 0;
    transition: opacity var(--transition-normal);
    pointer-events: none;
  }

  .sidebar-overlay.open {
    display: block;
    opacity: 1;
    pointer-events: auto;
  }

  /* PSP Command Terminal Sidebar */
  .app-sidebar {
    position: fixed;
    isolation: isolate;
    width: var(--sidebar-width);
    background: linear-gradient(180deg, #0f1830, #080b16);
    border-right: 1px solid var(--border-panel);
    box-shadow:
      inset -1px 0 0 rgba(251, 191, 36, 0.18),
      inset -4px 0 12px -6px rgba(56, 189, 248, 0.25),
      4px 0 24px rgba(0, 0, 0, 0.6);
    top: 0;
    bottom: 0;
    left: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform var(--transition-normal);
  }

  /* Decorative background: grid, sheens, glows and orbs (behind content). */
  .app-sidebar::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      /* grid */
      repeating-linear-gradient(60deg, rgba(147, 220, 255, 0.06) 0 1px, transparent 1px 38px),
      repeating-linear-gradient(120deg, rgba(147, 220, 255, 0.045) 0 1px, transparent 1px 38px),
      /* soft sheen, top-left */
      radial-gradient(ellipse 50% 45% at 15% 28%, rgba(147, 220, 255, 0.14), rgba(56, 189, 248, 0.04) 45%, transparent 70%),
      /* faint curved white sheen over the top 46% */
      radial-gradient(140% 46% at 50% -10%, rgba(255, 255, 255, 0.055) 0 70%, transparent 100%),
      /* bottom cyan glow */
      radial-gradient(ellipse 80% 120px at 50% 110%, rgba(56, 189, 248, 0.14), transparent 70%),
      /* orbs: right/mid, lower-left, gold bottom-centre */
      radial-gradient(circle 106px at 305px 225px, rgba(125, 211, 252, 0.18), transparent 65%),
      radial-gradient(circle 78px at 75px 315px, rgba(147, 197, 253, 0.14), transparent 65%),
      radial-gradient(circle 50px at 185px 345px, rgba(251, 191, 36, 0.10), transparent 65%);
  }

  /* Sparkle dots: one 3px dot whose shadows draw the others (pixel positions as in the design). */
  .app-sidebar::after {
    content: '';
    position: absolute;
    left: 285px;
    top: 215px;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    z-index: -1;
    pointer-events: none;
    background: #e0f7ff;
    box-shadow:
      0 0 8px 2px rgba(125, 211, 252, 0.7),
      -190px 90px 0 0 rgba(224, 247, 255, 0.7),
      -120px 130px 0 -1px rgba(224, 247, 255, 0.6),
      -40px 70px 0 0 rgba(251, 191, 36, 0.7);
  }

  /* Responsive Media Queries */
  @media (max-width: 1024px) {
    .sidebar-overlay.open {
      display: block;
      opacity: 1;
      pointer-events: auto;
    }

    .app-sidebar {
      width: min(340px, 88vw);
      transform: translateX(-100%);
    }

    .app-sidebar.open {
      transform: translateX(0);
      box-shadow:
        inset -1px 0 0 rgba(251, 191, 36, 0.18),
        10px 0 30px rgba(0, 0, 0, 0.85);
    }

    :global(body.drawer-open) {
      overflow: hidden;
    }
  }

  /* Print Optimization */
  @media print {
    .app-sidebar,
    .sidebar-overlay {
      display: none !important;
    }
  }
</style>
