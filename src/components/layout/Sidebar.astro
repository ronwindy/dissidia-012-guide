---
import SidebarHeader from "./sidebar/SidebarHeader.astro";
import SidebarNav from "./sidebar/SidebarNav.astro";

interface Props {
  currentId?: string;
  baseUrl: string;
}

const { currentId = "", baseUrl } = Astro.props;
---

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<aside class="app-sidebar" id="appSidebar" aria-label="Sidebar">
  <SidebarHeader baseUrl={baseUrl} />
  <SidebarNav currentId={currentId} />
</aside>

<script>
  function initSidebar() {
    const toggleBtn = document.getElementById("sidebarToggle");
    const closeBtn = document.getElementById("sidebarClose");
    const sidebar = document.getElementById("appSidebar");
    const overlay = document.getElementById("sidebarOverlay");

    function openMenu() {
      sidebar?.classList.add("open");
      overlay?.classList.add("open");
      toggleBtn?.setAttribute("aria-expanded", "true");
      document.body.classList.add("drawer-open");
    }

    function closeMenu() {
      sidebar?.classList.remove("open");
      overlay?.classList.remove("open");
      toggleBtn?.setAttribute("aria-expanded", "false");
      document.body.classList.remove("drawer-open");
    }

    function toggleMenu() {
      if (sidebar?.classList.contains("open")) {
        closeMenu();
      } else {
        openMenu();
      }
    }

    toggleBtn?.addEventListener("click", toggleMenu);
    closeBtn?.addEventListener("click", closeMenu);
    overlay?.addEventListener("click", closeMenu);

    // Escape key to close drawer
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && sidebar?.classList.contains("open")) {
        closeMenu();
      }
    });

    // Close sidebar on navigation clicks
    document.querySelectorAll(".nav-link").forEach((link) => {
      link.addEventListener("click", () => {
        closeMenu();
      });
    });

    // Auto-close on resize to desktop view
    window.addEventListener("resize", () => {
      if (window.innerWidth > 1024 && sidebar?.classList.contains("open")) {
        closeMenu();
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSidebar);
  } else {
    initSidebar();
  }
</script>

<style>
  /* Sidebar Overlay (Mobile Drawer Backdrop) */
  .sidebar-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 95;
    opacity: 0;
    transition: opacity var(--transition-normal);
    pointer-events: none;
  }

  .sidebar-overlay.open {
    display: block;
    opacity: 1;
    pointer-events: auto;
  }

  /* PSP Command Terminal Sidebar */
  .app-sidebar {
    width: var(--sidebar-width);
    background: var(--surface-hud);
    border-right: 1px solid var(--border-panel);
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform var(--transition-normal);
    box-shadow: 4px 0 24px rgba(0, 0, 0, 0.6);
  }

  /* Responsive Media Queries */
  @media (max-width: 1024px) {
    .sidebar-overlay.open {
      display: block;
      opacity: 1;
      pointer-events: auto;
    }

    .app-sidebar {
      width: min(300px, 85vw);
      transform: translateX(-100%);
    }

    .app-sidebar.open {
      transform: translateX(0);
      box-shadow: 10px 0 30px rgba(0, 0, 0, 0.85);
    }

    :global(body.drawer-open) {
      overflow: hidden;
    }

    :global(.sidebar-header) {
      display: none !important;
    }
  }

  /* Print Optimization */
  @media print {
    .app-sidebar,
    .sidebar-overlay {
      display: none !important;
    }
  }
</style>
