---
import Icon from "../common/Icon.astro";
import DrakeProgressTracker from "../common/DrakeProgressTracker.astro";

interface Props {
  title: string;
  baseUrl: string;
}

const { title, baseUrl } = Astro.props;
---

<header class="app-header">
  <div class="header-left">
    <button
      class="mobile-toggle-btn"
      id="sidebarToggle"
      aria-label="Toggle Command Menu"
      aria-expanded="false"
      aria-controls="appSidebar"
    >
      <Icon name="menu" size={24} />
    </button>
    <nav class="header-breadcrumbs" aria-label="Breadcrumbs">
      <a href={baseUrl} class="breadcrumb-home">Home</a>
      {
        title !== "Dissidia 012 [duodecim] Guide Portal" && (
          <>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-current" title={title}>
              {title}
            </span>
          </>
        )
      }
    </nav>
  </div>

  <a
    href={baseUrl}
    class="mobile-header-brand"
    aria-label="Dissidia 012 Guide Home"
    title="Dissidia 012 [duodecim] Strategy Guide"
  >
    <img
      src={`${baseUrl}logo.png`}
      alt="Dissidia 012 Logo"
      class="mobile-brand-img"
    />
  </a>

  <div class="header-right">
    <DrakeProgressTracker />
  </div>
</header>

<style>
  /* Header - Hidden on desktop, mobile/tablet only */
  .app-header {
    display: none;
    position: sticky;
    top: 0;
    height: var(--header-height);
    background: var(--surface-hud);
    border-bottom: 2px solid var(--border-panel);
    z-index: 90;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.5rem;
    gap: 1rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
    flex: 1;
  }

  .header-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--text-muted);
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
  }

  .header-breadcrumbs a,
  .breadcrumb-home {
    color: var(--text-muted);
    flex-shrink: 0;
    white-space: nowrap;
  }

  .header-breadcrumbs a:hover,
  .breadcrumb-home:hover {
    color: var(--color-brv);
  }

  .breadcrumb-sep {
    color: var(--text-dim);
    flex-shrink: 0;
  }

  .breadcrumb-current {
    color: var(--text-main);
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
    display: inline-block;
  }

  .header-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    flex-shrink: 0;
    min-width: 0;
  }

  .header-right :global(.drake-progress-tracker) {
    width: auto;
    background: transparent;
    border: none;
    box-shadow: none;
    padding: 0;
  }

  .header-right :global(.drake-progress-tracker:hover) {
    background: transparent;
    border-color: transparent;
    box-shadow: none;
  }

  .header-right :global(.progress-info) {
    display: none;
  }

  /* Mobile Header Brand */
  .mobile-header-brand {
    display: none;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity var(--transition-fast);
  }

  .mobile-brand-img {
    height: 38px;
    width: auto;
    max-width: 140px;
    object-fit: contain;
    filter: drop-shadow(0 2px 14px rgba(56, 189, 248, 0.45));
    transition:
      transform var(--transition-fast),
      filter var(--transition-fast);
  }

  .mobile-header-brand:hover {
    text-decoration: none;
    opacity: 0.95;
  }

  .mobile-header-brand:hover .mobile-brand-img {
    transform: scale(1.04);
    filter: drop-shadow(0 2px 16px rgba(56, 189, 248, 0.65));
  }

  /* Mobile Toggle */
  .mobile-toggle-btn {
    display: none;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    background: var(--surface-panel);
    border: 1px solid var(--border-panel);
    border-radius: var(--radius-sm);
    color: var(--text-main);
    cursor: pointer;
    padding: 0.5rem;
    transition: all var(--transition-fast);
  }

  .mobile-toggle-btn :global(svg),
  .mobile-toggle-btn svg {
    width: 22px;
    height: 22px;
  }

  .mobile-toggle-btn:hover {
    background: var(--surface-panel-alt);
    border-color: var(--color-brv);
  }

  /* Responsive Media Queries */
  @media (max-width: 1024px) {
    .app-header {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      padding: 0 1.25rem;
      gap: 0.75rem;
    }

    .header-left {
      justify-self: start;
      min-width: 0;
      flex: none;
    }

    .header-breadcrumbs {
      display: none;
    }

    .mobile-toggle-btn {
      display: inline-flex;
      flex-shrink: 0;
    }

    .mobile-header-brand {
      display: flex;
      justify-self: center;
      margin: 0;
    }

    .header-right {
      display: flex;
      justify-self: end;
      min-width: 0;
    }
  }

  @media (max-width: 768px) {
    .app-header {
      padding: 0 0.85rem;
      gap: 0.5rem;
    }

    .header-left {
      gap: 0.5rem;
    }
  }

  @media (max-width: 480px) {
    :global(:root) {
      --header-height: 58px;
    }

    .app-header {
      padding: 0 0.65rem;
      gap: 0.35rem;
    }

    .mobile-brand-img {
      height: 30px;
      max-width: 100px;
    }

    .mobile-toggle-btn {
      min-width: 40px;
      min-height: 40px;
      padding: 0.4rem;
    }

    .mobile-toggle-btn :global(svg),
    .mobile-toggle-btn svg {
      width: 20px;
      height: 20px;
    }
  }

  /* Print Optimization */
  @media print {
    .app-header,
    .mobile-toggle-btn {
      display: none !important;
    }
  }
</style>
