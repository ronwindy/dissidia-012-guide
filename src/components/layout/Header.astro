---
import { Menu } from "@lucide/astro";

interface Props {
  title: string;
  baseUrl: string;
}

const { title, baseUrl } = Astro.props;
---

<header class="app-header">
  <div class="header-left">
    <button
      class="mobile-toggle-btn"
      id="sidebarToggle"
      aria-label="Toggle Command Menu"
      aria-expanded="false"
      aria-controls="appSidebar"
    >
      <Menu size={24} aria-hidden="true" />
    </button>
    <nav class="header-breadcrumbs" aria-label="Breadcrumbs">
      <a href={baseUrl} class="breadcrumb-home">Home</a>
      {
        title && (
          <>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-current" title={title}>
              {title}
            </span>
          </>
        )
      }
    </nav>
  </div>

  <a
    href={baseUrl}
    class="mobile-header-brand"
    aria-label="Dissidia 012 Guide Home"
    title="Dissidia 012 [duodecim] Strategy Guide"
  >
    <img
      src={`${baseUrl}logo.png`}
      alt="Dissidia 012 Logo"
      class="mobile-brand-img"
    />
  </a>

  <div class="header-right"></div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".app-header");
  const toggle = document.getElementById("sidebarToggle");

  if (header) {
    let lastY = window.scrollY;
    let ticking = false;

    const update = () => {
      const y = window.scrollY;
      const delta = y - lastY;
      const menuOpen = toggle?.getAttribute("aria-expanded") === "true";

      if (y <= header.offsetHeight || menuOpen) {
        header.classList.remove("is-hidden");
      } else if (delta > 8) {
        header.classList.add("is-hidden");
      } else if (delta < -2) {
        header.classList.remove("is-hidden");
      }

      if (Math.abs(delta) > 2) lastY = y;
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }
</script>

<style>
  /* Header - Hidden on desktop, mobile/tablet only */
  .app-header {
    display: none;
    position: sticky;
    top: 0;
    height: var(--header-height);
    background: var(--surface-hud);
    border-bottom: 2px solid var(--border-panel);
    z-index: 90;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.5rem;
    gap: 1rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
    transition: transform 0.28s ease;
  }

  .app-header.is-hidden {
    transform: translateY(-100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .app-header {
      transition: none;
    }
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
    flex: 1;
  }

  .header-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--text-muted);
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
  }

  .header-breadcrumbs a,
  .breadcrumb-home {
    color: var(--text-muted);
    flex-shrink: 0;
    white-space: nowrap;
  }

  .header-breadcrumbs a:hover,
  .breadcrumb-home:hover {
    color: var(--color-brv);
  }

  .breadcrumb-sep {
    color: var(--text-dim);
    flex-shrink: 0;
  }

  .breadcrumb-current {
    color: var(--text-main);
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
    display: inline-block;
  }

  .header-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    flex-shrink: 0;
    min-width: 0;
  }

  /* Mobile Header Brand */
  .mobile-header-brand {
    display: none;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity var(--transition-fast);
  }

  .mobile-brand-img {
    height: 38px;
    width: auto;
    max-width: 140px;
    object-fit: contain;
    filter: drop-shadow(0 2px 14px rgba(56, 189, 248, 0.45));
    transition:
      transform var(--transition-fast),
      filter var(--transition-fast);
  }

  .mobile-header-brand:hover {
    text-decoration: none;
    opacity: 0.95;
  }

  .mobile-header-brand:hover .mobile-brand-img {
    transform: scale(1.04);
    filter: drop-shadow(0 2px 16px rgba(56, 189, 248, 0.65));
  }

  /* Mobile Toggle */
  .mobile-toggle-btn {
    display: none;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    background: var(--surface-panel);
    border: 1px solid var(--border-panel);
    border-radius: var(--radius-sm);
    color: var(--text-main);
    cursor: pointer;
    padding: 0.5rem;
    transition: all var(--transition-fast);
  }

  .mobile-toggle-btn :global(svg),
  .mobile-toggle-btn svg {
    width: 22px;
    height: 22px;
  }

  .mobile-toggle-btn:hover {
    background: var(--surface-panel-alt);
    border-color: var(--color-brv);
  }

  /* Responsive Media Queries */
  @media (max-width: 1024px) {
    .app-header {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      padding: 0 1.25rem;
      gap: 0.75rem;
    }

    .header-left {
      justify-self: start;
      min-width: 0;
      flex: none;
    }

    .header-breadcrumbs {
      display: none;
    }

    .mobile-toggle-btn {
      display: inline-flex;
      flex-shrink: 0;
    }

    .mobile-header-brand {
      display: flex;
      justify-self: center;
      margin: 0;
    }

    .header-right {
      display: none;
    }

    .app-header {
      grid-template-columns: auto minmax(0, 1fr) auto;
      background:
        radial-gradient(
          ellipse 60% 140% at 100% 0%,
          rgba(56, 189, 248, 0.16),
          transparent 70%
        ),
        linear-gradient(180deg, #111a2f 0%, var(--surface-hud) 100%);
      border-bottom: 1px solid var(--border-panel);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.06),
        0 4px 16px rgba(0, 0, 0, 0.4);
    }

    .app-header::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: -1px;
      height: 2px;
      background: linear-gradient(
        90deg,
        transparent,
        var(--color-brv) 30%,
        var(--color-brv) 70%,
        transparent
      );
      opacity: 0.75;
      box-shadow: 0 0 10px rgba(56, 189, 248, 0.6);
      pointer-events: none;
    }

    .mobile-header-brand {
      grid-column: 3;
      justify-self: end;
    }

    .mobile-brand-img {
      height: 44px;
      max-width: 170px;
    }

    .mobile-toggle-btn {
      background: linear-gradient(
        180deg,
        rgba(56, 189, 248, 0.14),
        rgba(56, 189, 248, 0.04)
      );
      border-color: rgba(56, 189, 248, 0.4);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.12),
        0 0 12px rgba(56, 189, 248, 0.18);
    }

    .mobile-toggle-btn:active {
      transform: scale(0.94);
      box-shadow: inset 0 0 10px rgba(56, 189, 248, 0.35);
    }
  }

  @media (max-width: 768px) {
    .app-header {
      padding: 0 0.85rem;
      gap: 0.5rem;
    }

    .header-left {
      gap: 0.5rem;
    }
  }

  @media (max-width: 480px) {
    :global(:root) {
      --header-height: 58px;
    }

    .app-header {
      padding: 0 0.65rem;
      gap: 0.35rem;
    }

    .mobile-brand-img {
      height: 36px;
      max-width: 130px;
    }

    .mobile-toggle-btn {
      min-width: 40px;
      min-height: 40px;
      padding: 0.4rem;
    }

    .mobile-toggle-btn :global(svg),
    .mobile-toggle-btn svg {
      width: 20px;
      height: 20px;
    }
  }

  /* Print Optimization */
  @media print {
    .app-header,
    .mobile-toggle-btn {
      display: none !important;
    }
  }
</style>
