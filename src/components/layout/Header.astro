---
import MenuToggle from "./header/MenuToggle.astro";
import HeaderBrand from "./header/HeaderBrand.astro";

interface Props {
  baseUrl: string;
}

const { baseUrl } = Astro.props;
---

<header class="app-header">
  <MenuToggle />
  <HeaderBrand baseUrl={baseUrl} />
</header>

<script>
  const header = document.querySelector<HTMLElement>(".app-header");
  const toggle = document.getElementById("sidebarToggle");

  if (header) {
    let lastY = window.scrollY;
    let ticking = false;

    const update = () => {
      const y = window.scrollY;
      const delta = y - lastY;
      const menuOpen = toggle?.getAttribute("aria-expanded") === "true";

      if (y <= header.offsetHeight || menuOpen) {
        header.classList.remove("is-hidden");
      } else if (delta > 8) {
        header.classList.add("is-hidden");
      } else if (delta < -2) {
        header.classList.remove("is-hidden");
      }

      if (Math.abs(delta) > 2) lastY = y;
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }
</script>

<style>
  /* Mobile/tablet only; hidden on desktop where the sidebar is always visible */
  .app-header {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    position: sticky;
    top: 0;
    height: var(--header-height);
    padding: 0 1.25rem;
    gap: 0.75rem;
    background:
      radial-gradient(
        ellipse 60% 140% at 100% 0%,
        rgba(56, 189, 248, 0.16),
        transparent 70%
      ),
      linear-gradient(180deg, #111a2f 0%, var(--surface-hud) 100%);
    border-bottom: 1px solid var(--border-panel);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 4px 16px rgba(0, 0, 0, 0.4);
    z-index: 90;
    transition: transform 0.28s ease;
  }

  .app-header.is-hidden {
    transform: translateY(-100%);
  }

  .app-header::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-brv) 30%,
      var(--color-brv) 70%,
      transparent
    );
    opacity: 0.75;
    box-shadow: 0 0 10px rgba(56, 189, 248, 0.6);
    pointer-events: none;
  }

  @media (min-width: 1025px) {
    .app-header {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .app-header {
      padding: 0 0.85rem;
      gap: 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .app-header {
      padding: 0 0.65rem;
      gap: 0.35rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .app-header {
      transition: none;
    }
  }

  @media print {
    .app-header {
      display: none !important;
    }
  }
</style>
