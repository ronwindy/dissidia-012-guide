---
import MenuToggle from "./header/MenuToggle.astro";
import HeaderBrand from "./header/HeaderBrand.astro";

interface Props {
  baseUrl: string;
  /** Page label shown on the right, e.g. "Category · Title". Omit to hide. */
  pageLabel?: string;
}

const { baseUrl, pageLabel } = Astro.props;
---

<header class="app-header">
  <MenuToggle />
  <HeaderBrand baseUrl={baseUrl} />
  {
    pageLabel && (
      <p class="header-label">
        <span class="label-tick" aria-hidden="true"></span>
        <span class="label-text">{pageLabel}</span>
      </p>
    )
  }

  <!-- Shards framing both ends (board R). Decorative only. -->
  <svg class="header-shard header-shard-left" viewBox="0 0 120 44" aria-hidden="true" focusable="false">
    <polygon points="0,0 56,0 30,44 0,30" fill="rgba(56,189,248,0.18)"></polygon>
    <polygon points="0,44 40,44 14,20" fill="rgba(251,191,36,0.24)"></polygon>
    <polygon points="70,0 96,0 60,44" fill="rgba(56,189,248,0.10)"></polygon>
  </svg>
  <svg class="header-shard header-shard-right" viewBox="0 0 120 44" aria-hidden="true" focusable="false">
    <polygon points="0,0 56,0 30,44 0,30" fill="rgba(56,189,248,0.18)"></polygon>
    <polygon points="0,44 40,44 14,20" fill="rgba(251,191,36,0.24)"></polygon>
    <polygon points="70,0 96,0 60,44" fill="rgba(56,189,248,0.10)"></polygon>
  </svg>

  <!-- Glass gloss, clipped to the header box. Decorative only. -->
  <div class="header-gloss" aria-hidden="true">
    <span class="hg-cap"></span>
    <span class="hg-streak hg-streak-a"></span>
    <span class="hg-streak hg-streak-b"></span>
    <span class="hg-streak hg-streak-c"></span>
    <span class="hg-sweep"></span>
    <span class="hg-bevel"></span>
  </div>

  <!-- Chamfered bottom edge with a light spill (board R). Decorative only. -->
  <svg class="header-trim" viewBox="0 0 844 44" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="trimSpill" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#38bdf8" stop-opacity="0"></stop>
        <stop offset="0.3" stop-color="#38bdf8" stop-opacity="0.9"></stop>
        <stop offset="0.7" stop-color="#38bdf8" stop-opacity="0.9"></stop>
        <stop offset="1" stop-color="#38bdf8" stop-opacity="0"></stop>
      </linearGradient>
    </defs>
    <path d="M0 35.5 L10 45.5 H834 L844 35.5" fill="none" stroke="rgba(0,0,0,0.75)" stroke-width="2" vector-effect="non-scaling-stroke"></path>
    <path d="M0 37 L10 47 H834 L844 37" fill="none" stroke="#38bdf8" stroke-width="6" stroke-opacity="0.16" vector-effect="non-scaling-stroke"></path>
    <path d="M1.5 33.5 L10 42 H834 L842.5 33.5" fill="none" stroke="rgba(255,255,255,0.16)" stroke-width="1" vector-effect="non-scaling-stroke"></path>
    <path d="M0 34 L10 44 H834 L844 34" fill="none" stroke="url(#trimSpill)" stroke-width="0.8" stroke-opacity="0.6" vector-effect="non-scaling-stroke"></path>
  </svg>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".app-header");
  const toggle = document.getElementById("sidebarToggle");

  if (header) {
    let lastY = window.scrollY;
    let ticking = false;

    const update = () => {
      const y = window.scrollY;
      const delta = y - lastY;
      const menuOpen = toggle?.getAttribute("aria-expanded") === "true";

      if (y <= header.offsetHeight || menuOpen) {
        header.classList.remove("is-hidden");
      } else if (delta > 8) {
        header.classList.add("is-hidden");
      } else if (delta < -2) {
        header.classList.remove("is-hidden");
      }

      if (Math.abs(delta) > 2) lastY = y;
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }
</script>

<style>
  /* Mobile/tablet only; hidden on desktop where the sidebar is always visible */
  .app-header {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    position: sticky;
    top: 0;
    height: var(--header-height);
    padding: 0 1.25rem;
    gap: 0.75rem;
    background:
      radial-gradient(
        ellipse 60% 140% at 100% 0%,
        rgba(56, 189, 248, 0.16),
        transparent 70%
      ),
      linear-gradient(180deg, #111a2f 0%, var(--surface-hud) 100%);
    border-bottom: 1px solid var(--border-panel);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 4px 16px rgba(0, 0, 0, 0.4);
    z-index: 90;
    transition: transform 0.28s ease;
  }

  .app-header.is-hidden {
    transform: translateY(-100%);
  }

  /* Keep real content above the decorative shards and trim. */
  .app-header > :not(.header-shard):not(.header-trim):not(.header-gloss) {
    position: relative;
    z-index: 1;
  }

  /* Glass gloss layers, clipped inside the header; above shards, below content. */
  .header-gloss {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .header-gloss > span {
    position: absolute;
  }
  .hg-cap {
    left: -10%;
    right: -10%;
    top: 0;
    height: 52%;
    border-radius: 0 0 50% 50% / 0 0 100% 100%;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.03));
  }
  .hg-streak {
    top: -10px;
    height: 70px;
    transform: skewX(-28deg);
  }
  .hg-streak-a {
    left: 96px;
    width: 34px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.14), transparent);
  }
  .hg-streak-b {
    left: 140px;
    width: 10px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.10), transparent);
  }
  .hg-streak-c {
    right: 140px;
    width: 26px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.08), transparent);
  }
  .hg-sweep {
    inset: 0;
    background: linear-gradient(100deg, transparent 0%, rgba(147, 220, 255, 0.10) 40%, transparent 65%);
  }
  .hg-bevel {
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35) 30%, rgba(255, 255, 255, 0.12) 70%, transparent);
  }

  .header-shard {
    position: absolute;
    top: 0;
    width: 120px;
    height: 44px;
    pointer-events: none;
    z-index: 0;
  }

  .header-shard-left {
    left: 0;
  }

  /* Mirror the left shards on the right end. */
  .header-shard-right {
    right: 0;
    transform: scaleX(-1);
  }

  .header-trim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    width: 100%;
    height: 44px;
    overflow: visible;
    pointer-events: none;
    z-index: 0;
  }

  .app-header::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-brv) 30%,
      var(--color-brv) 70%,
      transparent
    );
    opacity: 0.75;
    box-shadow: 0 0 10px rgba(56, 189, 248, 0.6);
    pointer-events: none;
  }

  /* Brand sits in the centre column. */
  .app-header :global(.mobile-header-brand) {
    grid-column: 2;
    justify-self: center;
  }

  /* Page label: gold tick, Rajdhani, with a cyan band from the tick to the end of the text. */
  .header-label {
    grid-column: 3;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    max-width: 280px;
    min-width: 0;
    font-family: "Rajdhani", system-ui, sans-serif;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.04em;
    white-space: nowrap;
    color: #e2e8f0;
    z-index: 0;
  }

  .header-label::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 8px;
    bottom: 8px;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      rgba(56, 189, 248, 0.08) 0%,
      rgba(56, 189, 248, 0.24) 18%,
      rgba(56, 189, 248, 0.24) 70%,
      rgba(56, 189, 248, 0) 100%
    );
    -webkit-mask-image: linear-gradient(
      180deg,
      transparent 0%,
      #000 35%,
      #000 65%,
      transparent 100%
    );
    mask-image: linear-gradient(
      180deg,
      transparent 0%,
      #000 35%,
      #000 65%,
      transparent 100%
    );
  }

  .label-tick {
    width: 3px;
    height: 16px;
    background: #fbbf24;
    flex-shrink: 0;
  }

  .label-text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 700px) {
    .header-label {
      display: none;
    }
  }

  @media (min-width: 1025px) {
    .app-header {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .app-header {
      padding: 0 0.85rem;
      gap: 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .app-header {
      padding: 0 0.65rem;
      gap: 0.35rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .app-header {
      transition: none;
    }
  }

  @media print {
    .app-header {
      display: none !important;
    }
  }
</style>
