---
import Icon from "../../common/Icon.astro";
import type { NavLinkItem } from "../../../data/navigation";

interface Props {
  link: NavLinkItem;
  currentPath?: string;
  pathname: string;
}

const { link, currentPath = "", pathname } = Astro.props;

const isStoryRoute =
  pathname.includes("/story/") || currentPath.startsWith("story-");
const isCharacterRoute =
  pathname.includes("/characters/") || currentPath === "roster";
const isArenaRoute =
  pathname.includes("/arenas/") || currentPath === "arenas";

function checkActive(id: string): boolean {
  if (id === "story-walkthrough") return isStoryRoute;
  if (id === "story-hub")
    return (
      currentPath === "story-hub" ||
      pathname.endsWith("/story/") ||
      pathname.endsWith("/story")
    );
  if (id === "story-basics")
    return (
      currentPath === "story-basics" ||
      pathname.includes("/story/gameplay-basics")
    );
  if (id === "story-012")
    return (
      currentPath === "story-012" ||
      pathname.includes("/story/012-treachery")
    );
  if (id === "story-013")
    return (
      currentPath === "story-013" ||
      pathname.includes("/story/013-light")
    );
  if (id === "story-000")
    return (
      currentPath === "story-000" ||
      pathname.includes("/story/000-creator")
    );
  if (id === "story-reports")
    return (
      currentPath === "story-reports" ||
      pathname.includes("/story/reports")
    );
  if (id === "roster") return isCharacterRoute;
  if (id === "arenas") return isArenaRoute;
  if (id === "home")
    return currentPath === "" || currentPath === "home";
  return currentPath === id;
}

const hasChildren = Boolean(link.children && link.children.length > 0);
const hasActiveChild = hasChildren && link.children!.some((child) => checkActive(child.id));
const isActive = !hasChildren && checkActive(link.id);
---

{
  hasChildren ? (
    <details
      class={`nav-collapsible ${hasActiveChild ? "has-active-child" : ""}`}
      open={hasActiveChild}
    >
      <summary class="nav-collapsible-summary">
        <span class="nav-icon">
          <Icon name={link.icon} size={18} />
        </span>
        <span class="nav-label">{link.label}</span>
        <span class="nav-chevron" aria-hidden="true">
          <Icon name="chevron-down" size={14} />
        </span>
      </summary>
      <div class="nav-collapsible-content">
        {link.children!.map((child) => {
          const isChildActive = checkActive(child.id);
          return (
            <a
              href={child.href}
              class={`nav-link nav-sub-link ${isChildActive ? "active" : ""}`}
            >
              <span class="nav-icon">
                <Icon name={child.icon} size={18} />
              </span>
              <span class="nav-label">{child.label}</span>
            </a>
          );
        })}
      </div>
    </details>
  ) : (
    <a href={link.href} class={`nav-link ${isActive ? "active" : ""}`}>
      <span class="nav-icon">
        <Icon name={link.icon} size={18} />
      </span>
      <span class="nav-label">{link.label}</span>
    </a>
  )
}

<style>
  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.75rem;
    min-height: 44px;
    color: var(--text-muted);
    border-radius: var(--radius-sm);
    font-family: var(--font-subheading);
    font-size: 0.98rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition: all var(--transition-fast);
    border: 1px solid transparent;
  }

  .nav-link .nav-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-dim);
    transition:
      color var(--transition-fast),
      transform var(--transition-fast);
    flex-shrink: 0;
  }

  .nav-link .nav-icon :global(svg),
  .nav-link .nav-icon svg {
    display: block;
  }

  .nav-link .nav-label {
    flex: 1;
  }

  .nav-link:hover {
    color: var(--text-main);
    background: var(--surface-panel-alt);
    border-color: rgba(56, 189, 248, 0.2);
    text-decoration: none;
  }

  .nav-link:hover .nav-icon {
    color: var(--color-brv);
    transform: scale(1.1);
  }

  .nav-link.active {
    color: #ffffff;
    background: linear-gradient(
      90deg,
      rgba(56, 189, 248, 0.22) 0%,
      rgba(56, 189, 248, 0.05) 100%
    );
    border: 1px solid rgba(56, 189, 248, 0.4);
    border-left: 3px solid var(--color-brv);
    font-weight: 700;
    box-shadow: inset 0 0 12px rgba(56, 189, 248, 0.12);
  }

  .nav-link.active .nav-icon {
    color: var(--color-brv);
    filter: drop-shadow(0 0 6px rgba(56, 189, 248, 0.6));
  }

  .nav-collapsible {
    margin-top: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .nav-collapsible-summary {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.75rem;
    min-height: 44px;
    color: var(--text-muted);
    border-radius: var(--radius-sm);
    font-family: var(--font-subheading);
    font-size: 0.98rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition: all var(--transition-fast);
    border: 1px solid transparent;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .nav-collapsible-summary::-webkit-details-marker,
  .nav-collapsible-summary::marker {
    display: none;
  }

  .nav-collapsible-summary .nav-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-dim);
    transition:
      color var(--transition-fast),
      transform var(--transition-fast);
    flex-shrink: 0;
  }

  .nav-collapsible-summary .nav-icon :global(svg),
  .nav-collapsible-summary .nav-icon svg {
    display: block;
  }

  .nav-collapsible-summary .nav-label {
    flex: 1;
  }

  .nav-collapsible-summary:hover {
    color: var(--text-main);
    background: var(--surface-panel-alt);
    border-color: rgba(56, 189, 248, 0.2);
  }

  .nav-collapsible-summary:hover .nav-icon {
    color: var(--color-brv);
    transform: scale(1.1);
  }

  .nav-collapsible.has-active-child > .nav-collapsible-summary {
    color: #ffffff;
    background: rgba(56, 189, 248, 0.08);
    border-color: rgba(56, 189, 248, 0.25);
    font-weight: 700;
  }

  .nav-collapsible.has-active-child > .nav-collapsible-summary .nav-icon {
    color: var(--color-brv);
  }

  .nav-chevron {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-dim);
    transition:
      transform 0.2s ease,
      color var(--transition-fast);
    flex-shrink: 0;
  }

  .nav-collapsible[open] > .nav-collapsible-summary .nav-chevron {
    transform: rotate(180deg);
    color: var(--color-brv);
  }

  .nav-collapsible-content {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.25rem 0 0.25rem 0.6rem;
    margin-left: 0.85rem;
    border-left: 1px solid rgba(56, 189, 248, 0.2);
    margin-top: 0.2rem;
    margin-bottom: 0.35rem;
  }

  .nav-sub-link {
    font-size: 0.9rem;
    min-height: 38px;
    padding: 0.4rem 0.65rem;
    border-radius: var(--radius-sm);
  }

  .nav-sub-link .nav-icon :global(svg),
  .nav-sub-link .nav-icon svg {
    width: 16px;
    height: 16px;
  }
</style>
