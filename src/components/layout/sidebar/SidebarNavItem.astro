---
import Icon from "../../common/Icon.astro";
import type { NavLinkItem } from "../../../data/navigation";

interface Props {
  link: NavLinkItem;
  currentPath?: string;
  pathname: string;
}

const { link, currentPath = "", pathname } = Astro.props;

const isStoryRoute =
  pathname.includes("/story/") || currentPath.startsWith("story-");
const isCharacterRoute =
  pathname.includes("/characters/") || currentPath === "roster";
const isArenaRoute =
  pathname.includes("/arenas/") || currentPath === "arenas";

function checkActive(id: string): boolean {
  if (id === "story-walkthrough") return isStoryRoute;
  if (id === "story-hub")
    return (
      currentPath === "story-hub" ||
      pathname.endsWith("/story/") ||
      pathname.endsWith("/story")
    );
  if (id === "story-basics")
    return (
      currentPath === "story-basics" ||
      pathname.includes("/story/gameplay-basics")
    );
  if (id === "story-012")
    return (
      currentPath === "story-012" ||
      pathname.includes("/story/012-treachery")
    );
  if (id === "story-013")
    return (
      currentPath === "story-013" ||
      pathname.includes("/story/013-light")
    );
  if (id === "story-000")
    return (
      currentPath === "story-000" ||
      pathname.includes("/story/000-creator")
    );
  if (id === "story-reports")
    return (
      currentPath === "story-reports" ||
      pathname.includes("/story/reports")
    );
  if (id === "roster") return isCharacterRoute;
  if (id === "arenas") return isArenaRoute;
  if (id === "home")
    return currentPath === "" || currentPath === "home";
  return currentPath === id;
}

const isActive = checkActive(link.id);
---

<a href={link.href} class={`nav-link ${isActive ? "active" : ""}`}>
  <span class="nav-icon">
    <Icon name={link.icon} size={18} />
  </span>
  <span class="nav-label">{link.label}</span>
</a>

<style>
  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.75rem;
    min-height: 44px;
    color: var(--text-muted);
    border-radius: var(--radius-sm);
    font-family: var(--font-subheading);
    font-size: 0.98rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition: all var(--transition-fast);
    border: 1px solid transparent;
  }

  .nav-link .nav-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-dim);
    transition:
      color var(--transition-fast),
      transform var(--transition-fast);
    flex-shrink: 0;
  }

  .nav-link .nav-icon :global(svg),
  .nav-link .nav-icon svg {
    display: block;
  }

  .nav-link .nav-label {
    flex: 1;
  }

  .nav-link:hover {
    color: var(--text-main);
    background: var(--surface-panel-alt);
    border-color: rgba(56, 189, 248, 0.2);
    text-decoration: none;
  }

  .nav-link:hover .nav-icon {
    color: var(--color-brv);
    transform: scale(1.1);
  }

  .nav-link.active {
    color: #ffffff;
    background: linear-gradient(
      90deg,
      rgba(56, 189, 248, 0.22) 0%,
      rgba(56, 189, 248, 0.05) 100%
    );
    border: 1px solid rgba(56, 189, 248, 0.4);
    border-left: 3px solid var(--color-brv);
    font-weight: 700;
    box-shadow: inset 0 0 12px rgba(56, 189, 248, 0.12);
  }

  .nav-link.active .nav-icon {
    color: var(--color-brv);
    filter: drop-shadow(0 0 6px rgba(56, 189, 248, 0.6));
  }
</style>
