---
import { getToc } from '../../../lib/guideData';
import { navCategoryIcon, navEntryIcon } from '../../../lib/icons';

import type { PageToc } from '../../../lib/guideData';

interface Props {
  currentId?: string;
  toc?: PageToc[];
}

const { currentId = '', toc = [] } = Astro.props;
const hasToc = toc.length > 0;
const categories = getToc();
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const total = categories.reduce((n, c) => n + c.entries.length, 0);
---

<nav class="sidebar-nav" aria-label="Guide sections" data-sidebar-tabs data-has-toc={hasToc ? 'true' : 'false'}>
  <div class="nav-tabs" role="tablist">
    <button type="button" role="tab" class="nav-tab" data-tab="guide" id="tab-guide" aria-controls="panel-guide">Guide</button>
    <button type="button" role="tab" class="nav-tab" data-tab="page" id="tab-page" aria-controls="panel-page" disabled={!hasToc}>This Page</button>
  </div>

  <div class="nav-panel" role="tabpanel" id="panel-guide" aria-labelledby="tab-guide" data-panel="guide">
  <div class="progress" data-progress-total={total}>
    <div class="progress-text"><span data-progress-count>0</span> / {total} read</div>
    <div class="progress-bar"><div data-progress-fill></div></div>
    <a class="progress-resume" data-progress-resume href={`${baseUrl}/`} hidden>Continue reading</a>
  </div>

  {categories.map((cat) => (
    <details class="nav-group" open={cat.entries.some((e) => e.id === currentId)} data-category-id={cat.category}>
      <summary class="nav-group-title">
        {(() => { const CatIcon = navCategoryIcon(cat.category); return <CatIcon class="nav-icon" size={16} aria-hidden="true" />; })()}
        <span>{cat.category}</span>
      </summary>
      <ul>
        {cat.entries.map((entry) => {
          const EntryIcon = navEntryIcon(cat.category, entry.title);
          return (
            <li>
              <a
                class="nav-link"
                href={`${baseUrl}/guide/${entry.id}`}
                data-page-id={entry.id}
                aria-current={entry.id === currentId ? 'page' : undefined}
              >
                <EntryIcon class="nav-icon" size={18} aria-hidden="true" />
                <span class="nav-label">{entry.title}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </details>
  ))}
  </div>

  <div class="nav-panel" role="tabpanel" id="panel-page" aria-labelledby="tab-page" data-panel="page" hidden>
    {hasToc && (
      <ol class="page-toc-list" data-page-toc-list>
        {toc.map((e) => <li><a href={`#${e.id}`} data-toc-link>{e.title}</a></li>)}
      </ol>
    )}
  </div>
</nav>

<script>
  // Remember which categories are open for this browser session.
  document.querySelectorAll<HTMLDetailsElement>('.sidebar-nav details[data-category-id]').forEach((details) => {
    const key = `nav-cat-${details.dataset.categoryId}`;
    try {
      const stored = sessionStorage.getItem(key);
      if (stored !== null && !details.querySelector('[aria-current="page"]')) details.open = stored === 'true';
    } catch {}
    details.addEventListener('toggle', () => {
      try { sessionStorage.setItem(key, String(details.open)); } catch {}
    });
  });
</script>

<script>
  // Tabs: "This Page" is the default when the page has headings.
  (() => {
    const nav = document.querySelector<HTMLElement>('[data-sidebar-tabs]');
    if (!nav) return;
    const tabs = Array.from(nav.querySelectorAll<HTMLButtonElement>('.nav-tab'));
    const panels = Array.from(nav.querySelectorAll<HTMLElement>('.nav-panel'));
    const hasToc = nav.dataset.hasToc === 'true';
    const show = (name: string) => {
      tabs.forEach((t) => {
        const on = t.dataset.tab === name;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p) => { p.hidden = p.dataset.panel !== name; });
    };
    tabs.forEach((t) => t.addEventListener('click', () => { if (!t.disabled) show(t.dataset.tab!); }));
    show(hasToc ? 'page' : 'guide');

    // Page-heading scroll-spy: highlights the active section.
    const list = nav.querySelector<HTMLElement>('[data-page-toc-list]');
    if (!list) return;
    const links = Array.from(list.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    const heads = links.map((a) => document.getElementById(a.getAttribute('href')!.slice(1)));
    let current = -1;
    const update = () => {
      let at = -1;
      for (let i = 0; i < heads.length; i++) {
        const h = heads[i];
        if (h && h.getBoundingClientRect().top <= 120) at = i; else break;
      }
      if (at === current) return;
      current = at;
      links.forEach((a, i) => {
        if (i === at) {
          a.setAttribute('aria-current', 'true');
          if (!list.closest('[hidden]')) {
            const top = a.offsetTop, bottom = top + a.offsetHeight;
            if (top < nav.scrollTop || bottom > nav.scrollTop + nav.clientHeight) nav.scrollTop = top - nav.clientHeight / 2;
          }
        } else a.removeAttribute('aria-current');
      });
    };
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>

<style>
  .sidebar-nav {
    padding: 0.9rem 0.75rem 1rem;
    flex: 1;
    overflow-y: auto;
    min-height: 0;
  }


  /* Tabs */
  .nav-tabs {
    display: flex;
    gap: 2px;
    margin-bottom: 0.9rem;
    border-bottom: 1px solid var(--border-panel);
  }
  .nav-tab {
    flex: 1;
    min-height: 40px;
    padding: 0.4rem 0.5rem;
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    color: var(--text-muted);
    font-family: var(--font-subheading);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color var(--transition-fast), background var(--transition-fast);
  }
  .nav-tab:hover:not(:disabled) { color: var(--text-main); background: rgba(56, 189, 248, 0.08); }
  .nav-tab[aria-selected='true'] {
    color: var(--color-brv);
    border-bottom-color: var(--color-brv);
    background: linear-gradient(180deg, transparent, rgba(56, 189, 248, 0.14));
  }
  .nav-tab:disabled { opacity: 0.4; cursor: default; }
  .nav-panel[hidden] { display: none; }

  /* This Page list */
  .page-toc-list {
    list-style: none;
    margin: 0;
    padding: 0.25rem 0 0.6rem;
  }
  .page-toc-list li { margin: 0; }
  .page-toc-list a {
    display: block;
    padding: 0.4rem 0.6rem;
    margin: 0.05rem 0;
    min-height: 36px;
    font-family: var(--font-subheading);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    line-height: 1.25;
    color: var(--text-muted);
    text-decoration: none;
    border-left: 3px solid transparent;
    transition: background 0.15s, color 0.15s;
  }
  .page-toc-list a:hover {
    color: var(--text-main);
    background: linear-gradient(90deg, rgba(56, 189, 248, 0.18), transparent);
    border-left-color: var(--color-brv);
  }
  .page-toc-list a[aria-current] {
    color: #fff;
    background: linear-gradient(90deg, rgba(56, 189, 248, 0.22), rgba(56, 189, 248, 0.05));
    font-weight: 700;
    border-left-color: var(--color-brv);
  }
  @media (prefers-reduced-motion: reduce) {
    .page-toc-list a { transition: none; }
  }

  /* Single cyan accent for every category */
  .nav-group {
    --cat: 56, 189, 248;
    margin-bottom: 0.85rem;
  }

  .nav-group ul {
    list-style: none;
    margin: 0.3rem 0 0;
    padding: 0 0 0 0.5rem;
    border-left: 1px solid rgba(var(--cat), 0.28);
    margin-left: 0.9rem;
  }

  .nav-group li {
    margin: 0;
  }

  .nav-group-title {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    cursor: pointer;
    list-style: none;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgb(var(--cat));
    padding: 0.5rem 0.75rem;
    min-height: 44px;
    font-family: var(--font-heading);
    font-weight: 700;
    background: linear-gradient(90deg, rgba(var(--cat), 0.2), rgba(var(--cat), 0.03));
    border-left: 3px solid rgb(var(--cat));
    border-bottom: 1px solid rgba(var(--cat), 0.3);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%);
    text-shadow: 0 0 10px rgba(var(--cat), 0.35);
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .nav-group-title .nav-icon {
    filter: drop-shadow(0 0 5px rgba(var(--cat), 0.6));
  }

  .nav-group-title::-webkit-details-marker {
    display: none;
  }

  .nav-group-title::after {
    content: '';
    margin-left: auto;
    width: 0.4rem;
    height: 0.4rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(-45deg);
    transition: transform var(--transition-fast);
  }

  .nav-group[open] > .nav-group-title::after {
    transform: rotate(45deg);
  }

  .nav-group-title:hover {
    background: linear-gradient(90deg, rgba(var(--cat), 0.32), rgba(var(--cat), 0.06));
  }

  .nav-link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.75rem;
    margin-top: 2px;
    min-height: 44px;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.025);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 9px), calc(100% - 9px) 100%, 0 100%);
    font-family: var(--font-subheading);
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition: all var(--transition-fast);
    border-left: 3px solid transparent;
  }

  .nav-link .nav-icon {
    color: var(--text-dim);
    transition:
      color var(--transition-fast),
      transform var(--transition-fast);
    flex-shrink: 0;
  }

  .nav-link .nav-label {
    flex: 1;
  }

  .nav-link:hover {
    color: var(--text-main);
    background: linear-gradient(90deg, rgba(var(--cat), 0.16), rgba(var(--cat), 0.03));
    border-left-color: rgba(var(--cat), 0.7);
    text-decoration: none;
  }

  .nav-link:hover .nav-icon {
    color: rgb(var(--cat));
    transform: scale(1.1);
  }

  .nav-link[aria-current='page'] {
    color: #ffffff;
    background: linear-gradient(90deg, rgba(var(--cat), 0.36) 0%, rgba(var(--cat), 0.06) 100%);
    border-left: 3px solid rgb(var(--cat));
    font-weight: 600;
    box-shadow: inset 0 0 14px rgba(var(--cat), 0.2);
  }

  .nav-link[aria-current='page'] .nav-icon {
    color: rgb(var(--cat));
    filter: drop-shadow(0 0 6px rgba(var(--cat), 0.7));
  }

  /* Read marks (set by the reading-progress script in BaseLayout) */
  .nav-link[data-done]::after {
    content: '✓';
    margin-left: auto;
    color: var(--color-assist);
    font-weight: 700;
  }

  /* Reading progress */
  .progress {
    padding: 0.25rem 0.75rem 1rem;
  }

  .progress-text {
    margin-bottom: 0.4rem;
    font-family: var(--font-subheading);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .progress-bar {
    height: 8px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .progress-bar > div {
    width: 0;
    height: 100%;
    background: linear-gradient(90deg, var(--color-brv), #7dd3fc);
    box-shadow: 0 0 10px rgba(56, 189, 248, 0.6);
    transition: width 0.3s;
  }

  .progress-resume {
    display: block;
    margin-top: 0.6rem;
    font-size: 0.85rem;
  }

  .progress-resume[hidden] {
    display: none;
  }

  @media (max-width: 1024px) {
    .sidebar-nav {
      padding: 1.25rem 0.75rem;
    }
  }
</style>
