---
import { X } from "@lucide/astro";

interface Props {
  baseUrl: string;
}

const { baseUrl } = Astro.props;
---

<div class="sidebar-header">
  <a
    href={baseUrl}
    class="brand-link"
    title="Dissidia 012 [duodecim] Strategy Guide"
  >
    <img
      src={`${baseUrl}logo.png`}
      alt="Dissidia 012 Logo"
      class="sidebar-brand-img"
    />
    <span class="brand-sub">Strategy Guide</span>
  </a>
  <button
    class="sidebar-close-btn"
    id="sidebarClose"
    aria-label="Close Command Menu"
  >
    <X size={20} aria-hidden="true" />
  </button>
</div>

<style>
  .sidebar-header {
    position: sticky;
    top: 0;
    z-index: 10;
    padding: 1rem 1.25rem 0.9rem;
    background:
      linear-gradient(
        180deg,
        rgba(56, 189, 248, 0.16) 0%,
        rgba(10, 14, 26, 0) 100%
      ),
      var(--surface-hud);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  /* Cyan HUD divider with a bright core, separating header from entries */
  .sidebar-header::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-brv) 20%,
      #e0f7ff 50%,
      var(--color-brv) 80%,
      transparent
    );
    box-shadow: 0 0 10px rgba(56, 189, 248, 0.55);
  }

  .sidebar-close-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-panel);
    clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);
    color: var(--text-muted);
    cursor: pointer;
    transition: all var(--transition-fast);
    flex-shrink: 0;
    margin-left: auto;
  }

  .sidebar-close-btn:hover {
    background: rgba(239, 68, 68, 0.15);
    border-color: rgba(239, 68, 68, 0.5);
    color: #f87171;
  }

  .brand-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    flex: 1;
    min-width: 0;
    text-decoration: none;
    color: var(--text-main);
    transition: opacity var(--transition-fast);
  }

  .brand-link:hover {
    text-decoration: none;
    opacity: 0.95;
  }

  .sidebar-brand-img {
    width: 100%;
    max-width: 220px;
    height: auto;
    max-height: 85px;
    object-fit: contain;
    filter: drop-shadow(0 2px 14px rgba(56, 189, 248, 0.45));
    transition: transform var(--transition-fast);
  }

  .brand-link:hover .sidebar-brand-img {
    transform: scale(1.04);
  }

  .brand-sub {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-brv);
    text-shadow: 0 0 8px rgba(56, 189, 248, 0.4);
  }

  /* Mobile drawer (incl. landscape): compact bar, logo left, close right */
  @media (max-width: 1024px) {
    .sidebar-header {
      padding: 0.4rem 0.75rem;
      min-height: 56px;
    }

    .brand-link {
      flex-direction: row;
      justify-content: flex-start;
      gap: 0.65rem;
    }

    .sidebar-brand-img {
      width: auto;
      max-width: 120px;
      max-height: 38px;
    }

    .brand-sub {
      font-size: 0.66rem;
      letter-spacing: 0.22em;
      white-space: nowrap;
    }

    .sidebar-close-btn {
      display: inline-flex;
    }
  }
</style>
