---
interface Props {
  class?: string;
  id?: string;
}

const { class: className = "", id = "main-content" } = Astro.props;
---

<main class:list={["content-wrapper", className]} id={id}>
  <slot />
</main>

<style>
  /* Content Container */
  .content-wrapper {
    max-width: var(--max-content-width);
    width: 100%;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  @media (max-width: 768px) {
    .content-wrapper {
      padding: 1.25rem 0.85rem 3rem;
    }
  }

  @media (max-width: 480px) {
    .content-wrapper {
      padding: 1rem 0.65rem 2.5rem;
    }
  }
</style>
