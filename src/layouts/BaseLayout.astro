---
import "../styles/global.css";
import Icon from "../components/common/Icon.astro";
import type { IconName } from "../components/common/icons";

interface NavLinkChild {
  label: string;
  href: string;
  id: string;
  icon: IconName;
}

interface NavLinkItem {
  label: string;
  href?: string;
  id: string;
  icon: IconName;
  children?: NavLinkChild[];
}

interface NavGroup {
  title: string;
  links: NavLinkItem[];
}

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const {
  title,
  description = "Complete move lists, story gateways, reports, crafting recipes, and combat strategies for Dissidia 012 [duodecim] Final Fantasy (PSP).",
  currentPath = "",
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const navGroups: NavGroup[] = [
  {
    title: "General",
    links: [
      {
        label: "Home",
        href: `${baseUrl}`,
        id: "home",
        icon: "home",
      },
      {
        label: "FAQ & Credits",
        href: `${baseUrl}faq/`,
        id: "faq",
        icon: "help-circle",
      },
    ],
  },
  {
    title: "Gameplay",
    links: [
      {
        label: "Characters",
        href: `${baseUrl}characters/`,
        id: "roster",
        icon: "swords",
      },
      {
        label: "Combat Mechanics",
        href: `${baseUrl}mechanics/`,
        id: "mechanics",
        icon: "zap",
      },

      {
        label: "Arenas",
        href: `${baseUrl}arenas/`,
        id: "arenas",
        icon: "globe",
      },
      {
        label: "Equipments & Shop",
        href: `${baseUrl}crafting/`,
        id: "crafting",
        icon: "gem",
      },
    ],
  },
  {
    title: "Walkthroughs",
    links: [
      {
        label: "Drake's Walkthrough",
        href: `${baseUrl}story/drake/`,
        id: "story-drake",
        icon: "book-open",
      },
      {
        label: "Legacy Walkthrough",
        id: "legacy-walkthroughs",
        icon: "layers",
        children: [
          {
            label: "Scenario Overview",
            href: `${baseUrl}story/`,
            id: "story-hub",
            icon: "map",
          },
          {
            label: "012: Treachery of Gods",
            href: `${baseUrl}story/012-treachery/`,
            id: "story-012",
            icon: "flame",
          },
          {
            label: "013: Light to All",
            href: `${baseUrl}story/013-light/`,
            id: "story-013",
            icon: "sparkles",
          },
          {
            label: "000: Creator's Gateways",
            href: `${baseUrl}story/000-creator/`,
            id: "story-000",
            icon: "compass",
          },
        ],
      },
    ],
  },
  {
    title: "Lore & Unlocks",
    links: [
      {
        label: "20 Reports & Unlocks",
        href: `${baseUrl}reports/`,
        id: "reports",
        icon: "file-text",
      },
    ],
  },
  {
    title: "Extra",
    links: [
      {
        label: "Quests & Friend Cards",
        href: `${baseUrl}quests/`,
        id: "quests",
        icon: "layout",
      },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Dissidia 012 [duodecim] Guide</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <meta name="theme-color" content="#070a13" />
  </head>
  <body style={`--site-bg: url('${baseUrl}background.jpg');`}>
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="app-container">
      <!-- Left Sidebar -->
      <aside class="app-sidebar" id="appSidebar" aria-label="Sidebar">
        <div class="sidebar-header">
          <a
            href={baseUrl}
            class="brand-link"
            title="Dissidia 012 [duodecim] Strategy Guide"
          >
            <img
              src={`${baseUrl}logo.png`}
              alt="Dissidia 012 Logo"
              class="sidebar-brand-img"
            />
            <div class="brand-text">
              <h1>DISSIDIA</h1>
              <span><span class="brand-num">012</span> DUODECIM GUIDE</span>
            </div>
          </a>
          <button
            class="sidebar-close-btn"
            id="sidebarClose"
            aria-label="Close Command Menu"
          >
            <Icon name="x" size={20} />
          </button>
        </div>

        <nav class="sidebar-nav" aria-label="Main Navigation">
          {
            navGroups.map((group) => (
              <div class="nav-group">
                <div class="nav-group-title">{group.title}</div>
                {group.links.map((link) => {
                  const isDrakeRoute =
                    Astro.url.pathname.includes("/story/drake") ||
                    currentPath === "story-drake";
                  const isCharacterRoute =
                    Astro.url.pathname.includes("/characters/") ||
                    currentPath === "roster";
                  const isArenaRoute =
                    Astro.url.pathname.includes("/arenas/") ||
                    currentPath === "arenas";

                  const checkActive = (id: string) => {
                    if (id === "story-drake") return isDrakeRoute;
                    if (id === "roster") return isCharacterRoute;
                    if (id === "arenas") return isArenaRoute;
                    if (id === "home")
                      return currentPath === "" || currentPath === "home";
                    return currentPath === id;
                  };

                  if (link.children && link.children.length > 0) {
                    const hasActiveChild = link.children.some((child) =>
                      checkActive(child.id),
                    );
                    return (
                      <details
                        class={`nav-collapsible ${hasActiveChild ? "has-active-child" : ""}`}
                        open={hasActiveChild}
                      >
                        <summary class="nav-collapsible-summary">
                          <span class="nav-icon">
                            <Icon name={link.icon} size={18} />
                          </span>
                          <span class="nav-label">{link.label}</span>
                          <span class="nav-chevron" aria-hidden="true">
                            <Icon name="chevron-down" size={14} />
                          </span>
                        </summary>
                        <div class="nav-collapsible-content">
                          {link.children.map((child) => {
                            const isChildActive = checkActive(child.id);
                            return (
                              <a
                                href={child.href}
                                class={`nav-link nav-sub-link ${isChildActive ? "active" : ""}`}
                              >
                                <span class="nav-icon">
                                  <Icon name={child.icon} size={18} />
                                </span>
                                <span class="nav-label">{child.label}</span>
                              </a>
                            );
                          })}
                        </div>
                      </details>
                    );
                  }

                  const isActive = checkActive(link.id);
                  return (
                    <a
                      href={link.href}
                      class={`nav-link ${isActive ? "active" : ""}`}
                    >
                      <span class="nav-icon">
                        <Icon name={link.icon} size={18} />
                      </span>
                      <span class="nav-label">{link.label}</span>
                    </a>
                  );
                })}
              </div>
            ))
          }
        </nav>

        <div
          style="padding: 1rem 1.25rem; border-top: 1px solid var(--border-panel); font-size: 0.78rem; color: var(--text-dim); background: var(--surface-panel);"
        >
          <div
            style="display: flex; justify-content: space-between; align-items: center;"
          >
            <span>Drake's Guide Progress:</span>
            <span
              id="globalProgressCount"
              style="color: var(--color-assist); font-weight: 700; font-family: var(--font-mono); font-size: 0.9rem;"
              >0 / 27</span
            >
          </div>
        </div>
      </aside>

      <!-- Main Content Shell -->
      <div class="app-main">
        <header class="app-header">
          <div class="header-left">
            <button
              class="mobile-toggle-btn"
              id="sidebarToggle"
              aria-label="Toggle Command Menu"
              aria-expanded="false"
              aria-controls="appSidebar"
            >
              <Icon name="menu" size={24} />
            </button>
            <nav class="header-breadcrumbs" aria-label="Breadcrumbs">
              <a href={baseUrl} class="breadcrumb-home">Home</a>
              {
                title !== "Dissidia 012 [duodecim] Guide Portal" && (
                  <>
                    <span class="breadcrumb-sep">/</span>
                    <span class="breadcrumb-current" title={title}>
                      {title}
                    </span>
                  </>
                )
              }
            </nav>
          </div>

          <a
            href={baseUrl}
            class="mobile-header-brand"
            aria-label="Dissidia 012 Guide Home"
          >
            <img
              src={`${baseUrl}logo.png`}
              alt="Dissidia 012 Logo"
              class="mobile-brand-img"
            />
            <div class="mobile-brand-text">
              <span class="mobile-brand-title">DISSIDIA</span>
              <span class="mobile-brand-sub"
                ><span class="brand-num">012</span> DUODECIM</span
              >
            </div>
          </a>
        </header>

        <main class="content-wrapper">
          <slot />
        </main>
      </div>
    </div>

    <script is:inline>
      // Defensive client-side drawer & progress counter with SSR guards
      if (typeof document !== "undefined") {
        const toggleBtn = document.getElementById("sidebarToggle");
        const closeBtn = document.getElementById("sidebarClose");
        const sidebar = document.getElementById("appSidebar");
        const overlay = document.getElementById("sidebarOverlay");

        function openMenu() {
          sidebar?.classList.add("open");
          overlay?.classList.add("open");
          toggleBtn?.setAttribute("aria-expanded", "true");
          document.body.classList.add("drawer-open");
        }

        function closeMenu() {
          sidebar?.classList.remove("open");
          overlay?.classList.remove("open");
          toggleBtn?.setAttribute("aria-expanded", "false");
          document.body.classList.remove("drawer-open");
        }

        function toggleMenu() {
          if (sidebar?.classList.contains("open")) {
            closeMenu();
          } else {
            openMenu();
          }
        }

        toggleBtn?.addEventListener("click", toggleMenu);
        closeBtn?.addEventListener("click", closeMenu);
        overlay?.addEventListener("click", closeMenu);

        // Escape key to close drawer
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && sidebar?.classList.contains("open")) {
            closeMenu();
          }
        });

        // Close sidebar on navigation clicks
        document.querySelectorAll(".nav-link").forEach((link) => {
          link.addEventListener("click", () => {
            closeMenu();
          });
        });

        // Safe global progress badge synchronization
        function updateGlobalProgress() {
          try {
            const raw = localStorage.getItem("dissidia-012-guide-progress");
            if (raw) {
              const list = JSON.parse(raw);
              const countEl = document.getElementById("globalProgressCount");
              if (countEl && Array.isArray(list)) {
                const drakeDone = list.filter((id) =>
                  id.startsWith("drake-ch-"),
                ).length;
                countEl.textContent = `${drakeDone} / 27`;
              }
            }
          } catch (e) {
            console.warn("Storage sync notice:", e);
          }
        }
        updateGlobalProgress();
        window.addEventListener("storage", updateGlobalProgress);
      }
    </script>
  </body>
</html>

<style>
  /* Layout Core Structure */
  .app-container {
    display: flex;
    min-height: 100vh;
  }

  /* PSP Command Terminal Sidebar */
  .app-sidebar {
    width: var(--sidebar-width);
    background: var(--surface-hud);
    border-right: 1px solid var(--border-panel);
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    transition: transform var(--transition-normal);
    box-shadow: 4px 0 24px rgba(0, 0, 0, 0.6);
  }

  .sidebar-header {
    position: sticky;
    top: 0;
    z-index: 10;
    padding: 1.15rem 1.25rem;
    border-bottom: 2px solid rgba(56, 189, 248, 0.25);
    background: linear-gradient(
        180deg,
        rgba(56, 189, 248, 0.12) 0%,
        rgba(10, 14, 26, 0) 100%
      ),
      var(--surface-hud);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .sidebar-close-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    min-width: 36px;
    min-height: 36px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-panel);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    cursor: pointer;
    transition: all var(--transition-fast);
    flex-shrink: 0;
    margin-left: auto;
  }

  .sidebar-close-btn:hover {
    background: rgba(239, 68, 68, 0.15);
    border-color: rgba(239, 68, 68, 0.5);
    color: #f87171;
    transform: scale(1.05);
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    color: var(--text-main);
    transition: opacity var(--transition-fast);
  }

  .brand-link:hover {
    text-decoration: none;
    opacity: 0.95;
  }

  .sidebar-brand-img {
    height: 40px;
    width: auto;
    max-width: 58px;
    object-fit: contain;
    filter: drop-shadow(0 2px 12px rgba(56, 189, 248, 0.4));
    transition: transform var(--transition-fast);
  }

  .brand-link:hover .sidebar-brand-img {
    transform: scale(1.05);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .brand-text h1 {
    font-family: var(--font-wallpoet);
    font-size: 1.43rem;
    font-weight: 700;
    line-height: 1;
    margin: 0;
    letter-spacing: 0.12em;
    color: #ffffff;
    text-shadow: 0 0 12px rgba(56, 189, 248, 0.4);
  }

  .brand-text span {
    font-size: 0.7rem;
    font-family: var(--font-subheading);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #7dd3fc;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .brand-text .brand-num {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.05rem 0.3rem;
    background: rgba(56, 189, 248, 0.15);
    border: 1px solid rgba(56, 189, 248, 0.4);
    border-radius: var(--radius-xs);
    color: #38bdf8;
  }

  .sidebar-nav {
    padding: 1rem 0.75rem;
    flex: 1;
  }

  .nav-group {
    margin-bottom: 1.5rem;
  }

  .nav-group-title {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-dim);
    padding: 0.35rem 0.75rem;
    font-family: var(--font-subheading);
    font-weight: 700;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.75rem;
    min-height: 44px;
    color: var(--text-muted);
    border-radius: var(--radius-sm);
    font-family: var(--font-subheading);
    font-size: 0.98rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition: all var(--transition-fast);
    border: 1px solid transparent;
  }

  .nav-link .nav-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-dim);
    transition:
      color var(--transition-fast),
      transform var(--transition-fast);
    flex-shrink: 0;
  }

  .nav-link .nav-icon :global(svg),
  .nav-link .nav-icon svg {
    display: block;
  }

  .nav-link .nav-label {
    flex: 1;
  }

  .nav-link:hover {
    color: var(--text-main);
    background: var(--surface-panel-alt);
    border-color: rgba(56, 189, 248, 0.2);
    text-decoration: none;
  }

  .nav-link:hover .nav-icon {
    color: var(--color-brv);
    transform: scale(1.1);
  }

  .nav-link.active {
    color: #ffffff;
    background: linear-gradient(
      90deg,
      rgba(56, 189, 248, 0.22) 0%,
      rgba(56, 189, 248, 0.05) 100%
    );
    border: 1px solid rgba(56, 189, 248, 0.4);
    border-left: 3px solid var(--color-brv);
    font-weight: 700;
    box-shadow: inset 0 0 12px rgba(56, 189, 248, 0.12);
  }

  .nav-link.active .nav-icon {
    color: var(--color-brv);
    filter: drop-shadow(0 0 6px rgba(56, 189, 248, 0.6));
  }

  .nav-link .badge {
    font-size: 0.72rem;
    font-family: var(--font-mono);
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-muted);
  }

  /* Collapsible Submenu Navigation */
  .nav-collapsible {
    margin-top: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .nav-collapsible-summary {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.75rem;
    min-height: 44px;
    color: var(--text-muted);
    border-radius: var(--radius-sm);
    font-family: var(--font-subheading);
    font-size: 0.98rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition: all var(--transition-fast);
    border: 1px solid transparent;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .nav-collapsible-summary::-webkit-details-marker,
  .nav-collapsible-summary::marker {
    display: none;
  }

  .nav-collapsible-summary .nav-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-dim);
    transition:
      color var(--transition-fast),
      transform var(--transition-fast);
    flex-shrink: 0;
  }

  .nav-collapsible-summary .nav-icon :global(svg),
  .nav-collapsible-summary .nav-icon svg {
    display: block;
  }

  .nav-collapsible-summary .nav-label {
    flex: 1;
  }

  .nav-collapsible-summary:hover {
    color: var(--text-main);
    background: var(--surface-panel-alt);
    border-color: rgba(56, 189, 248, 0.2);
  }

  .nav-collapsible-summary:hover .nav-icon {
    color: var(--color-brv);
    transform: scale(1.1);
  }

  .nav-collapsible.has-active-child > .nav-collapsible-summary {
    color: #ffffff;
    background: rgba(56, 189, 248, 0.08);
    border-color: rgba(56, 189, 248, 0.25);
    font-weight: 700;
  }

  .nav-collapsible.has-active-child > .nav-collapsible-summary .nav-icon {
    color: var(--color-brv);
  }

  .nav-chevron {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-dim);
    transition:
      transform 0.2s ease,
      color var(--transition-fast);
    flex-shrink: 0;
  }

  .nav-collapsible[open] > .nav-collapsible-summary .nav-chevron {
    transform: rotate(180deg);
    color: var(--color-brv);
  }

  .nav-collapsible-content {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.25rem 0 0.25rem 0.6rem;
    margin-left: 0.85rem;
    border-left: 1px solid rgba(56, 189, 248, 0.2);
    margin-top: 0.2rem;
    margin-bottom: 0.35rem;
  }

  .nav-sub-link {
    font-size: 0.9rem;
    min-height: 38px;
    padding: 0.4rem 0.65rem;
    border-radius: var(--radius-sm);
  }

  .nav-sub-link .nav-icon :global(svg),
  .nav-sub-link .nav-icon svg {
    width: 16px;
    height: 16px;
  }

  /* Main Content Area */
  .app-main {
    flex: 1;
    margin-left: var(--sidebar-width);
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* Header */
  .app-header {
    position: sticky;
    top: 0;
    height: var(--header-height);
    background: var(--surface-hud);
    border-bottom: 2px solid var(--border-panel);
    z-index: 90;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.5rem;
    gap: 1rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
    flex: 1;
  }

  .header-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--text-muted);
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
  }

  .header-breadcrumbs a,
  .breadcrumb-home {
    color: var(--text-muted);
    flex-shrink: 0;
    white-space: nowrap;
  }

  .header-breadcrumbs a:hover,
  .breadcrumb-home:hover {
    color: var(--color-brv);
  }

  .breadcrumb-sep {
    color: var(--text-dim);
    flex-shrink: 0;
  }

  .breadcrumb-current {
    color: var(--text-main);
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
    display: inline-block;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  /* Mobile Header Brand */
  .mobile-header-brand {
    display: none;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .mobile-brand-img {
    height: 34px;
    width: auto;
    max-width: 50px;
    object-fit: contain;
    filter: drop-shadow(0 2px 8px rgba(56, 189, 248, 0.4));
    transition:
      transform var(--transition-fast),
      filter var(--transition-fast);
  }

  .mobile-brand-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .mobile-brand-title {
    font-family: var(--font-wallpoet);
    font-size: 0.89rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.1em;
    color: #ffffff;
    text-shadow: 0 0 10px rgba(56, 189, 248, 0.4);
  }

  .mobile-brand-sub {
    font-size: 0.62rem;
    font-family: var(--font-subheading);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #7dd3fc;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    line-height: 1;
  }

  .mobile-brand-sub .brand-num {
    display: inline-block;
