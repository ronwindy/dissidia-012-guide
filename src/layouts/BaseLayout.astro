---
import "../styles/global.css";
import "../styles/header-icons.css";
import project from "../../project.config.json";
import Sidebar from "../components/layout/Sidebar.astro";
import Header from "../components/layout/Header.astro";
import Main from "../components/layout/Main.astro";
import { ArrowUp } from "@lucide/astro";

interface Props {
  title?: string;
  description?: string;
  currentId?: string;
}

const {
  title = project.defaultTitle,
  description = project.defaultDescription,
  currentId = "",
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <meta name="theme-color" content="#070a13" />
  </head>
  <body style={`--site-bg: url('${baseUrl}background.jpg');`}>
    <div class="app-container">
      <!-- Left Sidebar -->
      <Sidebar currentId={currentId} baseUrl={baseUrl} />

      <!-- Main Content Shell -->
      <div class="app-main">
        <Header title={currentId ? title : ""} baseUrl={baseUrl} />

        <div class="content-col">
          <Main>
            <slot />
          </Main>
          <slot name="aside" />
        </div>
      </div>
    </div>

    <button type="button" id="back-to-top" class="back-to-top" aria-label="Back to top" hidden><ArrowUp size={20} aria-hidden="true" /></button>

    <script is:inline>
      (function () {
        var topBtn = document.getElementById('back-to-top');
        if (!topBtn) return;
        var syncTop = function () { topBtn.hidden = window.scrollY < window.innerHeight; };
        window.addEventListener('scroll', syncTop, { passive: true });
        topBtn.addEventListener('click', function () { window.scrollTo({ top: 0 }); });
        syncTop();
      })();
    </script>

    <script is:inline>
      // Reading progress: per-page "read" marks and the last page opened, kept in this browser only.
      (function () {
        var KEY = 'd012-progress-v1';
        var state = { done: {}, last: '' };
        try { var raw = JSON.parse(localStorage.getItem(KEY) || '{}'); if (raw && raw.done) state = { done: raw.done, last: raw.last || '' }; } catch (e) {}
        function save() { try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) {} }
        var current = document.querySelector('.app-sidebar a[aria-current="page"]');
        if (current) { state.last = current.getAttribute('data-page-id'); save(); }

        function paint() {
          var links = document.querySelectorAll('a[data-page-id]');
          links.forEach(function (a) { a.toggleAttribute('data-done', !!state.done[a.getAttribute('data-page-id')]); });
          var n = Object.keys(state.done).length;
          document.querySelectorAll('.progress').forEach(function (box) {
            var total = Number(box.getAttribute('data-progress-total')) || 1;
            box.querySelector('[data-progress-count]').textContent = String(n);
            box.querySelector('[data-progress-fill]').style.width = Math.min(100, Math.round((n / total) * 100)) + '%';
          });
          document.querySelectorAll('[data-progress-resume]').forEach(function (a) {
            var target = document.querySelector('a[data-page-id="' + state.last + '"]');
            if (state.last && target) { a.href = target.href; a.hidden = false; a.textContent = 'Continue reading: ' + target.textContent.trim(); } else { a.hidden = true; }
          });
          document.querySelectorAll('[data-mark-read]').forEach(function (b) {
            var on = !!state.done[b.getAttribute('data-mark-read')];
            b.setAttribute('aria-pressed', String(on));
            b.textContent = on ? 'Read ✓ (click to undo)' : 'Mark as read';
          });
        }
        document.querySelectorAll('[data-mark-read]').forEach(function (b) {
          b.addEventListener('click', function () {
            var id = b.getAttribute('data-mark-read');
            if (state.done[id]) delete state.done[id]; else state.done[id] = 1;
            save(); paint();
          });
        });
        paint();
      })();
    </script>
  </body>
</html>

<style>
  /* Layout Core Structure */
  .app-container {
    display: flex;
    min-height: 100vh;
  }

  /* Main Content Area */
  .app-main {
    flex: 1;
    margin-left: var(--sidebar-width);
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* Content column: page body plus optional on-page ToC */
  .content-col {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 2rem;
    padding: 0 1.5rem;
  }

  .back-to-top {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 80;
    display: inline-flex;
    padding: 0.6rem;
    border: 1px solid var(--border-panel-hover);
    border-radius: var(--radius-sm);
    background: var(--surface-hud);
    color: var(--color-brv);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .back-to-top[hidden] {
    display: none;
  }

  .back-to-top:hover {
    background: var(--color-brv);
    color: var(--text-inverse);
  }

  /* Responsive Media Queries */
  @media (max-width: 1024px) {
    .app-main {
      margin-left: 0;
      width: 100%;
    }

    .content-col {
      padding: 0;
    }
  }

  @media (max-width: 1279px) {
    .content-col:has(.page-toc) {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .content-col:has(.page-toc) :global(.page-toc) {
      order: -1;
      width: auto;
      max-width: var(--max-content-width);
      margin: 1rem 1.5rem 0;
    }
  }

  @media (max-width: 768px) {
    .content-col:has(.page-toc) :global(.page-toc) {
      margin: 0.85rem 0.85rem 0;
    }
  }
</style>
