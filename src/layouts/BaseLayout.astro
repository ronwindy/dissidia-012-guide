---
import "../styles/global.css";
import "../styles/header-icons.css";
import project from "../../project.config.json";
import Sidebar from "../components/layout/Sidebar.astro";
import Header from "../components/layout/Header.astro";
import Main from "../components/layout/Main.astro";
import BackToTop from "../components/layout/BackToTop.astro";
import ReadingProgress from "../components/layout/ReadingProgress.astro";

interface Props {
  title?: string;
  description?: string;
  currentId?: string;
}

const {
  title = project.defaultTitle,
  description = project.defaultDescription,
  currentId = "",
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <meta name="theme-color" content="#070a13" />
  </head>
  <body style={`--site-bg: url('${baseUrl}background.jpg');`}>
    <div class="app-container">
      <!-- Left Sidebar -->
      <Sidebar currentId={currentId} baseUrl={baseUrl} />

      <!-- Main Content Shell -->
      <div class="app-main">
        <Header baseUrl={baseUrl} />

        <div class="content-col">
          <Main>
            <slot />
          </Main>
          <slot name="aside" />
        </div>
      </div>
    </div>

    <BackToTop />
    <ReadingProgress />
  </body>
</html>

<style>
  /* Layout Core Structure */
  .app-container {
    display: flex;
    min-height: 100vh;
  }

  /* Main Content Area */
  .app-main {
    flex: 1;
    margin-left: var(--sidebar-width);
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* Content column: page body plus optional on-page ToC */
  .content-col {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 2rem;
    padding: 0 1.5rem;
  }

  /* Responsive Media Queries */
  @media (max-width: 1024px) {
    .app-main {
      margin-left: 0;
      width: 100%;
    }

    .content-col {
      padding: 0;
    }
  }

  @media (max-width: 1279px) {
    .content-col:has(.page-toc) {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .content-col:has(.page-toc) :global(.page-toc) {
      order: -1;
      width: auto;
      max-width: var(--max-content-width);
      margin: 1rem 1.5rem 0;
    }
  }

  @media (max-width: 768px) {
    .content-col:has(.page-toc) :global(.page-toc) {
      margin: 0.85rem 0.85rem 0;
    }
  }
</style>
