---
import "../styles/global.css";
import Icon from "../components/common/Icon.astro";
import type { IconName } from "../components/common/icons";

interface NavLinkChild {
  label: string;
  href: string;
  id: string;
  icon: IconName;
}

interface NavLinkItem {
  label: string;
  href?: string;
  id: string;
  icon: IconName;
  children?: NavLinkChild[];
}

interface NavGroup {
  title: string;
  links: NavLinkItem[];
}

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const {
  title,
  description = "Complete move lists, story gateways, reports, crafting recipes, and combat strategies for Dissidia 012 [duodecim] Final Fantasy (PSP).",
  currentPath = "",
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const navGroups: NavGroup[] = [
  {
    title: "General",
    links: [
      {
        label: "Home",
        href: `${baseUrl}`,
        id: "home",
        icon: "home",
      },
      {
        label: "FAQ & Credits",
        href: `${baseUrl}faq/`,
        id: "faq",
        icon: "help-circle",
      },
    ],
  },
  {
    title: "Gameplay",
    links: [
      {
        label: "Characters",
        href: `${baseUrl}characters/`,
        id: "roster",
        icon: "swords",
      },
      {
        label: "Combat Guide",
        href: `${baseUrl}mechanics/`,
        id: "mechanics",
        icon: "zap",
      },

      {
        label: "Arenas",
        href: `${baseUrl}arenas/`,
        id: "arenas",
        icon: "globe",
      },
    ],
  },
  {
    title: "Walkthroughs",
    links: [
      {
        label: "Drake's Walkthrough",
        href: `${baseUrl}story/drake/`,
        id: "story-drake",
        icon: "book-open",
      },
      {
        label: "Legacy Walkthrough",
        id: "legacy-walkthroughs",
        icon: "layers",
        children: [
          {
            label: "Scenario Overview",
            href: `${baseUrl}story/`,
            id: "story-hub",
            icon: "map",
          },
          {
            label: "012: Treachery of Gods",
            href: `${baseUrl}story/012-treachery/`,
            id: "story-012",
            icon: "flame",
          },
          {
            label: "013: Light to All",
            href: `${baseUrl}story/013-light/`,
            id: "story-013",
            icon: "sparkles",
          },
          {
            label: "000: Creator's Gateways",
            href: `${baseUrl}story/000-creator/`,
            id: "story-000",
            icon: "compass",
          },
        ],
      },
    ],
  },
  {
    title: "Lore & Unlocks",
    links: [
      {
        label: "20 Reports & Unlocks",
        href: `${baseUrl}reports/`,
        id: "reports",
        icon: "file-text",
      },
    ],
  },
  {
    title: "Equipment & Economy",
    links: [
      {
        label: "Sets, KP & AP Grinding",
        href: `${baseUrl}crafting/`,
        id: "crafting",
        icon: "gem",
      },
    ],
  },
  {
    title: "Extra",
    links: [
      {
        label: "Quests & Friend Cards",
        href: `${baseUrl}quests/`,
        id: "quests",
        icon: "layout",
      },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Dissidia 012 [duodecim] Guide</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <meta name="theme-color" content="#070a13" />
  </head>
  <body style={`--site-bg: url('${baseUrl}background.jpg');`}>
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="app-container">
      <!-- Left Sidebar -->
      <aside class="app-sidebar" id="appSidebar" aria-label="Sidebar">
        <div class="sidebar-header">
          <a
            href={baseUrl}
            class="brand-link"
            title="Dissidia 012 [duodecim] Strategy Guide"
          >
            <img
              src={`${baseUrl}logo.png`}
              alt="Dissidia 012 Logo"
              class="sidebar-brand-img"
            />
            <div class="brand-text">
              <h1>DISSIDIA</h1>
              <span><span class="brand-num">012</span> DUODECIM GUIDE</span>
            </div>
          </a>
          <button
            class="sidebar-close-btn"
            id="sidebarClose"
            aria-label="Close Command Menu"
          >
            <Icon name="x" size={20} />
          </button>
        </div>

        <nav class="sidebar-nav" aria-label="Main Navigation">
          {
            navGroups.map((group) => (
              <div class="nav-group">
                <div class="nav-group-title">{group.title}</div>
                {group.links.map((link) => {
                  const isDrakeRoute =
                    Astro.url.pathname.includes("/story/drake") ||
                    currentPath === "story-drake";
                  const isCharacterRoute =
                    Astro.url.pathname.includes("/characters/") ||
                    currentPath === "roster";
                  const isArenaRoute =
                    Astro.url.pathname.includes("/arenas/") ||
                    currentPath === "arenas";

                  const checkActive = (id: string) => {
                    if (id === "story-drake") return isDrakeRoute;
                    if (id === "roster") return isCharacterRoute;
                    if (id === "arenas") return isArenaRoute;
                    if (id === "home")
                      return currentPath === "" || currentPath === "home";
                    return currentPath === id;
                  };

                  if (link.children && link.children.length > 0) {
                    const hasActiveChild = link.children.some((child) =>
                      checkActive(child.id),
                    );
                    return (
                      <details
                        class={`nav-collapsible ${hasActiveChild ? "has-active-child" : ""}`}
                        open={hasActiveChild}
                      >
                        <summary class="nav-collapsible-summary">
                          <span class="nav-icon">
                            <Icon name={link.icon} size={18} />
                          </span>
                          <span class="nav-label">{link.label}</span>
                          <span class="nav-chevron" aria-hidden="true">
                            <Icon name="chevron-down" size={14} />
                          </span>
                        </summary>
                        <div class="nav-collapsible-content">
                          {link.children.map((child) => {
                            const isChildActive = checkActive(child.id);
                            return (
                              <a
                                href={child.href}
                                class={`nav-link nav-sub-link ${isChildActive ? "active" : ""}`}
                              >
                                <span class="nav-icon">
                                  <Icon name={child.icon} size={18} />
                                </span>
                                <span class="nav-label">{child.label}</span>
                              </a>
                            );
                          })}
                        </div>
                      </details>
                    );
                  }

                  const isActive = checkActive(link.id);
                  return (
                    <a
                      href={link.href}
                      class={`nav-link ${isActive ? "active" : ""}`}
                    >
                      <span class="nav-icon">
                        <Icon name={link.icon} size={18} />
                      </span>
                      <span class="nav-label">{link.label}</span>
                    </a>
                  );
                })}
              </div>
            ))
          }
        </nav>

        <div
          style="padding: 1rem 1.25rem; border-top: 1px solid var(--border-panel); font-size: 0.78rem; color: var(--text-dim); background: var(--surface-panel);"
        >
          <div
            style="display: flex; justify-content: space-between; align-items: center;"
          >
            <span>Drake's Guide Progress:</span>
            <span
              id="globalProgressCount"
              style="color: var(--color-assist); font-weight: 700; font-family: var(--font-mono); font-size: 0.9rem;"
              >0 / 27</span
            >
          </div>
        </div>
      </aside>

      <!-- Main Content Shell -->
      <div class="app-main">
        <header class="app-header">
          <div class="header-left">
            <button
              class="mobile-toggle-btn"
              id="sidebarToggle"
              aria-label="Toggle Command Menu"
              aria-expanded="false"
              aria-controls="appSidebar"
            >
              <Icon name="menu" size={24} />
            </button>
            <nav class="header-breadcrumbs" aria-label="Breadcrumbs">
              <a href={baseUrl} class="breadcrumb-home">Home</a>
              {
                title !== "Dissidia 012 [duodecim] Guide Portal" && (
                  <>
                    <span class="breadcrumb-sep">/</span>
                    <span class="breadcrumb-current" title={title}>
                      {title}
                    </span>
                  </>
                )
              }
            </nav>
          </div>

          <a
            href={baseUrl}
            class="mobile-header-brand"
            aria-label="Dissidia 012 Guide Home"
          >
            <img
              src={`${baseUrl}logo.png`}
              alt="Dissidia 012 Logo"
              class="mobile-brand-img"
            />
            <div class="mobile-brand-text">
              <span class="mobile-brand-title">DISSIDIA</span>
              <span class="mobile-brand-sub"
                ><span class="brand-num">012</span> DUODECIM</span
              >
            </div>
          </a>
        </header>

        <main class="content-wrapper">
          <slot />
        </main>
      </div>
    </div>

    <script is:inline>
      // Defensive client-side drawer & progress counter with SSR guards
      if (typeof document !== "undefined") {
        const toggleBtn = document.getElementById("sidebarToggle");
        const closeBtn = document.getElementById("sidebarClose");
        const sidebar = document.getElementById("appSidebar");
        const overlay = document.getElementById("sidebarOverlay");

        function openMenu() {
          sidebar?.classList.add("open");
          overlay?.classList.add("open");
          toggleBtn?.setAttribute("aria-expanded", "true");
          document.body.classList.add("drawer-open");
        }

        function closeMenu() {
          sidebar?.classList.remove("open");
          overlay?.classList.remove("open");
          toggleBtn?.setAttribute("aria-expanded", "false");
          document.body.classList.remove("drawer-open");
        }

        function toggleMenu() {
          if (sidebar?.classList.contains("open")) {
            closeMenu();
          } else {
            openMenu();
          }
        }

        toggleBtn?.addEventListener("click", toggleMenu);
        closeBtn?.addEventListener("click", closeMenu);
        overlay?.addEventListener("click", closeMenu);

        // Escape key to close drawer
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && sidebar?.classList.contains("open")) {
            closeMenu();
          }
        });

        // Close sidebar on navigation clicks
        document.querySelectorAll(".nav-link").forEach((link) => {
          link.addEventListener("click", () => {
            closeMenu();
          });
        });

        // Safe global progress badge synchronization
        function updateGlobalProgress() {
          try {
            const raw = localStorage.getItem("dissidia-012-guide-progress");
            if (raw) {
              const list = JSON.parse(raw);
              const countEl = document.getElementById("globalProgressCount");
              if (countEl && Array.isArray(list)) {
                const drakeDone = list.filter((id) =>
                  id.startsWith("drake-ch-"),
                ).length;
                countEl.textContent = `${drakeDone} / 27`;
              }
            }
          } catch (e) {
            console.warn("Storage sync notice:", e);
          }
        }
        updateGlobalProgress();
        window.addEventListener("storage", updateGlobalProgress);
      }
    </script>
  </body>
</html>
